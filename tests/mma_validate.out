    // D = A B + C on a warp's fragments as PTX's mma.sync.aligned.m16n8k16.row.col
    // lays them out (f16 A and B, f32 C and D), for a GPU without a matrix unit.
    // ucas mma m16n8k16 f32 under rdna2: output-stationary; A: 12 xor shuffles; B: 16 shuffles; 32 fdot2; k order by lane;
    // cost 121 (each word fetched from its lane: 123).
    // Proved over the 32 lanes: each element of D is its 16 products and C, each once;
    // |D - (A B + C)| <= gamma_16 (sum_k |A_ik B_kj| + |C_ij|), u = 2^-24.
    #extension GL_KHR_shader_subgroup_basic : require
    #extension GL_KHR_shader_subgroup_shuffle : require
    #extension GL_EXT_spirv_intrinsics : require
    #extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
    // OpFDot2MixAcc32VALVE: a.x * b.x + a.y * b.y + c in f32
    spirv_instruction(extensions = ["SPV_VALVE_mixed_float_dot_product"], capabilities = [6912], id = 6916)
    float mma_fdot2(f16vec2 a, f16vec2 b, float c);
    void mma_m16n8k16_f32(uint a[4], uint b[2], float c[4], out float d[4])
    {
    	uint lane = gl_SubgroupInvocationID & 31u;
    	uint base = gl_SubgroupInvocationID & ~31u;
    	float v0 = c[0];
    	float v1 = c[1];
    	float v2 = c[2];
    	float v3 = c[3];
    	uint v4 = a[0];
    	uint v5 = b[0];
    	uint i0 = base | ((lane & 3u) ^ ((lane & 3u) << 3u));
    	uint v6 = subgroupShuffle(v5, i0);
    	float v7 = mma_fdot2(unpackFloat2x16(v4), unpackFloat2x16(v6), v0);
    	uint i1 = i0 ^ 4u;
    	uint v8 = subgroupShuffle(v5, i1);
    	float v9 = mma_fdot2(unpackFloat2x16(v4), unpackFloat2x16(v8), v1);
    	uint v10 = a[1];
    	float v11 = mma_fdot2(unpackFloat2x16(v10), unpackFloat2x16(v6), v2);
    	float v12 = mma_fdot2(unpackFloat2x16(v10), unpackFloat2x16(v8), v3);
    	uint v13 = subgroupShuffleXor(v4, 1u);
    	uint i3 = i0 ^ 1u;
    	uint v14 = subgroupShuffle(v5, i3);
    	float v15 = mma_fdot2(unpackFloat2x16(v13), unpackFloat2x16(v14), v7);
