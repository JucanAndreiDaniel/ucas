    // D = A B + C on a warp's fragments as PTX's mma.sync.aligned.m16n8k8.row.col
    // lays them out (f16 A and B, f16 C and D), for a GPU without a matrix unit.
    // ucas mma m16n8k8 f16 under rdna2: output-stationary; A: 6 xor shuffles; B: 8 shuffles; 16 fdot2; k order by lane;
    // cost 75 (each word fetched from its lane: 75).
    // Proved over the 32 lanes: each element of D is its 8 products and C, each once;
    // |D - (A B + C)| <= gamma_8 (sum_k |A_ik B_kj| + |C_ij|), then D's f16 rounding, u = 2^-24.
    #extension GL_KHR_shader_subgroup_basic : require
    #extension GL_KHR_shader_subgroup_shuffle : require
    #extension GL_EXT_spirv_intrinsics : require
    #extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
    // OpFDot2MixAcc32VALVE: a.x * b.x + a.y * b.y + c in f32
    spirv_instruction(extensions = ["SPV_VALVE_mixed_float_dot_product"], capabilities = [6912], id = 6916)
    float mma_fdot2(f16vec2 a, f16vec2 b, float c);
    void mma_m16n8k8_f16(uint a[2], uint b[1], uint c[2], out uint d[2])
    {
    	uint lane = gl_SubgroupInvocationID & 31u;
    	uint base = gl_SubgroupInvocationID & ~31u;
    	uint v0 = c[0];
    	float v1 = unpackHalf2x16(v0).x;
    	float v2 = unpackHalf2x16(v0).y;
    	uint v3 = c[1];
    	float v4 = unpackHalf2x16(v3).x;
    	float v5 = unpackHalf2x16(v3).y;
    	uint v6 = a[0];
    	uint v7 = b[0];
    	uint i0 = base | ((lane & 3u) ^ ((lane & 3u) << 3u));
    	uint v8 = subgroupShuffle(v7, i0);
    	float v9 = mma_fdot2(unpackFloat2x16(v6), unpackFloat2x16(v8), v1);
    	uint i1 = i0 ^ 4u;
    	uint v10 = subgroupShuffle(v7, i1);
    	float v11 = mma_fdot2(unpackFloat2x16(v6), unpackFloat2x16(v10), v2);
    	uint v12 = a[1];
    	float v13 = mma_fdot2(unpackFloat2x16(v12), unpackFloat2x16(v8), v4);
    	float v14 = mma_fdot2(unpackFloat2x16(v12), unpackFloat2x16(v10), v5);
    	uint v15 = subgroupShuffleXor(v6, 1u);
    	uint i3 = i0 ^ 1u;
    	uint v16 = subgroupShuffle(v7, i3);
    	float v17 = mma_fdot2(unpackFloat2x16(v15), unpackFloat2x16(v16), v9);
    	uint i4 = i0 ^ 5u;
    	uint v18 = subgroupShuffle(v7, i4);
    	float v19 = mma_fdot2(unpackFloat2x16(v15), unpackFloat2x16(v18), v11);
    	uint v20 = subgroupShuffleXor(v12, 1u);
    	float v21 = mma_fdot2(unpackFloat2x16(v20), unpackFloat2x16(v16), v13);
    	float v22 = mma_fdot2(unpackFloat2x16(v20), unpackFloat2x16(v18), v14);
    	uint v23 = subgroupShuffleXor(v6, 2u);
    	uint i6 = i0 ^ 2u;
    	uint v24 = subgroupShuffle(v7, i6);
    	float v25 = mma_fdot2(unpackFloat2x16(v23), unpackFloat2x16(v24), v17);
    	uint i7 = i0 ^ 6u;
    	uint v26 = subgroupShuffle(v7, i7);
    	float v27 = mma_fdot2(unpackFloat2x16(v23), unpackFloat2x16(v26), v19);
    	uint v28 = subgroupShuffleXor(v12, 2u);
    	float v29 = mma_fdot2(unpackFloat2x16(v28), unpackFloat2x16(v24), v21);
    	float v30 = mma_fdot2(unpackFloat2x16(v28), unpackFloat2x16(v26), v22);
    	uint v31 = subgroupShuffleXor(v6, 3u);
    	uint i9 = i0 ^ 3u;
    	uint v32 = subgroupShuffle(v7, i9);
    	float v33 = mma_fdot2(unpackFloat2x16(v31), unpackFloat2x16(v32), v25);
    	uint i10 = i0 ^ 7u;
    	uint v34 = subgroupShuffle(v7, i10);
    	float v35 = mma_fdot2(unpackFloat2x16(v31), unpackFloat2x16(v34), v27);
    	uint v36 = subgroupShuffleXor(v12, 3u);
    	float v37 = mma_fdot2(unpackFloat2x16(v36), unpackFloat2x16(v32), v29);
