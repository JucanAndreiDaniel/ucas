# Measured-only model for gfx90c from tests/gfx90c/results/2026-11-16.md.
# Every priced class has a direct measurement. Unmeasured classes are
# 'none' (unavailable), never inherited from another architecture.

model gfx90c {
  warp: 64,
  atomic_global: 21.19,
  atomic_global_64: 385.11,
  atomic_global_cas: 193.34,
  atomic_global_stream: 193.31,
  atomic_shared: 9.98,
  atomic_shared_f: 172.08,
  atomic_shared_same: 32.96,
  bank_conflict: 56.24,
  barrier: 9.53,
  bitcast: 0.00,
  bitcnt: 0.29,
  cmp: 0.99,
  conv: 1.00,
  diverge: 1.41,
  f64: 8.17,
  fadd: 1.00,
  fdiv: 5.02,
  fmul: 1.00,
  fpow: 4.56,
  fsqrt: 3.99,
  ftrans: 4.00,
  iadd: 0.70,
  idiv: 31.08,
  idivk: 6.21,
  image_load: 34.18,
  imul: 3.99,
  load: 8.37,
  load_shared: 2.66,
  load_stream: 89.18,
  load_ubo: 0.84,
  load_ubo_div: 58.43,
  logic: 0.30,
  minmax: 1.29,
  select: 0.82,
  sg_add: 7.79,
  sg_ballot: 1.67,
  sg_deriv: 1.00,
  sg_scan: 7.75,
  sg_shuffle: 9.14,
  shift: 1.00,
  store: 9.52,
  store_stream: 90.87,
  tex_fetch: 31.70,
  tex_sample: 18.19,
  tex_sample_f32: 31.34,
  dot4x8: none,
  dot4x8sat: none,
  sdot4x8: none,
  sudot4x8: none,
  udot4x8: none,
  udot8x4: none,
  sdot8x4: none,
  sudot8x4: none,
  udot4x8sat: none,
  sdot4x8sat: none,
  sudot4x8sat: none,
  udot8x4sat: none,
  sdot8x4sat: none,
  sudot8x4sat: none,
  fdot2: none,
  subtexel: none,
  fuse ffma(a: float, b: float, c: float) = a*b + c : fmul contract,
  fuse shl_add(a: int, k: const, b: int) = (a << k) + b : shift
  folds none
}
