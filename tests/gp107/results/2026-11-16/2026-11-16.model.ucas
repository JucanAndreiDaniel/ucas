# Measured-only model for gp107 from tests/gp107/results/2026-11-16.md.
# Every priced class has a direct measurement. Unmeasured classes are
# 'none' (unavailable), never inherited from another architecture.

model gp107 {
  warp: 32,
  atomic_global: 60.34,
  atomic_global_64: 271.35,
  atomic_global_cas: 166.52,
  atomic_global_stream: 141.96,
  atomic_shared: 6.79,
  atomic_shared_f: 24.82,
  atomic_shared_same: 65.62,
  bank_conflict: 126.63,
  barrier: 9.24,
  bitcast: 0.00,
  bitcnt: 2.99,
  branch: 6.83,
  cmp: 2.38,
  conv: 2.98,
  diverge: 14.61,
  f64: 32.03,
  fadd: 1.00,
  fdiv: 3.01,
  fmul: 1.00,
  fpow: 7.95,
  fsqrt: 3.97,
  ftrans: 3.99,
  iadd: 1.01,
  idiv: 28.46,
  idivk: 8.92,
  image_load: 36.29,
  imul: 3.01,
  load: 7.27,
  load_shared: 3.14,
  load_stream: 66.90,
  load_ubo: 4.16,
  load_ubo_div: 162.69,
  logic: 1.01,
  minmax: 1.08,
  select: 1.63,
  sg_add: 32.87,
  sg_deriv: 3.23,
  sg_scan: 61.54,
  sg_shuffle: 4.02,
  shift: 2.01,
  store: 17.10,
  store_shared: 3.05,
  store_stream: 87.57,
  tex_fetch: 57.19,
  tex_sample: 21.82,
  tex_sample_f32: 33.46,
  dot4x8: none,
  dot4x8sat: none,
  sdot4x8: none,
  sudot4x8: none,
  udot4x8: none,
  udot8x4: none,
  sdot8x4: none,
  sudot8x4: none,
  udot4x8sat: none,
  sdot4x8sat: none,
  sudot4x8sat: none,
  udot8x4sat: none,
  sdot8x4sat: none,
  sudot8x4sat: none,
  fdot2: none,
  subtexel: none,
  fuse ffma(a: float, b: float, c: float) = a*b + c : fmul contract,
  fuse imad(a: int, b: int, c: int) = a*b + c : imul
  folds none
}
