# a map across blocks of 8 lanes: proposed, not written
simplify nofile nofunctions under rdna2
```glsl
#version 450
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 32) in;
layout(std430, binding = 0) buffer B { uint d[64]; } b;
void main() {
  uint i = gl_GlobalInvocationID.x;
  uint x = b.d[i];
  uint l = gl_SubgroupInvocationID;
  b.d[i] = subgroupShuffle(x, l ^ ((l & 1u) << 2u));
}
```
# under a branch some lanes may be inactive, and an exchange reads its
# partner: left as it is
simplify nofile nofunctions under rdna2
```glsl
#version 450
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 32) in;
layout(std430, binding = 0) buffer B { float d[64]; } b;
void main() {
  uint i = gl_GlobalInvocationID.x;
  float x = b.d[i];
  uint l = gl_SubgroupInvocationID;
  if (x > 0.5)
    b.d[i] = subgroupShuffle(x, l ^ ((l & 1u) << 1u)) + 1.0;
}
```
