# simplify writes a shuffle whose index is an affine map of the lane's
# bits (src/spv_lperm.inc) as lperm.c's stages, each a ShuffleXor and a
# Select on the lane's bits, where the model prices them lower and the
# map stays inside quads; SAT proves the index that map for every lane.
simplify nofile nofunctions under rdna2
```glsl
#version 450
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 32) in;
layout(std430, binding = 0) buffer B { float d[64]; } b;
void main() {
  uint i = gl_GlobalInvocationID.x;
  float x = b.d[i];
  uint l = gl_SubgroupInvocationID;
  b.d[i] = subgroupShuffle(x, l ^ ((l & 1u) << 1u)) + 1.0;
}
```
