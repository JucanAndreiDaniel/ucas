# Measured-only model for gfx902 from tests/gfx902/results/2026-11-16.md.
# Every priced class has a direct measurement. Unmeasured classes are
# 'none' (unavailable), never inherited from another architecture.

model gfx902 {
  warp: 64,
  atomic_global: 20.34,
  atomic_global_64: 259.83,
  atomic_global_cas: 130.29,
  atomic_global_stream: 129.76,
  atomic_shared: 9.95,
  atomic_shared_f: 185.05,
  atomic_shared_same: 32.74,
  bank_conflict: 55.75,
  barrier: 11.02,
  bitcast: 0.00,
  bitcnt: 0.28,
  cmp: 1.03,
  conv: 1.02,
  diverge: 1.15,
  f64: 7.33,
  fadd: 1.00,
  fdiv: 5.16,
  fmul: 1.00,
  fpow: 4.68,
  fsqrt: 4.09,
  ftrans: 4.00,
  iadd: 0.72,
  idiv: 29.63,
  idivk: 6.30,
  image_load: 15.27,
  imul: 4.00,
  load: 8.44,
  load_shared: 2.66,
  load_stream: 60.86,
  load_ubo: 0.80,
  load_ubo_div: 59.37,
  logic: 0.28,
  minmax: 1.28,
  select: 0.80,
  sg_add: 7.76,
  sg_ballot: 1.60,
  sg_scan: 7.82,
  sg_shuffle: 9.24,
  shift: 1.00,
  store: 9.44,
  store_stream: 58.72,
  tex_fetch: 15.03,
  tex_sample: 17.38,
  tex_sample_f32: 31.89,
  dot4x8: none,
  dot4x8sat: none,
  sdot4x8: none,
  sudot4x8: none,
  udot4x8: none,
  udot8x4: none,
  sdot8x4: none,
  sudot8x4: none,
  udot4x8sat: none,
  sdot4x8sat: none,
  sudot4x8sat: none,
  udot8x4sat: none,
  sdot8x4sat: none,
  sudot8x4sat: none,
  fdot2: none,
  subtexel: none,
  fuse ffma(a: float, b: float, c: float) = a*b + c : fmul contract,
  fuse shl_add(a: int, k: const, b: int) = (a << k) + b : shift
  folds none
}
