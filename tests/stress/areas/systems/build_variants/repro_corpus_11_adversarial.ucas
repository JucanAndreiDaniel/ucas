# Batch 11: extra adversarial (NaN/inf bitcasts, huge constants, subnormals).
n1(x: f32 in -1..1) = asfloat(0x7fc00000) + x
range n1
wrap n1
n2() = asuint(1/0)
show n2
n3(x: f32 in 1..2) = asfloat(asuint(x) ^ 0x80000000)
wrap n3
n4(x: f64 in -1e-300..1e-300) = x*x
range n4
n5(x: f32 in 1e-40..1e-38) = x / 1e-40
wrap n5
bigint 2^1000
bigint (2^500 + 1)*(2^500 - 1)
bigint 2^1000 div 7
bigint 2^1000 % (2^61 - 1)
simplify 2^64*x + 2^64*y
expand (x + 10^20)^3
integrate 1/x from 1 to 2
integrate exp(x) from -10..10
crit abs(x)
crit floor(x) + x
domain log(x^2 - 1)
domain sqrt(1 - x^2)
e3(x: f32 in 1..2) = (x*3)*(1/3)
error e3 ~ x
e4(x: f64 in 1..2) = (x/7)*7
error e4 ~ x
table e3 max 4
table e4 max 4
s7(x: u8) = (x << 7) >> 7
wrap s7
s8(x: i32 in -1000..1000) = (x * 1000003) / 7
wrap s8
equiv_e(x: f32 in 1..2) = x*2
equiv_f(x: f32 in 1..2) = x+x
equiv equiv_e equiv_f
