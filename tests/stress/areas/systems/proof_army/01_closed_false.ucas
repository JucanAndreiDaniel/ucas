# Closed false statements have no leading forall, hence no variable
# assignment to print.  The model refutes them; the counterexample line
# must still say why rather than print an empty string.
theorem c01: 1 = 2
prove c01
theorem c02: false
prove c02
theorem c03: prime(4)
prove c03
theorem c04: 2 + 2 = 5
prove c04
