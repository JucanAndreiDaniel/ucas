c lower nofile
```c
int seq1(int x){int i=0;i=i++;return i+x;}
int seq2(int x){int i=0;i=++i;return i+x;}
int seq3(int x){int i=0;int j=i+++i;return j+x;}
int seq4(int x){int i=0;i=++i+i++;return i+x;}
int seq5(int x){int i=0;i=(i++,i++);return i+x;}
int seq6(int x){int i=0;return i++ + i++ + x;}
int seq7(int x){int i=0;return (i++,i)+x;}
int uninit1(){int x;return x;}
int uninit2(int y){int x;return x+y;}
```
