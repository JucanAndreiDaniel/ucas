> c lower nofile
  add(x: u32, y: u32) = x + y
  sub(x: u32, y: u32) = x - y
  mul(x: u32, y: u32) = x*y
  neg(x: u32) = -x
  add8(x: u8, y: u8) = u8(i32(x) + i32(y))
    defined where (no C UB): t1 >= -2147483648 && t1 <= 2147483647 where t1 = i64(i32(x)) + i64(i32(y))
  mul64(x: u64) = 18446744073709551615x
  mix(x: u32, y: i32) = x + u32(y)
  shr(x: u32, y: u32) = x >> y
    defined where (no C UB): y >= 0 && y < 32
