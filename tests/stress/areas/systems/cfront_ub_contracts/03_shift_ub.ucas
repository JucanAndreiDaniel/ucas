c lower nofile
```c
int shl32(int x){return x<<32;}
int shl40(int x){return x<<40;}
int shlneg(int x){return x<<-1;}
int shr32(int x){return x>>32;}
int shr33(int x){return x>>33;}
int shrneg(int x){return x>>-1;}
int shlvar(int x,int n){return x<<n;}
int shrvar(int x,int n){return x>>n;}
unsigned shluvar(unsigned x,unsigned n){return x<<n;}
unsigned shruvar(unsigned x,unsigned n){return x>>n;}
int shl31(int x){return x<<31;}
int shr31(int x){return x>>31;}
int shl0(int x){return x<<0;}
int shlassign(int x){x<<=32;return x;}
int shlcast(unsigned x){return x<<32u;}
long shl64(long x){return x<<64;}
```
