> c lower nofile
  shl32(x: i32) = x << 32
  shl40(x: i32) = x << 40
  shlneg(x: i32) = x << -1
  shr32(x: i32) = x >> 0x20
  shr33(x: i32) = x >> 0x21
  shrneg(x: i32) = x >> -1
  shlvar(x: i32, n: i32) = x << n
  shrvar(x: i32, n: i32) = x >> n
  shluvar(x: u32, n: u32) = x << n
  shruvar(x: u32, n: u32) = x >> n
  shl31(x: i32) = x << 31
  shr31(x: i32) = x >> 0x1f
  shl0(x: i32) = x
  shlassign(x: i32) = x << 32
  shlcast(x: u32) = i32(x << 32)
  shl64(x: i64) = x << 64
