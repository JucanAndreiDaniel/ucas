# Certificate honesty: a corrupted cofactor is reported at its own step,
# not as a bare "FAILED".
theorem br1: forall x y:int: 0 <= x and 0 <= y -> 0 <= x + y
prove br1
check br1 cert broken 1

# The same localization for a corrupted ring-normalization step.
theorem br2: forall a b:int: (a+b)^2 = a^2 + 2*a*b + b^2
prove br2
check br2 cert broken 1
