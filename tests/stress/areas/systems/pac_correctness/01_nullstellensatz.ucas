# Nullstellensatz-style certificate: cofactors a_i with f = sum a_i*g_i.
# The certificate is concise (only algebraic steps) and independently checked.
theorem ns1: forall x y:int: 0 <= x and 0 <= y -> 0 <= x + y
prove ns1
proof ns1 ns
check ns1 cert

# A pure polynomial identity needs no premises: f reduces to zero in Z[x].
theorem ns2: forall a b:int: (a+b)^2 = a^2 + 2*a*b + b^2
prove ns2
proof ns2 ns
check ns2 cert
