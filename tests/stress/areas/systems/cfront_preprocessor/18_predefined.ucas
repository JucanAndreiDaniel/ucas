#ifdef __x86_64__
 return x+3;
#else
 return x+4;
#endif
}
int q3(int x){
#if __SIZEOF_INT__ == 4 && __CHAR_BIT__ == 8
 return x+5;
#else
 return x+6;
#endif
}
