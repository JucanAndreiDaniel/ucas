c lower nofile
```c

#define ADD(a,b) ((a)+(b))
#define MUL(a,b) ((a)*(b))
#define SUB(a,b) ((a)-(b))
#define SQ(x) ADD(x,x)
#define ID(x) (x)
#define ZERO 0
int c1(int x,int y){ return ADD(x,y); }
int c2(int x){ return SQ(x); }
int c3(int x,int y){ return MUL(ADD(x,y), ID(x)); }
int c4(int x,int y){ return ADD(MUL(x,y), SUB(x,y)); }
int c5(int x,int y,int z){ return ADD(ADD(x,y), MUL(y,z)); }
int c6(int x){ return ADD(ID(x), ZERO); }
```
