c lower nofile
```c

#define C1 (2 /* two */ + 3)
#define C2 /* leading block */ 4
#define C3 5 // trailing comment
int l1(int x){ return x + C1; }
int l2(int x){ return x + C2; }
int l3(int x){ return x + C3; }
int l4(int x){ return /* inline */ x + 1; }
int l5(int x){ return x + 2; } // after function
```
