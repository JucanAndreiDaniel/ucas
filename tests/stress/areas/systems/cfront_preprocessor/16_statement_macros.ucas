```c

#define SWAP(a,b) do { int t=a; a=b; b=t; } while(0)
#define INC(x) (++(x))
#define MAX(a,b) ((a)>(b)?(a):(b))
#define RET1 if (1) return 1;
int o1(int a,int b){ SWAP(a,b); return a; }
int o2(int x){ INC(x); return x; }
int o3(int x,int y){ return MAX(x,y); }
int o4(int x){ RET1 return x; }
