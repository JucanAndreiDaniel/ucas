c lower nofile
```c

#define A1 1
#define A2 (A1 + 1)
#define A3 (A2 + 1)
#define A4 (A3 + 1)
#define A5 (A4 * 2)
int b1(int x){ return x + A1; }
int b2(int x){ return x + A2; }
int b3(int x){ return x + A3; }
int b4(int x){ return x + A4; }
int b5(int x){ return x + A5; }
int b6(int x){ return A1 + A2 + A3 + A4 + A5; }
```
