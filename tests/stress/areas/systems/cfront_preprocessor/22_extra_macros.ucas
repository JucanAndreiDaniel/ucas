c lower nofile
```c
#define DUP(x) ((x)+(x))
#define TRI(x) DUP(x) + (x)
#define NEGATE(x) (-(x))
#define BITS 8
#define SHIFT 2
#define MASK ((1 << BITS) - 1)
int v1(int x){ return DUP(x); }
int v2(int x){ return TRI(x); }
int v3(int x){ return NEGATE(x); }
int v4(int x){ return x & MASK; }
int v5(int x){ return x << SHIFT; }
int v6(int x,int y){ return DUP(x) + DUP(y); }
int v7(int x){ return TRI(DUP(x)); }
int v8(int x){ return NEGATE(NEGATE(x)); }
```
