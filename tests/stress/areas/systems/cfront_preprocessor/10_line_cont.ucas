```c

#define SUM(a,b) \
  ((a) + \
   (b))
#define LONG 1 + \
             2 + \
             3
#define TWICE(x) ((x) + \
                  (x))
int k1(int x,int y){ return SUM(x,y); }
int k2(int x){ return x + LONG; }
int k3(int x){ return TWICE(x); }
int k4(int x,int y){ return SUM(TWICE(x), y); }
```
