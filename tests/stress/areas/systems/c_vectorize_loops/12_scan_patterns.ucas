c optimize nofile vectorize
```c
int count(const char*s,char c){int n=0;while(s[n]==c)n++;return n;}
const char* memchr_(const char*s,int c,int n){for(int i=0;i<n;i++)if(s[i]==c)return s+i;return 0;}
int memcmp_(const char*a,const char*b,int n){for(int i=0;i<n;i++)if(a[i]!=b[i])return a[i]-b[i];return 0;}
```
