c optimize nofile vectorize target x86-64-v3
```c
void stride(int*d,const int*s,int n){for(int i=0;i<n;i++)d[2*i]=s[2*i];}
void rev(int*d,const int*s,int n){for(int i=0;i<n;i++)d[i]=s[n-1-i];}
void dep(int*d,int n){for(int i=1;i<n;i++)d[i]=d[i-1]+1;}
void twod(int*d,int n){for(int i=0;i<n;i++)for(int j=0;j<n;j++)d[i*n+j]=i+j;}
void vola(volatile int*d,const int*s,int n){for(int i=0;i<n;i++)d[i]=s[i];}
```
