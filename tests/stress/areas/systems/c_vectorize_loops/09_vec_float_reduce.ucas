float fsum(const float*s,int n){float r=0;for(int i=0;i<n;i++)r+=s[i];return r;}
double dsum(const double*s,int n){double r=0;for(int i=0;i<n;i++)r+=s[i];return r;}
float fdot(const float*a,const float*b,int n){float r=0;for(int i=0;i<n;i++)r+=a[i]*b[i];return r;}
