c optimize nofile vectorize target x86-64-v3
```c
void vadd(int*d,const int*s,int n){for(int i=0;i<n;i++)d[i]=s[i]+1;}
void vcopy(int*d,const int*s,int n){for(int i=0;i<n;i++)d[i]=s[i];}
void vset(int*d,int n,int v){for(int i=0;i<n;i++)d[i]=v;}
void vsub(int*d,const int*s,int n){for(int i=0;i<n;i++)d[i]=s[i]-3;}
```
