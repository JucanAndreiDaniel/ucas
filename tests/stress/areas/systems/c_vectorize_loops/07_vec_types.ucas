c optimize nofile vectorize target x86-64-v3
```c
void vchar(unsigned char*d,const unsigned char*s,int n){for(int i=0;i<n;i++)d[i]=s[i]+1;}
void vshort(short*d,const short*s,int n){for(int i=0;i<n;i++)d[i]=s[i]+1;}
void vfloat(float*d,const float*s,int n){for(int i=0;i<n;i++)d[i]=s[i]+1.0f;}
void vdouble(double*d,const double*s,int n){for(int i=0;i<n;i++)d[i]=s[i]+1.0;}
void vi(int*d,int n){for(int i=0;i<n;i++)d[i]=i;}
```
