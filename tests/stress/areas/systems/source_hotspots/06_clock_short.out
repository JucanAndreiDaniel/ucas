  rule r206(a: u8, b: u8) = (b | b - a) & 1    => (a | b) & 1              cost 2 -> 1
  rule r207(a: u8, b: u8) = (b | -a) & 1       => (a | b) & 1              cost 2 -> 1
  rule r208(a: u8, b: u8) = (a xor a + a) & 1  => a & 1                    cost 2 -> 1
  rule r209(a: u8, b: u8) = (a xor a + b) & 1  => b & 1                    cost 2 -> 1
  rule r210(a: u8, b: u8) = (a xor b + b) & 1  => a & 1                    cost 2 -> 1
  rule r211(a: u8, b: u8) = (a xor a - b) & 1  => b & 1                    cost 2 -> 1
  rule r212(a: u8, b: u8) = (a xor b - a) & 1  => b & 1                    cost 2 -> 1
  rule r213(a: u8, b: u8) = (b xor a + b) & 1  => a & 1                    cost 2 -> 1
  rule r214(a: u8, b: u8) = (a + 1 xor 1) & 1  => a & 1                    cost 2 -> 1
  rule r215(a: u8, b: u8) = (a + 255 xor 1) & 1 => a & 1                    cost 2 -> 1
  rule r216(a: u8, b: u8) = (a + 1 xor 0xff) & 1 => a & 1                    cost 2 -> 1
  rule r217(a: u8, b: u8) = (1 - a xor 0xff) & 1 => a & 1                    cost 2 -> 1
  rule r218(a: u8, b: u8) = -(a & 1) & 1       => a & 1                    cost 3 -> 1
  rule r219(a: u8, b: u8) = -(a xor b) & 1     => a + b & 1                cost 3 -> 2
  rule r220(a: u8, b: u8) = -(a xor 1) & 1     => 1 - (a & 1)              cost 3 -> 2
  rule r221(a: u8, b: u8) = a + a & a + 255    => a & a + a                cost 3 -> 2
  rule r222(a: u8, b: u8) = 255 - a & 255 - b  => 255 - (a | b)            cost 3 -> 2
  rule r223(a: u8, b: u8) = a | (a | 1) + 255  => a                        cost 3 -> 0
  rule r224(a: u8, b: u8) = a | a - (a & b)    => a                        cost 3 -> 0
  rule r225(a: u8, b: u8) = a | b - (a & b)    => a | b                    cost 3 -> 1
  rule r226(a: u8, b: u8) = a | 255 - (a | b)  => a | 255 - b              cost 3 -> 2
  rule r227(a: u8, b: u8) = a | 255 - (a xor b) => a | 255 - b              cost 3 -> 2
  rule r228(a: u8, b: u8) = a | a + b & 1      => a | b & 1                cost 2 -> 1
  rule r229(a: u8, b: u8) = a | a & b & 1      => a                        cost 1 -> 0
  rule r230(a: u8, b: u8) = b | a - (a & b)    => a | b                    cost 3 -> 1
  rule r231(a: u8, b: u8) = b | 255 - (a | b)  => b | 255 - a              cost 3 -> 2
  rule r232(a: u8, b: u8) = b | 255 - (a xor b) => b | 255 - a              cost 3 -> 2
  rule r233(a: u8, b: u8) = b | a + b & 1      => b | a & 1                cost 2 -> 1
  rule r234(a: u8, b: u8) = a + (a & 1) | 1    => a + 1 | 1                cost 3 -> 2
  rule r235(a: u8, b: u8) = a + (a | 1) | 1    => a + a + 1                cost 3 -> 2
  rule r236(a: u8, b: u8) = a + a + 1 | 1      => a + a + 1                cost 3 -> 2
  rule r237(a: u8, b: u8) = a + a + 255 | 1    => a + a + 255              cost 3 -> 2
  rule r238(a: u8, b: u8) = (a & 1) + 255 | 1  => a - (a xor 1)            cost 3 -> 2
  rule r239(a: u8, b: u8) = (a | 1) + 255 | 1  => a | 1                    cost 3 -> 1
  rule r240(a: u8, b: u8) = 1 - (a | 1) | 1    => 1 - a | 1                cost 3 -> 2
  rule r241(a: u8, b: u8) = 1 - (a xor 1) | 1  => 1 - a | 1                cost 3 -> 2
  rule r242(a: u8, b: u8) = 255 - (a | 1) | 1  => 255 - a | 1              cost 3 -> 2
  rule r243(a: u8, b: u8) = 255 - (a xor 1) | 1 => 255 - a | 1              cost 3 -> 2
  rule r244(a: u8, b: u8) = -a - a | 1         => 1 - (a + a)              cost 3 -> 2
  rule r245(a: u8, b: u8) = -(a & 1) | 1       => (a xor 1) - a            cost 3 -> 2
  rule r246(a: u8, b: u8) = 255 - a | 255 - b  => 255 - (a & b)            cost 3 -> 2
  rule r247(a: u8, b: u8) = a & 1 | -a         => -a                       cost 2 -> 1
  rule r248(a: u8, b: u8) = a xor (a | 1) + 255 => a & 1                    cost 3 -> 1
  rule r249(a: u8, b: u8) = a xor a - (a & b)  => a & b                    cost 3 -> 1
  rule r250(a: u8, b: u8) = a xor b - (a & b)  => a | b                    cost 3 -> 1
  rule r251(a: u8, b: u8) = a xor 255 - (a & b) => b | 255 - a              cost 3 -> 2
  rule r252(a: u8, b: u8) = a xor 255 - (a | b) => a | 255 - b              cost 3 -> 2
  rule r253(a: u8, b: u8) = a xor 255 - (a xor b) => 255 - b                  cost 3 -> 1
  rule r254(a: u8, b: u8) = b xor a - (a & b)  => a | b                    cost 3 -> 1
  rule r255(a: u8, b: u8) = b xor b - (a & b)  => a & b                    cost 3 -> 1
  rule r256(a: u8, b: u8) = b xor 255 - (a & b) => a | 255 - b              cost 3 -> 2
> show f
f(x: u8 in 0..15) = x*x + x
  -> u8
