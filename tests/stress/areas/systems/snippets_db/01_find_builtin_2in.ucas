f1(a: u32, b: u32) = ((a + b) | (a - b)) & ~((a + b) & (a - b))
find f1 1
find f1 1 snippets
f2(a: u32, b: u32) = a + b
find f2 1 snippets
f3(a: u32, b: u32) = a ^ b
find f3 1 snippets
f4(a: u32, b: u32) = a & b
find f4 1 snippets
f5(a: u32, b: u32) = a * b
find f5 1 snippets
f6(a: u32, b: u32) = a - b
find f6 1 snippets
f7(a: u32, b: u32) = (a << 1) + (a >> 31)
find f7 1 snippets
