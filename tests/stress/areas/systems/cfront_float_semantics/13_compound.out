  comp_pd(a: f32, b: f64) = f32(f64(a) + b)
  comp_dp(a: f64, b: f32) = a + f64(b)
  comp_mul(a: f32, b: i32) = a*f32(b)
  incr(a: f32) = a + 1
  decr(a: f64) = a - 1
  ternary(a: f32, b: f64, c: i32) = f32(c != 0 ? f64(a) : b)
  chain(a: f32, b: f32, c: f32) = i32(f32(i32(a < b)) < c)
  truth(a: f32) = a != 0 ? 1 : 0
