> c lower nofile
  f_f32(a: f32, b: f32) = a + b
  f_f64(a: f64, b: f64) = a + b
  f_f32ret_f64(a: f32, b: f32) = f64(a + b)
  f_f64args(a: f64, b: f64) = f32(a + b)
  f_mixed(a: f32, b: f64) = f64(a) + b
  f_mixed2(a: f64, b: f32) = a + f64(b)
  f_constdbl(a: f32) = f32(f64(a) + 0.10000000000000001)
  f_constflt(a: f32) = f64(a + 0.100000001)
  f_chain(a: f32, b: f32, c: f32) = a + b + c
  f_chain2(a: f64, b: f64, c: f64) = a + b + c
  f_roundtrip(a: f32) = f32(f64(a))
