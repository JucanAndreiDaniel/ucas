```c
int pun_float_bits(float f){return *(int*)&f;}
float pun_int_bits(int i){return *(float*)&i;}
unsigned pun_float_u(float f){return *(unsigned*)&f;}
int pun_via_void(float f){void*p=&f;return *(int*)p;}
