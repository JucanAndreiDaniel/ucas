typedef union { float f; int i; unsigned u; } U;
int union_pun(float f){U u;u.f=f;return u.i;}
float union_ipun(int i){U u;u.i=i;return u.f;}
typedef union { double d; long long ll; } D;
long long union_dpun(double d){D u;u.d=d;return u.ll;}
