> c lower nofile
  shl(a: i32, n: i32) = a << n
  shr(a: i32, n: i32) = a >> n
  ushl(a: u32, n: u32) = a << n
  ushr(a: u32, n: u32) = a >> n
  shl_const(a: i32) = a << 32
  shr_neg(a: i32) = a >> -1
  shl_guard(x: u32, n: u32) = i32(i32(n < 32) != 0 ? x << n : 0)
  shr_guard(x: i32, n: i32) = i32(i32(n >= 0) != 0 && i32(n < 32) != 0) != 0 ? x >> n : -1
