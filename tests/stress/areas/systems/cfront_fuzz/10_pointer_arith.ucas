c optimize nofile budget 3
```c
int parray(int*p,int n){int s=0;for(int i=0;i<n;i++)s+=p[i];return s;}
int ptrinc(int*p,int n){int s=0;for(int i=0;i<n;i++)s+=*p++;return s;}
int ptrdiff(int*a,int*b){return (int)(b-a);}
void arrstore(int*a,int n){for(int i=0;i<n;i++)a[i]=i;}
int ptreq(int*a,int*b){return a==b;}
```
