c lower nofile
```c
int a1(int x){return x&0;}
int a2(int x){return x^x;}
int a3(int x){return ~x+1;}
int a4(int x){return x==x;}
int a5(int x){return x&&x;}
int a6(int x){return !!x;}
int a7(unsigned x){return x&(x-1);}
int a8(int a,int b){return a<b?a:b;}
int a9(int x){return (x++,x+1);}
int a10(int x){return x?x:-x;}
```
