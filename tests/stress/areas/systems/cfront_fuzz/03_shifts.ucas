c lower nofile
```c
int shl(int a,int n){return a<<n;}
int shr(int a,int n){return a>>n;}
unsigned ushl(unsigned a,unsigned n){return a<<n;}
unsigned ushr(unsigned a,unsigned n){return a>>n;}
int shl_const(int a){return a<<32;}
int shr_neg(int a){return a>>-1;}
int shl_guard(unsigned x,unsigned n){return n<32?x<<n:0;}
int shr_guard(int x,int n){return n>=0&&n<32?x>>n:-1;}
```
