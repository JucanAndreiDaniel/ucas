c optimize nofile budget 3
```c
int sum(int n){int s=0;for(int i=0;i<n;i++)s+=i;return s;}
int sq(int n){int s=0;for(int i=0;i<n;i++)s+=i*i;return s;}
int series(int n){int s=0;for(int i=0;i<n;i++)s+=2*i+1;return s;}
int step2(int n){int s=0;for(int i=0;i<n;i+=2)s+=i;return s;}
int downto(int n){int s=0;for(int i=n;i>0;i--)s+=i;return s;}
```
