> c lower nofile
  uadd(a: u32, b: u32) = a + b
  umul(a: u32, b: u32) = a*b
  usub(a: u32, b: u32) = a - b
  cu(a: u8, b: u8) = u8(i32(a) + i32(b))
    defined where (no C UB): t1 >= -2147483648 && t1 <= 2147483647 where t1 = i64(i32(a)) + i64(i32(b))
  us(a: u16, b: u16) = u16(i32(a)*i32(b))
    defined where (no C UB): t1 >= -2147483648 && t1 <= 2147483647 where t1 = i64(i32(a))*i64(i32(b))
  ull(a: u64, b: u64) = a + b
  wrapneg(a: u32) = -a
  wrapsub(a: u32, b: u32) = a - 3b
