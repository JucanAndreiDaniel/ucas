> f(x: u32) = x*x + 7
> dot(x: u32) = { s = 0; for i in 0..99 { s = s + (x + i) * (x xor i) }; s }
> q(x: u32) = (x * 3 + 7) / 13 + popcnt(x)
> h(x: f32, y: f32) = { a = x; for i in 1..32 { a = a * y + x }; a }
> one(x: u32) = 1
