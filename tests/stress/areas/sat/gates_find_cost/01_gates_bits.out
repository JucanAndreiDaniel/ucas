> maj(a: bool, b: bool, c: bool) = a & b | a & c | b & c
> mux(a: bool, b: bool, c: bool) = a ? b : c
> minority(a: bool, b: bool, c: bool) = !(a & b | a & c | b & c)
> eq2(a: bool, b: bool) = a == b
> add2(x: u2, y: u2) = x + y
> isqrt4(x: u4) = isqrt(x)
