/* sega, basis c: bits are independent lanes, so the same code also
   runs bit-sliced on whole words */
static inline uint32_t
sega_gates(uint32_t d)
{
	uint32_t d0 = d >> 0 & 1;
	uint32_t d1 = d >> 1 & 1;
	uint32_t d2 = d >> 2 & 1;
	uint32_t d3 = d >> 3 & 1;
	uint32_t t0 = d1 | d3;
	uint32_t t1 = d0 ^ d2;
	uint32_t t2 = ~t1;
	uint32_t t3 = t0 | t2;
	return (t3 & 1) << 0;
}
