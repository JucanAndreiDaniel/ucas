# Fusion pairs (Semantic Fusion / YinYang): one generator tree,
# two provably-equal emitters. equiv must prove equal; error ~0.
f_ident_dblneg(x: u8, y: u8) = (x + y)
g_ident_dblneg(x: u8, y: u8) = (-(-(x + y)))
equiv f_ident_dblneg g_ident_dblneg
error g_ident_dblneg ~ f_ident_dblneg
f_ident_dblneg_s(x: i8, y: i8) = (x - y)
g_ident_dblneg_s(x: i8, y: i8) = (-(-(x - y)))
equiv f_ident_dblneg_s g_ident_dblneg_s
error g_ident_dblneg_s ~ f_ident_dblneg_s
