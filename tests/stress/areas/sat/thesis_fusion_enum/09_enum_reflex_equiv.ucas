# Enumeration reflexivity: equiv e e must prove equal for every expression.
r0(x: u4, y: u4) = (y * 0)
equiv r0 r0
r1(x: u4, y: u4) = (y * 1)
equiv r1 r1
r2(x: u4, y: u4) = (y * 2)
equiv r2 r2
r3(x: u4, y: u4) = (y * 3)
equiv r3 r3
r4(x: u4, y: u4) = (0 * x)
equiv r4 r4
r5(x: u4, y: u4) = (0 * y)
equiv r5 r5
r6(x: u4, y: u4) = (0 * 0)
equiv r6 r6
r7(x: u4, y: u4) = (0 * 1)
equiv r7 r7
r8(x: u4, y: u4) = (0 * 2)
equiv r8 r8
r9(x: u4, y: u4) = (0 * 3)
equiv r9 r9
r10(x: u4, y: u4) = (1 * x)
equiv r10 r10
r11(x: u4, y: u4) = (1 * y)
equiv r11 r11
r12(x: u4, y: u4) = (1 * 0)
equiv r12 r12
r13(x: u4, y: u4) = (1 * 1)
equiv r13 r13
r14(x: u4, y: u4) = (1 * 2)
equiv r14 r14
