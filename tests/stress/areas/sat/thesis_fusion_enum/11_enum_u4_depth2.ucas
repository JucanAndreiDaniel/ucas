# Bounded depth-2 enumeration: range over u4.
d2_0(x: u4, y: u4) = ((y + 3) + 1)
range d2_0
d2_1(x: u4, y: u4) = (2 + (3 & 2))
range d2_1
d2_2(x: u4, y: u4) = ((y + 0) + 3)
range d2_2
d2_3(x: u4, y: u4) = ((3 | x) - 2)
range d2_3
d2_4(x: u4, y: u4) = ((1 - x) - 1)
range d2_4
d2_5(x: u4, y: u4) = (3 - (3 * 1))
range d2_5
d2_6(x: u4, y: u4) = ((2 >> y) * 2)
range d2_6
d2_7(x: u4, y: u4) = (y * (y + 2))
range d2_7
d2_8(x: u4, y: u4) = (1 * (x * 3))
range d2_8
d2_9(x: u4, y: u4) = (0 & (1 | 1))
range d2_9
d2_10(x: u4, y: u4) = ((x - 2) & 0)
range d2_10
d2_11(x: u4, y: u4) = ((0 * 2) & 0)
range d2_11
d2_12(x: u4, y: u4) = ((x xor 3) | 1)
range d2_12
d2_13(x: u4, y: u4) = ((3 xor x) | 1)
range d2_13
d2_14(x: u4, y: u4) = (3 | (2 & 0))
range d2_14
d2_15(x: u4, y: u4) = (2 xor (2 + 0))
range d2_15
d2_16(x: u4, y: u4) = (3 xor (x >> 2))
range d2_16
d2_17(x: u4, y: u4) = ((y xor 2) xor x)
range d2_17
