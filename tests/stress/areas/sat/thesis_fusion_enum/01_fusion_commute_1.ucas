# Fusion pairs (Semantic Fusion / YinYang): one generator tree,
# two provably-equal emitters. equiv must prove equal; error ~0.
f_comm_add(x: u8, y: u8) = (x + y)
g_comm_add(x: u8, y: u8) = (y + x)
equiv f_comm_add g_comm_add
error g_comm_add ~ f_comm_add
f_comm_mul(x: u8, y: u8) = (x * y)
g_comm_mul(x: u8, y: u8) = (y * x)
equiv f_comm_mul g_comm_mul
error g_comm_mul ~ f_comm_mul
f_comm_and(x: u8, y: u8) = (x & y)
g_comm_and(x: u8, y: u8) = (y & x)
equiv f_comm_and g_comm_and
error g_comm_and ~ f_comm_and
f_comm_or(x: u8, y: u8) = (x | y)
g_comm_or(x: u8, y: u8) = (y | x)
equiv f_comm_or g_comm_or
error g_comm_or ~ f_comm_or
f_comm_xor(x: u8, y: u8) = (x xor y)
g_comm_xor(x: u8, y: u8) = (y xor x)
equiv f_comm_xor g_comm_xor
error g_comm_xor ~ f_comm_xor
