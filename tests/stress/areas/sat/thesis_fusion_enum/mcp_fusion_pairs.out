{"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "{\"kind\": \"define\", \"name\": \"f_fx\", \"params\": [{\"name\": \"x\", \"type\": \"u8\"}, {\"name\": \"y\", \"type\": \"u8\"}, {\"name\": \"z\", \"type\": \"u8\"}], \"body\": \"(x*y)^5\", \"signature\": \"f_fx(x: u8, y: u8, z: u8)\"}"}], "structuredContent": {"id": 2, "ok": true, "cmd": "define", "ucas": "f_fx(x: u8, y: u8, z: u8) = (x*y)^5", "structured": true, "result": {"kind": "define", "name": "f_fx", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}, {"name": "z", "type": "u8"}], "body": "(x*y)^5", "signature": "f_fx(x: u8, y: u8, z: u8)"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": ""}, "isError": false}}
