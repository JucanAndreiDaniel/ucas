# Exhaustive enumeration: depth-1 expressions over + - * & | xor << >>.
e0(x: u8, y: u8) = (x - 2)
range e0
e1(x: u8, y: u8) = (x - 3)
range e1
e2(x: u8, y: u8) = (y - x)
range e2
e3(x: u8, y: u8) = (y - y)
range e3
e4(x: u8, y: u8) = (y - 0)
range e4
e5(x: u8, y: u8) = (y - 1)
range e5
e6(x: u8, y: u8) = (y - 2)
range e6
e7(x: u8, y: u8) = (y - 3)
range e7
e8(x: u8, y: u8) = (0 - x)
range e8
e9(x: u8, y: u8) = (0 - y)
range e9
e10(x: u8, y: u8) = (0 - 0)
range e10
e11(x: u8, y: u8) = (0 - 1)
range e11
e12(x: u8, y: u8) = (0 - 2)
range e12
e13(x: u8, y: u8) = (0 - 3)
range e13
e14(x: u8, y: u8) = (1 - x)
range e14
e15(x: u8, y: u8) = (1 - y)
range e15
e16(x: u8, y: u8) = (1 - 0)
range e16
e17(x: u8, y: u8) = (1 - 1)
range e17
e18(x: u8, y: u8) = (1 - 2)
range e18
e19(x: u8, y: u8) = (1 - 3)
range e19
