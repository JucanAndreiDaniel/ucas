# Exhaustive enumeration: depth-1 expressions over + - * & | xor << >>.
e0(x: u4, y: u4) = (x + x)
range e0
e1(x: u4, y: u4) = (x + y)
range e1
e2(x: u4, y: u4) = (x + 0)
range e2
e3(x: u4, y: u4) = (x + 1)
range e3
e4(x: u4, y: u4) = (x + 2)
range e4
e5(x: u4, y: u4) = (x + 3)
range e5
e6(x: u4, y: u4) = (y + x)
range e6
e7(x: u4, y: u4) = (y + y)
range e7
e8(x: u4, y: u4) = (y + 0)
range e8
e9(x: u4, y: u4) = (y + 1)
range e9
e10(x: u4, y: u4) = (y + 2)
range e10
e11(x: u4, y: u4) = (y + 3)
range e11
e12(x: u4, y: u4) = (0 + x)
range e12
e13(x: u4, y: u4) = (0 + y)
range e13
e14(x: u4, y: u4) = (0 + 0)
range e14
e15(x: u4, y: u4) = (0 + 1)
range e15
e16(x: u4, y: u4) = (0 + 2)
range e16
e17(x: u4, y: u4) = (0 + 3)
range e17
e18(x: u4, y: u4) = (1 + x)
range e18
e19(x: u4, y: u4) = (1 + y)
range e19
