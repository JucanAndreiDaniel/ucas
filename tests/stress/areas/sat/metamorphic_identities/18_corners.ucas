# Corner-constant identities across types (all true)
# All identities hold on their declared domain unless noted.
# case 1: expect EQUAL
f01(x: u8) = x | 0xFF
g01(x: u8) = 0xFF
equiv f01 g01
# case 2: expect EQUAL
f02(x: u8) = x & 0x00
g02(x: u8) = 0
equiv f02 g02
# case 3: expect EQUAL
f03(x: u8) = x xor 0xFF
g03(x: u8) = ~x
equiv f03 g03
# case 4: expect EQUAL
f04(x: u8) = x + 0xFF
g04(x: u8) = x - 1
equiv f04 g04
# case 5: expect EQUAL
f05(x: u16) = x | 0xFFFF
g05(x: u16) = 0xFFFF
equiv f05 g05
# case 6: expect EQUAL
f06(x: u16) = x & 0x0000
g06(x: u16) = 0
equiv f06 g06
# case 7: expect EQUAL
f07(x: u32) = x xor 0xFFFFFFFF
g07(x: u32) = ~x
equiv f07 g07
# case 8: expect EQUAL
f08(x: u64) = x | 0xFFFFFFFFFFFFFFFF
g08(x: u64) = 0xFFFFFFFFFFFFFFFF
equiv f08 g08
# case 9: expect EQUAL
f09(x: i8) = x + 0
g09(x: i8) = x
equiv f09 g09
# case 10: expect EQUAL
f10(x: i16) = x xor 0
g10(x: i16) = x
equiv f10 g10
# case 11: expect EQUAL
f11(x: u8) = (x & 0xFF) | (x | 0)
g11(x: u8) = x
equiv f11 g11
# case 12: expect EQUAL
f12(x: u8) = (x xor 0xFF) xor 0xFF
g12(x: u8) = x
equiv f12 g12
