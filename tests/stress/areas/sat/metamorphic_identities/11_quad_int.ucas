# Quadratic expansion on int with ranges (all true)
# All identities hold on their declared domain unless noted.
# case 1: expect EQUAL
f01(a: int in -20..20, b: int in -20..20) = (a+b)^2
g01(a: int in -20..20, b: int in -20..20) = a^2 + 2*a*b + b^2
equiv f01 g01
# case 2: expect EQUAL
f02(a: int in 0..30, b: int in 0..30) = a^2 - b^2
g02(a: int in 0..30, b: int in 0..30) = (a-b)*(a+b)
equiv f02 g02
# case 3: expect EQUAL
f03(a: int in -10..10, b: int in -10..10) = (a+b)^2 - (a-b)^2
g03(a: int in -10..10, b: int in -10..10) = 4*a*b
equiv f03 g03
# case 4: expect EQUAL
f04(a: int in 1..20, b: int in 1..20) = (a*b)^2
g04(a: int in 1..20, b: int in 1..20) = a^2*b^2
equiv f04 g04
# case 5: expect EQUAL
f05(a: int in -50..50) = (a+1)^2
g05(a: int in -50..50) = a^2 + 2*a + 1
equiv f05 g05
# case 6: expect EQUAL
f06(a: int in 0..100) = a*(a+1)
g06(a: int in 0..100) = a^2 + a
equiv f06 g06
# case 7: expect EQUAL
f07(a: int in -100..100) = (a-3)^2
g07(a: int in -100..100) = a^2 - 6*a + 9
equiv f07 g07
# case 8: expect EQUAL
f08(a: int in 0..15, b: int in 0..15, c: int in 0..15) = (a+b+c)^2
g08(a: int in 0..15, b: int in 0..15, c: int in 0..15) = a^2+b^2+c^2+2*a*b+2*a*c+2*b*c
equiv f08 g08
# case 9: expect EQUAL
f09(a: int in -5..5, b: int in -5..5) = (a+b)^3
g09(a: int in -5..5, b: int in -5..5) = a^3+3*a^2*b+3*a*b^2+b^3
equiv f09 g09
# case 10: expect EQUAL
f10(a: int in 0..40, b: int in 0..40) = (a+b)*(a-b)
g10(a: int in 0..40, b: int in 0..40) = a^2 - b^2
equiv f10 g10
# case 11: expect EQUAL
f11(a: int in 2..50) = (a-1)*(a+1)
g11(a: int in 2..50) = a^2 - 1
equiv f11 g11
# case 12: expect EQUAL
f12(a: int in -30..30, b: int in -30..30) = (2*a+3*b)^2
g12(a: int in -30..30, b: int in -30..30) = 4*a^2+12*a*b+9*b^2
equiv f12 g12
