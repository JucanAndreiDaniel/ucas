# De Morgan, absorption, associativity (all true)
# All identities hold on their declared domain unless noted.
# case 1: expect EQUAL
f01(x: u8, y: u8, z: u8) = ~(x & y & z)
g01(x: u8, y: u8, z: u8) = ~x | ~y | ~z
equiv f01 g01
# case 2: expect EQUAL
f02(x: u16, y: u16, z: u16) = ~(x | y | z)
g02(x: u16, y: u16, z: u16) = ~x & ~y & ~z
equiv f02 g02
# case 3: expect EQUAL
f03(x: u32, y: u32, z: u32) = x & (x | y | z)
g03(x: u32, y: u32, z: u32) = x
equiv f03 g03
# case 4: expect EQUAL
f04(x: u64, y: u64, z: u64) = x | (x & y & z)
g04(x: u64, y: u64, z: u64) = x
equiv f04 g04
# case 5: expect EQUAL
f05(x: u8, y: u8, z: u8) = (x xor y) xor z
g05(x: u8, y: u8, z: u8) = x xor (y xor z)
equiv f05 g05
# case 6: expect EQUAL
f06(x: u16, y: u16, z: u16) = (x & y) & z
g06(x: u16, y: u16, z: u16) = x & (y & z)
equiv f06 g06
# case 7: expect EQUAL
f07(x: u32, y: u32, z: u32) = (x | y) | z
g07(x: u32, y: u32, z: u32) = x | (y | z)
equiv f07 g07
# case 8: expect EQUAL
f08(x: u64, y: u64) = x xor y
g08(x: u64, y: u64) = y xor x
equiv f08 g08
# case 9: expect EQUAL
f09(x: u8, y: u8) = x & y
g09(x: u8, y: u8) = y & x
equiv f09 g09
# case 10: expect EQUAL
f10(x: u16, y: u16) = x | y
g10(x: u16, y: u16) = y | x
equiv f10 g10
# case 11: expect EQUAL
f11(x: i32) = ~(~x)
g11(x: i32) = x
equiv f11 g11
# case 12: expect EQUAL
f12(x: u8) = x xor ~x
g12(x: u8) = 0xFF
equiv f12 g12
