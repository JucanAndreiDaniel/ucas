# isqrt inequalities FALSE under full-range wrap (all must differ)
# All identities hold on their declared domain unless noted.
# case 1: expect DIFFER
f01(x: u8) = (isqrt(x)+1)^2 > x
g01(x: u8) = 1
equiv f01 g01
# case 2: expect DIFFER
f02(x: u16) = (isqrt(x)+1)^2 > x
g02(x: u16) = 1
equiv f02 g02
# case 3: expect DIFFER
f03(x: u32) = (isqrt(x)+1)^2 > x
g03(x: u32) = 1
equiv f03 g03
# case 4: expect DIFFER
f04(x: u64) = (isqrt(x)+1)^2 > x
g04(x: u64) = 1
equiv f04 g04
# case 5: expect DIFFER
f05(x: u8) = isqrt(x)^2 == x
g05(x: u8) = 1
equiv f05 g05
# case 6: expect DIFFER
f06(x: u16) = isqrt(x)^2 == x
g06(x: u16) = 1
equiv f06 g06
# case 7: expect DIFFER
f07(x: u8) = isqrt(x*x) == x
g07(x: u8) = 1
equiv f07 g07
# case 8: expect DIFFER
f08(x: u8) = isqrt(x+1) >= isqrt(x)
g08(x: u8) = 1
equiv f08 g08
# case 9: expect DIFFER
f09(x: u16) = isqrt(x+1) >= isqrt(x)
g09(x: u16) = 1
equiv f09 g09
# case 10: expect DIFFER
f10(x: u8) = isqrt(x) == x/2
g10(x: u8) = 1
equiv f10 g10
# case 11: expect DIFFER
f11(x: u8) = isqrt(x)^2 + 1 > x
g11(x: u8) = 1
equiv f11 g11
# case 12: expect DIFFER
f12(x: u16) = isqrt(x)^2 + 1 > x
g12(x: u16) = 1
equiv f12 g12
