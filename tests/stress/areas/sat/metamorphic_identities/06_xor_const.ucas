# XOR-constant self-cancellation across constants/types (all true)
# All identities hold on their declared domain unless noted.
# case 1: expect EQUAL
f01(x: u8) = (x xor 0) xor 0
g01(x: u8) = x
equiv f01 g01
# case 2: expect EQUAL
f02(x: u8) = (x xor 255) xor 255
g02(x: u8) = x
equiv f02 g02
# case 3: expect EQUAL
f03(x: u8) = (x xor 1) xor 1
g03(x: u8) = x
equiv f03 g03
# case 4: expect EQUAL
f04(x: u8) = (x xor 0xAA) xor 0xAA
g04(x: u8) = x
equiv f04 g04
# case 5: expect EQUAL
f05(x: u16) = (x xor 0xFFFF) xor 0xFFFF
g05(x: u16) = x
equiv f05 g05
# case 6: expect EQUAL
f06(x: u16) = (x xor 0x1234) xor 0x1234
g06(x: u16) = x
equiv f06 g06
# case 7: expect EQUAL
f07(x: u32) = (x xor 0) xor 0
g07(x: u32) = x
equiv f07 g07
# case 8: expect EQUAL
f08(x: u32) = (x xor 0xDEADBEEF) xor 0xDEADBEEF
g08(x: u32) = x
equiv f08 g08
# case 9: expect EQUAL
f09(x: u64) = (x xor 0xFFFFFFFFFFFFFFFF) xor 0xFFFFFFFFFFFFFFFF
g09(x: u64) = x
equiv f09 g09
# case 10: expect EQUAL
f10(x: u64) = (x xor 1) xor 1
g10(x: u64) = x
equiv f10 g10
# case 11: expect EQUAL
f11(x: i16) = (x xor 4660) xor 4660
g11(x: i16) = x
equiv f11 g11
# case 12: expect EQUAL
f12(x: i32) = (x xor 12345) xor 12345
g12(x: i32) = x
equiv f12 g12
