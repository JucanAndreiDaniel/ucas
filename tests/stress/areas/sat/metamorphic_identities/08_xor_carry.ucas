# Addition as xor plus carry (all true)
# All identities hold on their declared domain unless noted.
# case 1: expect EQUAL
f01(x: u8, y: u8) = (x xor y) + 2*(x & y)
g01(x: u8, y: u8) = x + y
equiv f01 g01
# case 2: expect EQUAL
f02(x: u16, y: u16) = (x xor y) + 2*(x & y)
g02(x: u16, y: u16) = x + y
equiv f02 g02
# case 3: expect EQUAL
f03(x: u32, y: u32) = (x xor y) + 2*(x & y)
g03(x: u32, y: u32) = x + y
equiv f03 g03
# case 4: expect EQUAL
f04(x: u64, y: u64) = (x xor y) + 2*(x & y)
g04(x: u64, y: u64) = x + y
equiv f04 g04
# case 5: expect EQUAL
f05(x: i8, y: i8) = (x xor y) + 2*(x & y)
g05(x: i8, y: i8) = x + y
equiv f05 g05
# case 6: expect EQUAL
f06(x: i16, y: i16) = (x xor y) + 2*(x & y)
g06(x: i16, y: i16) = x + y
equiv f06 g06
# case 7: expect EQUAL
f07(x: i32, y: i32) = (x xor y) + 2*(x & y)
g07(x: i32, y: i32) = x + y
equiv f07 g07
# case 8: expect EQUAL
f08(x: i64, y: i64) = (x xor y) + 2*(x & y)
g08(x: i64, y: i64) = x + y
equiv f08 g08
# case 9: expect EQUAL
f09(x: u8, y: u8) = (x & y) + (x xor y)
g09(x: u8, y: u8) = x | y
equiv f09 g09
# case 10: expect EQUAL
f10(x: u16, y: u16) = (x & y) + (x xor y)
g10(x: u16, y: u16) = x | y
equiv f10 g10
# case 11: expect EQUAL
f11(x: u32, y: u32) = (x & y) + (x xor y)
g11(x: u32, y: u32) = x | y
equiv f11 g11
# case 12: expect EQUAL
f12(x: u64, y: u64) = (x & y) + (x xor y)
g12(x: u64, y: u64) = x | y
equiv f12 g12
