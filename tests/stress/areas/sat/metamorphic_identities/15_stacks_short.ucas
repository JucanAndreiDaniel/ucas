# Stacked identity rewrites (2-3 deep, all true)
# All identities hold on their declared domain unless noted.
# case 1: expect EQUAL
f01(x: u8) = x
g01(x: u8) = (x xor 0) | (x & 0)
equiv f01 g01
# case 2: expect EQUAL
f02(x: u8) = x
g02(x: u8) = ((x xor 0) | (x & 0)) xor 0
equiv f02 g02
# case 3: expect EQUAL
f03(x: u8) = x
g03(x: u8) = (~(~x) xor 0) + 0
equiv f03 g03
# case 4: expect EQUAL
f04(x: u16) = x
g04(x: u16) = ((x | 0) xor 0) & 0xFFFF
equiv f04 g04
# case 5: expect EQUAL
f05(x: u8, y: u8) = x + y
g05(x: u8, y: u8) = (x xor y) + 2*(x & y)
equiv f05 g05
# case 6: expect EQUAL
f06(x: u8, y: u8) = x + y
g06(x: u8, y: u8) = ((x xor y) + 2*(x & y)) xor 0
equiv f06 g06
# case 7: expect EQUAL
f07(x: u32, y: u32) = x | y
g07(x: u32, y: u32) = (x&y)+(x xor y)
equiv f07 g07
# case 8: expect EQUAL
f08(x: u32, y: u32) = x | y
g08(x: u32, y: u32) = ((x&y)+(x xor y)) | 0
equiv f08 g08
# case 9: expect EQUAL
f09(x: u8) = x*x
g09(x: u8) = (x xor 0)*(x xor 0)
equiv f09 g09
# case 10: expect EQUAL
f10(x: u8) = x*x
g10(x: u8) = ((x xor 0)*(x xor 0)) + 0
equiv f10 g10
# case 11: expect EQUAL
f11(a: int in -10..10, b: int in -10..10) = (a+b)^2
g11(a: int in -10..10, b: int in -10..10) = a^2+2*a*b+b^2
equiv f11 g11
# case 12: expect EQUAL
f12(a: int in -10..10, b: int in -10..10) = a^2+2*a*b+b^2
g12(a: int in -10..10, b: int in -10..10) = (~(~(a*a+2*a*b+b*b)))
equiv f12 g12
