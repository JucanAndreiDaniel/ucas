# Identities on i8/i16/i32/i64 (all true)
# All identities hold on their declared domain unless noted.
# case 1: expect EQUAL
f01(x: i8) = x + x
g01(x: i8) = x << 1
equiv f01 g01
# case 2: expect EQUAL
f02(x: i8) = ~x
g02(x: i8) = -x - 1
equiv f02 g02
# case 3: expect EQUAL
f03(x: i16, y: i16) = ~(x & y)
g03(x: i16, y: i16) = ~x | ~y
equiv f03 g03
# case 4: expect EQUAL
f04(x: i32) = (x xor 12345) xor 12345
g04(x: i32) = x
equiv f04 g04
# case 5: expect EQUAL
f05(x: i64, y: i64, z: i64) = x*(y+z)
g05(x: i64, y: i64, z: i64) = x*y+x*z
equiv f05 g05
# case 6: expect EQUAL
f06(x: i16, y: i16) = x xor y
g06(x: i16, y: i16) = (x | y) - (x & y)
equiv f06 g06
# case 7: expect EQUAL
f07(x: i8) = x - x
g07(x: i8) = x * 0
equiv f07 g07
# case 8: expect EQUAL
f08(x: i64, y: i64) = (x + y) - y
g08(x: i64, y: i64) = x
equiv f08 g08
# case 9: expect EQUAL
f09(x: i32, y: i32) = x & (x | y)
g09(x: i32, y: i32) = x
equiv f09 g09
# case 10: expect EQUAL
f10(x: i8, y: i8) = (x & y) + (x xor y)
g10(x: i8, y: i8) = x | y
equiv f10 g10
# case 11: expect EQUAL
f11(x: i16) = x + x
g11(x: i16) = x << 1
equiv f11 g11
# case 12: expect EQUAL
f12(x: i32) = ~x
g12(x: i32) = -x - 1
equiv f12 g12
