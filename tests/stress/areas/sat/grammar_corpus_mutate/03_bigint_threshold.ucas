# The flip happens exactly at 2^63: below it, equiv finds the mismatch;
# at/above it, equiv claims exhaustive equality (opposite verdict for a
# one-step change in the exponent).
a(x: u8) = 2^62
b(x: u8) = x
equiv a b
c(x: u8) = 2^63
d(x: u8) = x
equiv c d
c(x: u8) = 2^63 - 1
d(x: u8) = x
equiv c d
