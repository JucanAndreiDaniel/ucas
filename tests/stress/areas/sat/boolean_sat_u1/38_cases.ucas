# Auto-generated boolean/u1 stress cases (oracle-verified)
dblneg_A(a: bool) = a
dblneg_B(a: bool) = !!a
equiv dblneg_A ~ dblneg_B
xor0_A(a: bool) = a
xor0_B(a: bool) = a xor 0
equiv xor0_A ~ xor0_B
xor1_A(a: bool) = !a
xor1_B(a: bool) = a xor 1
equiv xor1_A ~ xor1_B
xorself_A(a: bool) = 0
xorself_B(a: bool) = a xor a
equiv xorself_A ~ xorself_B
xor_or_and_A(a: bool, b: bool) = a xor b
xor_or_and_B(a: bool, b: bool) = (a | b) & !(a & b)
equiv xor_or_and_A ~ xor_or_and_B
xor_comm_A(a: bool, b: bool) = a xor b
xor_comm_B(a: bool, b: bool) = b xor a
equiv xor_comm_A ~ xor_comm_B
xor_assoc_A(a: bool, b: bool, c: bool) = (a xor b) xor c
xor_assoc_B(a: bool, b: bool, c: bool) = a xor (b xor c)
equiv xor_assoc_A ~ xor_assoc_B
xor_distrib_A(a: bool, b: bool, c: bool) = a & (b xor c)
xor_distrib_B(a: bool, b: bool, c: bool) = (a & b) xor (a & c)
equiv xor_distrib_A ~ xor_distrib_B
