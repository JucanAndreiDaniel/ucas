# Auto-generated boolean/u1 stress cases (oracle-verified)
co_bool_xoradd(x: bool, y: bool) = (x + y) xor 0
table co_bool_xoradd
cua(x: bool) = u1(x)
cub(x: bool) = x
equiv cua ~ cub
cia(x: bool) = int(x)
cib(x: bool) = x
equiv cia ~ cib
caa(x: u1, y: u1) = x + y
cab(x: u1, y: u1) = x xor y
equiv caa ~ cab
ob_not(a: bool) = !a
range ob_not
ob_id(a: bool) = a
range ob_id
ob_const1(a: bool) = 1
range ob_const1
ob_const0(a: bool) = 0
range ob_const0
