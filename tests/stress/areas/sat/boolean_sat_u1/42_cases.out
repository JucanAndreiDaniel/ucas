> co_not_u1(x: u1) = ~x
> table co_not_u1
  x=0  ->  1
  x=1  ->  0
> co_add_u1(x: u1, y: u1) = x + y
> table co_add_u1
  x=0, y=0  ->  0
  x=1, y=0  ->  1
  x=0, y=1  ->  1
  x=1, y=1  ->  0
> co_mul_u1(x: u1, y: u1) = x * y
> table co_mul_u1
  x=0, y=0  ->  0
  x=1, y=0  ->  0
  x=0, y=1  ->  0
  x=1, y=1  ->  1
> co_and_u1(x: u1, y: u1) = x & y
> table co_and_u1
  x=0, y=0  ->  0
  x=1, y=0  ->  0
  x=0, y=1  ->  0
  x=1, y=1  ->  1
> co_or_u1(x: u1, y: u1) = x | y
> table co_or_u1
  x=0, y=0  ->  0
  x=1, y=0  ->  1
  x=0, y=1  ->  1
  x=1, y=1  ->  1
> co_xor_u1(x: u1, y: u1) = x xor y
> table co_xor_u1
  x=0, y=0  ->  0
  x=1, y=0  ->  1
  x=0, y=1  ->  1
  x=1, y=1  ->  0
> co_cmp_u1(x: u1, y: u1) = x < y
> table co_cmp_u1
  x=0, y=0  ->  0
  x=1, y=0  ->  0
  x=0, y=1  ->  1
  x=1, y=1  ->  0
> co_bool_arith(x: bool, y: bool) = x + y
> table co_bool_arith
  x=0, y=0  ->  0
  x=1, y=0  ->  1
  x=0, y=1  ->  1
  x=1, y=1  ->  2
