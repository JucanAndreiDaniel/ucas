> ba2(x: bool, y: bool) = x + y
> table ba2
  x=0, y=0  ->  0
  x=1, y=0  ->  1
  x=0, y=1  ->  1
  x=1, y=1  ->  2
> ba3(x: bool) = x + 2
> table ba3
  x=0  ->  2
  x=1  ->  3
> bs(x: bool) = x - 1
> table bs
  x=0  ->  -1
  x=1  ->  0
> bm3(x: bool) = x * 3
> table bm3
  x=0  ->  0
  x=1  ->  3
> um3(x: u1) = x * 3
  note: literal 3 does not fit u1; it becomes 1
> table um3
  x=0  ->  0
  x=1  ->  1
> um5(x: u1) = x * 5
  note: literal 5 does not fit u1; it becomes 1
> table um5
  x=0  ->  0
  x=1  ->  1
> ua3(x: u1) = x + 3
  note: literal 3 does not fit u1; it becomes 1
> table ua3
  x=0  ->  1
  x=1  ->  0
> us(x: u1) = x << 1
> table us
  x=0  ->  undefined
  x=1  ->  undefined
