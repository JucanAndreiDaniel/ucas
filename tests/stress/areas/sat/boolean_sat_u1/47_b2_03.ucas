# Coercion/cross-type/partial-domain oracle-verified cases
ush(x: u1) = x >> 1
table ush
uaa(x: u1, y: u1) = x && y
table uaa
uoo(x: u1, y: u1) = x || y
table uoo
unn(x: u1) = not x
table unn
ube(x: u1, y: u1) = x != y
table ube
cb(x: bool) = 0 <= x <= 1
table cb
cu(x: u1) = 0 <= x <= 1
table cu
cm(x: u1, y: bool) = x <= y <= 1
table cm
