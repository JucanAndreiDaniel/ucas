# Coercion/cross-type/partial-domain oracle-verified cases
ba2(x: bool, y: bool) = x + y
table ba2
ba3(x: bool) = x + 2
table ba3
bs(x: bool) = x - 1
table bs
bm3(x: bool) = x * 3
