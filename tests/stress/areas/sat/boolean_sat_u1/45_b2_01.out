> cba(x: bool) = x
> cbb(x: u1) = x
> equiv cba ~ cbb
cba and cbb are equal on the domain of cba (exhaustive)
> cna(x: bool) = !x
> cnb(x: u1) = ~x
> equiv cna ~ cnb
cna and cnb are equal on the domain of cna (exhaustive)
> cia(x: bool) = int(x)
> cib(x: u1) = u1(x)
> equiv cia ~ cib
cia and cib are equal on the domain of cia (exhaustive)
> xna(a: bool, b: bool) = a xor b
> xnb(a: bool, b: bool) = a != b
> equiv xna ~ xnb
xna and xnb are equal on the domain of xna (exhaustive)
> nda(a: bool, b: bool) = !(a & b)
> ndb(a: bool, b: bool) = !a | !b
> equiv nda ~ ndb
nda and ndb are equal on the domain of nda (exhaustive)
> nora(a: bool, b: bool) = !(a | b)
> norb(a: bool, b: bool) = !a & !b
> equiv nora ~ norb
nora and norb are equal on the domain of nora (exhaustive)
> xna2(a: bool, b: bool) = a == b
> xnb2(a: bool, b: bool) = !(a xor b)
> equiv xna2 ~ xnb2
xna2 and xnb2 are equal on the domain of xna2 (exhaustive)
> i1a(a: bool, b: bool) = !a | b
> i1b(a: bool, b: bool) = a ? b : 1
> equiv i1a ~ i1b
i1a and i1b are equal on the domain of i1a (exhaustive)
