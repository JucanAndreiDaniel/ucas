> co_bool_xoradd(x: bool, y: bool) = (x + y) xor 0
> table co_bool_xoradd
  x=0, y=0  ->  0
  x=1, y=0  ->  1
  x=0, y=1  ->  1
  x=1, y=1  ->  2
> cua(x: bool) = u1(x)
> cub(x: bool) = x
> equiv cua ~ cub
cua and cub are equal on the domain of cua (exhaustive)
> cia(x: bool) = int(x)
> cib(x: bool) = x
> equiv cia ~ cib
cia and cib are equal on the domain of cia (exhaustive)
> caa(x: u1, y: u1) = x + y
> cab(x: u1, y: u1) = x xor y
> equiv caa ~ cab
caa and cab are equal on the domain of caa (exhaustive)
> ob_not(a: bool) = !a
> range ob_not
range of ob_not -> bool:
  0..1   (2 distinct values)
  values: 0..1
  fits in u1
  over all 2 points of the domain
> ob_id(a: bool) = a
> range ob_id
range of ob_id -> bool:
  0..1   (2 distinct values)
  values: 0..1
  fits in u1
  over all 2 points of the domain
> ob_const1(a: bool) = 1
> range ob_const1
range of ob_const1 -> int:
  1..1
  fits in u1
  over all 2 points of the domain
> ob_const0(a: bool) = 0
> range ob_const0
range of ob_const0 -> int:
  0..0
  fits in u1
  over all 2 points of the domain
