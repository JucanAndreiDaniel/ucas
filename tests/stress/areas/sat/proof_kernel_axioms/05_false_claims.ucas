# Deliberately false / unprovable claims: must be rejected with a counterexample,
# never accepted as a kernel proof.
theorem f01: forall x:int: x = x + 1
prove f01
theorem f02: forall x:int: x*x >= x + 1
prove f02
theorem f03: forall x y:el: 3*(x + y) - x = x + 3*y
prove f03
theorem f04: forall x:int: 2 <= x and 1 = 3*x -> false
prove f04
