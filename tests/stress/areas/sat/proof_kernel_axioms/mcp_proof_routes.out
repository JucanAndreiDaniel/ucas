{"jsonrpc": "2.0", "id": 4, "result": {"content": [{"type": "text", "text": "the axioms mr1 rests on (every route):\nint_discrete   [integer arithmetic] forall n:int: n <= 0 or 1 <= n\nsubgroup_def   [definition] forall S:set: subgroup(S) <-> (0 in S and (forall x y:el: x in S and y in S -> x + y in S) and (forall x:el: x in S -> -x in S))\nexcouple_def   [definition] forall c:cpl: excouple(c) <-> (subgroup(D(c)) and subgroup(E(c)) and (forall x:el: x in D(c) -> i(c,x) in D(c)) and (forall x:el: x in D(c) -> j(c,x) in E(c)) and (forall e:el: e in E(c) -> k(c,e) in D(c)) and (forall x:el: x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)) and (forall x:el: x in D(c) -> j(c,i(c,x)) = 0) and (forall e:el: e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)) and (forall x:el: x in D(c) -> k(c,j(c,x)) = 0) and (forall x:el: x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)) and (forall e:el: e in E(c) -> i(c,k(c,e)) = 0))\nipow_zero      [definition] forall c:cpl, x:el: ipow(c,0,x) = x\nipow_succ      [definition] forall c:cpl, m:int, x:el: 0 <= m -> ipow(c,m+1,x) = i(c,ipow(c,m,x))\nipow_neg       [definition] forall c:cpl, m:int, x:el: m < 0 -> ipow(c,m,x) = 0\nD1_def         [definition] forall c:cpl, x:el: Dr(c,1,x) <-> x in D(c)\nZ1_def         [definition] forall c:cpl, e:el: Zr(c,1,e) <-> e in E(c)\nB1_def         [definition] forall c:cpl, e:el: Br(c,1,e) <-> e = 0\nJ1_def         [definition] forall c:cpl, x e:el: Jr(c,1,x,e) <-> (x in D(c) and e = j(c,x))\nDsucc_def      [definition] forall c:cpl, r:int, y:el: 1 <= r -> (Dr(c,r+1,y) <-> (exists x:el: Dr(c,r,x) and y = i(c,x)))\nZsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Zr(c,r+1,e) <-> (Zr(c,r,e) and exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f)))\nBsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Br(c,r+1,e) <-> (exists e0 f:el: Zr(c,r,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f)))\nJsucc_def      [definition] forall c:cpl, r:int, y e:el: 1 <= r -> (Jr(c,r+1,y,e) <-> (exists x f:el: Dr(c,r,x) and y = i(c,x) and Jr(c,r,x,f) and Br(c,r+1,e - f)))\n"}], "structuredContent": {"id": 4, "ok": true, "cmd": "axioms", "ucas": "axioms mr1", "structured": true, "result": {"kind": "axioms", "name": "mr1", "axioms": [{"name": "int_discrete", "kind": "integer arithmetic", "statement": "forall n:int: n <= 0 or 1 <= n"}, {"name": "subgroup_def", "kind": "definition", "statement": "forall S:set: subgroup(S) <-> (0 in S and (forall x y:el: x in S and y in S -> x + y in S) and (forall x:el: x in S -> -x in S))"}, {"name": "excouple_def", "kind": "definition", "statement": "forall c:cpl: excouple(c) <-> (subgroup(D(c)) and subgroup(E(c)) and (forall x:el: x in D(c) -> i(c,x) in D(c)) and (forall x:el: x in D(c) -> j(c,x) in E(c)) and (forall e:el: e in E(c) -> k(c,e) in D(c)) and (forall x:el: x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)) and (forall x:el: x in D(c) -> j(c,i(c,x)) = 0) and (forall e:el: e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)) and (forall x:el: x in D(c) -> k(c,j(c,x)) = 0) and (forall x:el: x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)) and (forall e:el: e in E(c) -> i(c,k(c,e)) = 0))"}, {"name": "ipow_zero", "kind": "definition", "statement": "forall c:cpl, x:el: ipow(c,0,x) = x"}, {"name": "ipow_succ", "kind": "definition", "statement": "forall c:cpl, m:int, x:el: 0 <= m -> ipow(c,m+1,x) = i(c,ipow(c,m,x))"}, {"name": "ipow_neg", "kind": "definition", "statement": "forall c:cpl, m:int, x:el: m < 0 -> ipow(c,m,x) = 0"}, {"name": "D1_def", "kind": "definition", "statement": "forall c:cpl, x:el: Dr(c,1,x) <-> x in D(c)"}, {"name": "Z1_def", "kind": "definition", "statement": "forall c:cpl, e:el: Zr(c,1,e) <-> e in E(c)"}, {"name": "B1_def", "kind": "definition", "statement": "forall c:cpl, e:el: Br(c,1,e) <-> e = 0"}, {"name": "J1_def", "kind": "definition", "statement": "forall c:cpl, x e:el: Jr(c,1,x,e) <-> (x in D(c) and e = j(c,x))"}, {"name": "Dsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, y:el: 1 <= r -> (Dr(c,r+1,y) <-> (exists x:el: Dr(c,r,x) and y = i(c,x)))"}, {"name": "Zsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, e:el: 1 <= r -> (Zr(c,r+1,e) <-> (Zr(c,r,e) and exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f)))"}, {"name": "Bsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, e:el: 1 <= r -> (Br(c,r+1,e) <-> (exists e0 f:el: Zr(c,r,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f)))"}, {"name": "Jsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, y e:el: 1 <= r -> (Jr(c,r+1,y,e) <-> (exists x f:el: Dr(c,r,x) and y = i(c,x) and Jr(c,r,x,f) and Br(c,r+1,e - f)))"}]}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "the axioms mr1 rests on (every route):\nint_discrete   [integer arithmetic] forall n:int: n <= 0 or 1 <= n\nsubgroup_def   [definition] forall S:set: subgroup(S) <-> (0 in S and (forall x y:el: x in S and y in S -> x + y in S) and (forall x:el: x in S -> -x in S))\nexcouple_def   [definition] forall c:cpl: excouple(c) <-> (subgroup(D(c)) and subgroup(E(c)) and (forall x:el: x in D(c) -> i(c,x) in D(c)) and (forall x:el: x in D(c) -> j(c,x) in E(c)) and (forall e:el: e in E(c) -> k(c,e) in D(c)) and (forall x:el: x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)) and (forall x:el: x in D(c) -> j(c,i(c,x)) = 0) and (forall e:el: e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)) and (forall x:el: x in D(c) -> k(c,j(c,x)) = 0) and (forall x:el: x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)) and (forall e:el: e in E(c) -> i(c,k(c,e)) = 0))\nipow_zero      [definition] forall c:cpl, x:el: ipow(c,0,x) = x\nipow_succ      [definition] forall c:cpl, m:int, x:el: 0 <= m -> ipow(c,m+1,x) = i(c,ipow(c,m,x))\nipow_neg       [definition] forall c:cpl, m:int, x:el: m < 0 -> ipow(c,m,x) = 0\nD1_def         [definition] forall c:cpl, x:el: Dr(c,1,x) <-> x in D(c)\nZ1_def         [definition] forall c:cpl, e:el: Zr(c,1,e) <-> e in E(c)\nB1_def         [definition] forall c:cpl, e:el: Br(c,1,e) <-> e = 0\nJ1_def         [definition] forall c:cpl, x e:el: Jr(c,1,x,e) <-> (x in D(c) and e = j(c,x))\nDsucc_def      [definition] forall c:cpl, r:int, y:el: 1 <= r -> (Dr(c,r+1,y) <-> (exists x:el: Dr(c,r,x) and y = i(c,x)))\nZsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Zr(c,r+1,e) <-> (Zr(c,r,e) and exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f)))\nBsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Br(c,r+1,e) <-> (exists e0 f:el: Zr(c,r,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f)))\nJsucc_def      [definition] forall c:cpl, r:int, y e:el: 1 <= r -> (Jr(c,r+1,y,e) <-> (exists x f:el: Dr(c,r,x) and y = i(c,x) and Jr(c,r,x,f) and Br(c,r+1,e - f)))\n"}, "isError": false}}
