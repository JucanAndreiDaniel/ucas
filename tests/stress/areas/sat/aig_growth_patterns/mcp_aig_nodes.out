{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "{\"kind\": \"define\", \"name\": \"m1a\", \"params\": [{\"name\": \"x\", \"type\": \"u16\"}, {\"name\": \"y\", \"type\": \"u16\"}], \"body\": \"x*y & 1\", \"signature\": \"m1a(x: u16, y: u16)\"}"}], "structuredContent": {"id": 1, "ok": true, "cmd": "define", "ucas": "m1a(x: u16, y: u16) = (x*y)&1", "structured": true, "result": {"kind": "define", "name": "m1a", "params": [{"name": "x", "type": "u16"}, {"name": "y", "type": "u16"}], "body": "x*y & 1", "signature": "m1a(x: u16, y: u16)"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": ""}, "isError": false}}
