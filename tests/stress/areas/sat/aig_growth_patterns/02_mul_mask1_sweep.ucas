a16(x:u16,y:u16)=(x*y)&1 xor 0
b16(x:u16,y:u16)=(y*x)&1 xor 0
a32(x:u32,y:u32)=(x*y)&1 xor 0
b32(x:u32,y:u32)=(y*x)&1 xor 0
a48(x:u48,y:u48)=(x*y)&1 xor 0
b48(x:u48,y:u48)=(y*x)&1 xor 0
a64(x:u64,y:u64)=(x*y)&1 xor 0
b64(x:u64,y:u64)=(y*x)&1 xor 0
equiv a16 b16
equiv a32 b32
equiv a48 b48
equiv a64 b64
