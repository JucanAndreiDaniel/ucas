# Equivalence that holds only on a narrowed sub-range (all exhaustive).
a(x: u8 in 0..7) = x*x
b(x: u8 in 0..7) = x*x + (x & 8)
equiv a ~ b
domain a
range a
c(x: u8 in 0..15) = x
d(x: u8 in 0..15) = x + (x & 16)
equiv c ~ d
domain d
e(x: u8) = x*x where x <= 7
f(x: u8) = x*x + (x & 8) where x <= 7
equiv e ~ f
domain e
g(x: u8) = x where x <= 3 || x >= 252
h(x: u8) = x where x <= 3 || x >= 252
equiv g ~ h
range g
i(x: u16 in 0..255) = x + 1
j(x: u16 in 0..255) = (x + 1) & 255
equiv i ~ j
equiv j ~ i
k(x: u8 in 8..15) = x - 8
l(x: u8 in 8..15) = x xor 8
equiv k ~ l
range k
m(x: u8 in 0..15) = x*x
n(x: u8 in 0..15) = x*x + 256
equiv m ~ n
equiv n ~ m
