# where-clause narrowing: conjunctions, disjunctions, explicit sets, bindings.
c1(x: u8) = x*x where x >= 3 && x <= 9
c2(x: u8) = x*x + (x & 16) where x >= 3 && x <= 9
equiv c1 ~ c2
domain c1
range c1
d1(x: u8) = x where x <= 2 || x >= 250
domain d1
range d1
e1(x: u32) = x*x where x in {1, 100000, 4000000000}
domain e1
range e1
f1(x: u8) = x where y = x + 200, y < 210
domain f1
range f1
g1(x: u8) = y*y where y = x & 15
equiv g1 ~ (x & 15)*(x & 15)
range g1
z(x: u8) = x where x < 3 && x > 200
domain z
range z
w(x: u8) = x where x >= 5 && x <= 5
domain w
range w
q(x: u16) = x where x % 3 == 0 && x < 100
domain q
range q
s(x: u8) = x where x == 1 || x == 200 || x == 255
sall(x: u8) = x
equiv s ~ sall
range s
t(x: u8) = x where x < 8 || x >= 8
domain t
range t
