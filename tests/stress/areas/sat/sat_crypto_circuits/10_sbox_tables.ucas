# S-box tables via [] and match, with phash on a small switch.
S = [99, 7, 5, 9, 1, 2, 8, 3]
s1(x: u8 in 0..7) = S[x]
s2(x: u8 in 0..7) = match x { 0 => 99, 1 => 7, 2 => 5, 3 => 9, 4 => 1, 5 => 2, 6 => 8, 7 => 3, _ => 0 }
equiv s1 s2
range s1
phash s2
s3(x: u8 in 0..2) = [10,20,30][x]
domain s3
range s3
oob(x: u8 in 0..5) = [10,20,30][x]
domain oob
