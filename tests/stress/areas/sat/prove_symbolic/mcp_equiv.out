{"jsonrpc": "2.0", "id": 0, "result": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {"listChanged": false}, "resources": {}, "prompts": {}}, "serverInfo": {"name": "ucas", "title": "ucas, a computer algebra system for programmers", "version": "1"}, "instructions": "ucas analyses functions (exhaustively on machine types), does exact algebra and calculus, transforms, number theory and finite fields, and finds cheaper implementations, each answer checked or proved.  Expressions are ucas syntax strings; give parameters types (x: u8, x: f32, x: real) where it matters.  Definitions persist across calls.  An ambiguous input is an error listing its readings: retry with args.assume.KEY.  structuredContent holds the typed result, checks and proof."}}
{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "error (parse_error): expected an expression\n\n<json>:1:22: error: expected an expression\n    equiv (x*y)^5 (y*x)^5\n                         ^\n"}], "structuredContent": {"id": 1, "ok": false, "cmd": "equiv", "ucas": "equiv (x*y)^5 (y*x)^5", "structured": false, "notes": [], "conditions": [], "checks": [], "files": [], "text": "<json>:1:22: error: expected an expression\n    equiv (x*y)^5 (y*x)^5\n                         ^\n", "error": {"code": "parse_error", "message": "expected an expression", "pos": {"line": 1, "col": 22}}}, "isError": true}}
{"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "{\"kind\": \"define\", \"name\": \"f8\", \"params\": [{\"name\": \"x\", \"type\": \"i8\"}, {\"name\": \"y\", \"type\": \"i8\"}], \"body\": \"(x + y)^2\", \"signature\": \"f8(x: i8, y: i8)\"}"}], "structuredContent": {"id": 2, "ok": true, "cmd": "define", "ucas": "f8(x: i8, y: i8) = (x+y)^2", "structured": true, "result": {"kind": "define", "name": "f8", "params": [{"name": "x", "type": "i8"}, {"name": "y", "type": "i8"}], "body": "(x + y)^2", "signature": "f8(x: i8, y: i8)"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": ""}, "isError": false}}
{"jsonrpc": "2.0", "id": 3, "result": {"content": [{"type": "text", "text": "{\"kind\": \"define\", \"name\": \"g8\", \"params\": [{\"name\": \"x\", \"type\": \"i8\"}, {\"name\": \"y\", \"type\": \"i8\"}], \"body\": \"x^2 + 2x*y + y^2\", \"signature\": \"g8(x: i8, y: i8)\"}"}], "structuredContent": {"id": 3, "ok": true, "cmd": "define", "ucas": "g8(x: i8, y: i8) = x^2 + 2*x*y + y^2", "structured": true, "result": {"kind": "define", "name": "g8", "params": [{"name": "x", "type": "i8"}, {"name": "y", "type": "i8"}], "body": "x^2 + 2x*y + y^2", "signature": "g8(x: i8, y: i8)"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": ""}, "isError": false}}
{"jsonrpc": "2.0", "id": 4, "result": {"content": [{"type": "text", "text": "f8 and g8 are equal on the domain of f8 (exhaustive)\n"}], "structuredContent": {"id": 4, "ok": true, "cmd": "equiv", "ucas": "equiv f8 g8", "structured": true, "result": {"kind": "equiv", "equal": true, "exhaustive": true, "mismatch_points": 0, "method": "exhaustive"}, "notes": [], "conditions": [], "checks": [], "proof": {"kind": "exhaustive", "text": "every point of the domain"}, "files": [], "text": "f8 and g8 are equal on the domain of f8 (exhaustive)\n"}, "isError": false}}
{"jsonrpc": "2.0", "id": 5, "result": {"content": [{"type": "text", "text": "{\"kind\": \"define\", \"name\": \"fr\", \"params\": [{\"name\": \"x\", \"type\": \"real\"}, {\"name\": \"y\", \"type\": \"real\"}], \"body\": \"(x + y)^2\", \"signature\": \"fr(x: real, y: real)\"}"}], "structuredContent": {"id": 5, "ok": true, "cmd": "define", "ucas": "fr(x: real, y: real) = (x+y)^2", "structured": true, "result": {"kind": "define", "name": "fr", "params": [{"name": "x", "type": "real"}, {"name": "y", "type": "real"}], "body": "(x + y)^2", "signature": "fr(x: real, y: real)"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": ""}, "isError": false}}
{"jsonrpc": "2.0", "id": 6, "result": {"content": [{"type": "text", "text": "{\"kind\": \"define\", \"name\": \"gr\", \"params\": [{\"name\": \"x\", \"type\": \"real\"}, {\"name\": \"y\", \"type\": \"real\"}], \"body\": \"x^2 + 2x*y + y^2\", \"signature\": \"gr(x: real, y: real)\"}"}], "structuredContent": {"id": 6, "ok": true, "cmd": "define", "ucas": "gr(x: real, y: real) = x^2 + 2*x*y + y^2", "structured": true, "result": {"kind": "define", "name": "gr", "params": [{"name": "x", "type": "real"}, {"name": "y", "type": "real"}], "body": "x^2 + 2x*y + y^2", "signature": "gr(x: real, y: real)"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": ""}, "isError": false}}
