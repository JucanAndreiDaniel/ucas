# TRUE linear-arithmetic theorems, all expected to be proved automatically
theorem t01: forall x:int: x + 1 > x
prove t01
theorem t02: forall x y:int: x + y = y + x
prove t02
theorem t03: forall x:int: 2*x = x + x
prove t03
theorem t04: forall x y z:int: (x + y) + z = x + (y + z)
prove t04
theorem t05: forall x:int: x <= x + 1
prove t05
theorem t06: forall x y:int: x <= y and y <= x -> x = y
prove t06
theorem t07: forall x y:int: 2*x + 3*y <= 3*x + 2*y -> y <= x
prove t07
theorem t08: forall x y:int: x <= y -> 2*x <= 2*y
prove t08
theorem t09: forall x:int: x > 5 -> x > 3
prove t09
theorem t10: forall x:int: not (x < x)
prove t10
theorem t11: forall x:int: 3 <= x and x <= 1 -> false
prove t11
theorem t12: forall x y z:int: x + y = x + z -> y = z
prove t12
