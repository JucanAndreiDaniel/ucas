# equalities in the abelian-group sort el (Z-module linear arithmetic)
theorem g01: forall x y:el: x + y = y + x
prove g01
theorem g02: forall x y:el: x - y = -(y - x)
prove g02
theorem g03: forall x:el: x + 0 = x
prove g03
theorem g04: forall x y z:el: (x + y) + z = x + (y + z)
prove g04
theorem g05: forall x y:el: 2*(x + y) - x = x + 2*y
prove g05
theorem g06: forall x:el: 3*x - x = 2*x
prove g06
theorem gf1: forall x y:el: x + y = x
prove gf1
theorem gf2: forall x y:el: x - y = y - x
prove gf2
theorem gf3: forall x:el: x + x = x
prove gf3
theorem gf4: forall x y:el: x - y = x + y
prove gf4
