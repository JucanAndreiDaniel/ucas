# FALSE claims; each must be rejected, ideally with a counterexample
theorem f01: forall x:int: x + 1 <= x
prove f01
theorem f02: forall x:int: x*x = x
prove f02
theorem f03: forall x y:int: x + y = x*y
prove f03
theorem f04: forall x:int: x < x
prove f04
theorem f05: forall x:int: x > x + 1
prove f05
theorem f06: forall x:int: x >= 0
prove f06
theorem f07: forall x:int: x*x = 1 -> x = 1
prove f07
theorem f08: forall x:int: x <= 1 -> x = 1
prove f08
theorem f09: forall a b:int: 0 <= a and 0 <= b -> 0 < a*b
prove f09
theorem f10: forall x y:int: x + y = x - y
prove f10
theorem f11: forall x:int: 2*x = 3*x
prove f11
theorem f12: forall x:int: x <= x - 1
prove f12
