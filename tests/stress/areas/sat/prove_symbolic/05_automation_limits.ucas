# TRUE claims that the automation cannot prove (linear-only, no existentials)
theorem l01: forall x:int: 0 <= x*x
prove l01
theorem l02: forall a:int: a*a >= a
prove l02
theorem l03: forall a b:int: 0 <= a and 0 <= b -> 0 <= a*a + b*b
prove l03
theorem l04: forall a:int: a >= 0 -> a*a >= 0
prove l04
theorem l05: forall n:int: n <= 0 or 1 <= n
prove l05
theorem l06: forall x:int: exists y:int: y = x + 1
prove l06
theorem l07: forall x:int: (exists k:int: x = 2*k) or (exists k:int: x = 2*k + 1)
prove l07
theorem l08: forall x:int: exists k:int: x*(x+1) = 2*k
prove l08
theorem l09: forall a b:int: a*a + b*b = 0 -> a = 0 and b = 0
prove l09
theorem l10: forall x:int: (x+1)^10 - (x-1)^10 >= 0
prove l10
