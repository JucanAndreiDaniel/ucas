# Bulk soundness sweep: 120 generated linear-arithmetic theorems (60+ false, some true).
# Ground truth computed by brute force; none may be wrongly PROVED.
# fuzzed linear arithmetic theorems
# expected FALSE: forall x y:int: 2*y - 3 <= 3*x + 3*y + 3 -> -x + 3*y - 1 <= -2*x - y + 1
theorem fz0: forall x y:int: 2*y - 3 <= 3*x + 3*y + 3 -> -x + 3*y - 1 <= -2*x - y + 1
prove fz0
