{"jsonrpc": "2.0", "id": 4, "result": {"content": [{"type": "text", "text": "symmetry of (x + y)^2 - (x^2 + 2x*y + y^2):\n  f(x, y) = f(y, x): yes (symmetric)\n  f(x, y) = -f(y, x): yes (antisymmetric)\n  checked numerically at 400 random points of [-10, 10]^2\n"}], "structuredContent": {"id": 4, "ok": true, "cmd": "symmetry", "ucas": "symmetry (x+y)^2 - (x^2 + 2*x*y + y^2)", "structured": true, "result": {"kind": "symmetry", "f(x, y)": ["f(y, x): yes (symmetric)", "-f(y, x): yes (antisymmetric)"], "headline": "symmetry of (x + y)^2 - (x^2 + 2x*y + y^2):", "details": ["checked numerically at 400 random points of [-10, 10]^2"]}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "symmetry of (x + y)^2 - (x^2 + 2x*y + y^2):\n  f(x, y) = f(y, x): yes (symmetric)\n  f(x, y) = -f(y, x): yes (antisymmetric)\n  checked numerically at 400 random points of [-10, 10]^2\n"}, "isError": false}}
