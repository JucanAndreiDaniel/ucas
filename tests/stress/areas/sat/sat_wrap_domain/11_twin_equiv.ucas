# uN/iN vs int/real twin comparisons with equiv.
t1(x: u8) = x + 1
t2(x: u8) = x + 2
equiv t1 t2
u1(x: u8) = (x + 1) - 1
u2(x: u8) = x
equiv u1 u2
s1(x: i8) = -x
s2(x: i8) = 0 - x
equiv s1 s2
s3(x: i8) = x * 3
s4(x: i8) = 3 * x
equiv s3 s4
w1(x: u16) = (x << 3) - (x << 2)
w2(x: u16) = x << 2
equiv w1 w2
w3(x: i16) = (x*2)/2
w4(x: i16) = x
equiv w3 w4
d1(x: u8) = 100 / (x + 1)
d2(x: u8) = 100 / (1 + x)
equiv d1 d2
r1(x: real) = x*x
r2(x: real) = x^2
equiv r1 r2
