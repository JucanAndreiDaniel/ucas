# int-to-float precision loss; u64->f64 shows a bogus relative error (FINDINGS.md).
p1(x: i64) = f32(x)
wrap p1
range p1
p2(x: u64) = f64(x)
wrap p2
p3(x: i32) = f32(x)
wrap p3
p4(x: u8) = f32(x)
wrap p4
p5(x: i64) = f64(x)
wrap p5
p6(x: u64) = f32(x)
wrap p6
p7(x: i8) = f16(x)
wrap p7
p8(x: i32 in 0..1000) = f32(x)
wrap p8
