# Division by zero and variable-denominator domains.
d8(x: i8) = 100 / x
domain d8
range d8
du8(x: u8) = 100 / x
domain du8
range du8
dvar(x: i8) = x / (x - 5)
domain dvar
d16(x: i16) = 32767 / x
domain d16
mod0(x: u8) = x % 0
domain mod0
mvar(x: i8, y: i8) = x % y
domain mvar
dshift(x: u8, n: u8 in 0..3) = x / (n + 1)
domain dshift
range dshift
dchain(x: i8) = 100 / (x / (x - 10))
domain dchain
