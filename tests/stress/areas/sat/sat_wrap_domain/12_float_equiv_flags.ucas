# Float equiv under ftz / noftz / nanbits and float round-trip proofs.
f1(x: f32) = x + 1
f2(x: f32) = 1 + x
equiv f1 f2
equiv f1 f2 ftz
equiv f1 f2 nanbits
m1(x: f32) = -(-asfloat(asuint(x)))
m2(x: f32) = asfloat(asuint(x))
equiv m1 m2 nanbits
l2a(x: f32, y: f32) = x * y
l2b(x: f32, y: f32) = f32(f64(x) * f64(y))
equiv l2a l2b
u1(x: f16, y: f16) = x + y
u2(x: f16, y: f16) = x == f16(1) && y == f16(2^(-10)) ? x : x + y
equiv u1 u2
q1(x: u32) = asfloat(x | 0x7fc00000)
q2(x: u32) = asfloat(u32(0x7fc00000))
equiv q1 q2
equiv q1 q2 nanbits
