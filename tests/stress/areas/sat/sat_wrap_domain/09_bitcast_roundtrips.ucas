# asuint / asint / asfloat round-trips and NaN payload movement.
rt1(x: f32) = asfloat(asuint(x))
idf(x: f32) = x
equiv rt1 idf
rt2(x: f32) = asfloat(asint(x))
wrap rt2
rt3(x: u32) = asuint(asfloat(x))
wrap rt3
rt4(x: f32) = asuint(asfloat(asint(x)))
wrap rt4
nn(x: f32) = -(-x)
wrap nn
ab(x: f32) = abs(x)
ab2(x: f32) = x < 0 ? -x : x
equiv ab ab2 ftz
q1(x: u32) = asfloat(x | 0x7fc00000)
q2(x: u32) = asfloat(0x7fc00000)
equiv q1 q2
equiv q1 q2 nanbits
