# Shifts of negative signed values and shift-amount domains.
shneg(x: i8 in -128..-1) = -x << 1
wrap shneg
shr(x: i8) = x >> 1
wrap shr
range shr
shl7(x: i8) = x << 7
wrap shl7
shvar(x: i8, n: i8 in -2..9) = x << n
domain shvar
wrap shvar
shvaru(x: i8, n: u8 in 0..8) = x >> n
domain shvaru
shnegamount(x: i8) = x << -1
domain shnegamount
shlarge(x: i8) = x << 100
domain shlarge
shu8(x: u8, n: u8 in 0..8) = x << n
domain shu8
wrap shu8
