# i8 add/sub/mul/negate at the boundaries; exhaustive over 256 points.
add37(x: i8) = x + 37
wrap add37
sub71(x: i8) = x - 71
wrap sub71
rsub100(x: i8) = 100 - x
wrap rsub100
mul3(x: i8) = x * 3
wrap mul3
mul13(x: i8) = x * 13
wrap mul13
neg(x: i8) = -x
wrap neg
neg128(x: i8 in -128..-127) = -x
wrap neg128
divmin(x: i8 in -128..-1) = x / -1
wrap divmin
domain divmin
dblhalve(x: i8) = (x*2)/2
wrap dblhalve
range dblhalve
disjoint(x: i8) = (x-123)*(x-100)
wrap disjoint
absplus(x: i8) = (x < 0 ? -x : x) + 100
wrap absplus
