# i16/i32 add/sub/mul/negate at boundaries (i16 exhaustive, i32 sampled).
a16(x: i16) = x + 32767
wrap a16
s16(x: i16) = x - 32768
wrap s16
m16(x: i16) = x * 7
wrap m16
n16(x: i16) = -x
wrap n16
h16(x: i16) = (x*2)/2
wrap h16
range h16
a32(x: i32) = x + 2147483647
wrap a32
s32(x: i32) = x - 2147483647
wrap s32
m32(x: i32) = x * 3
wrap m32
n32(x: i32) = -x
wrap n32
h32(x: i32) = (x*2)/2
wrap h32
range h32
u32m(x: u32) = x * 4294967295
wrap u32m
