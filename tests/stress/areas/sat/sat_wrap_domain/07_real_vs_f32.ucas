# real (undefined) vs f32/f16/f64 (IEEE total) for sqrt(-1), 1/0, log(0).
sqrtreal(x: real) = sqrt(x)
domain sqrtreal
range sqrtreal
sqrt32(x: f32) = sqrt(x)
domain sqrt32
wrap sqrt32
sqrt16(x: f16) = sqrt(x)
wrap sqrt16
sqrt64(x: f64) = sqrt(x)
wrap sqrt64
divreal(x: real) = 1/x
domain divreal
div32(x: f32) = 1/x
domain div32
wrap div32
logreal(x: real) = log(x)
domain logreal
log32(x: f32) = log(x)
wrap log32
divzero(x: real) = 1/0
domain divzero
sqrtm1(x: real) = sqrt(-1)
domain sqrtm1
