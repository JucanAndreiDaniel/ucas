> f0(x: u8) = x+1
> f1(x: u8) = f0(f0(x))
> f2(x: u8) = f1(f1(x))
> f3(x: u8) = f2(f2(x))
> f4(x: u8) = f3(f3(x))
> f5(x: u8) = f4(f4(x))
> f6(x: u8) = f5(f5(x))
> f7(x: u8) = f6(f6(x))
> f8(x: u8) = f7(f7(x))
> g0(x: real) = x+1
> g1(x: real) = g0(g0(x))
> g2(x: real) = g1(g1(x))
> g3(x: real) = g2(g2(x))
> g4(x: real) = g3(g3(x))
> g5(x: real) = g4(g4(x))
> g6(x: real) = g5(g5(x))
> g7(x: real) = g6(g6(x))
> g8(x: real) = g7(g7(x))
