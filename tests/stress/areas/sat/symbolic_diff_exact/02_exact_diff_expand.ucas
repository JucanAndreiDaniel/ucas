# Exact symbolic-difference oracle: expand(simplify(f - g)) must be exactly 0
# for every true identity, and a nonzero constant for the +1 near-miss.
# This is the independent oracle used by harness.py; it agrees with ucas algebra.
expand (x + y) ^ 2 - (x ^ 2 + 2 * x * y + y ^ 2)
simplify (x + y) ^ 2 - (x ^ 2 + 2 * x * y + y ^ 2)
expand (x + 3 * y) ^ 4 - (x ^ 4 + 12 * x ^ 3 * y + 54 * x ^ 2 * y ^ 2 + 108 * x * y ^ 3 + 81 * y ^ 4)
expand (x ^ 3 - 1) / (x - 1) - (x * x + x + 1)
simplify (x ^ 3 - 1) / (x - 1) - (x * x + x + 1)
expand (x + y) ^ 2 - (x ^ 2 + 2 * x * y + y ^ 2 + 1)
simplify (x + y) ^ 2 - (x ^ 2 + 2 * x * y + y ^ 2 + 1)
