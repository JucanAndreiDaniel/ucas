{"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "range of it -> u32:\n  0..32  (sampled min/max; not a sound bound)\n  fits in u6\n  sampled 65536 points (domain has 4294967296 points); not exhaustive\n  sound bound (intervals): 0..32\n"}], "structuredContent": {"id": 2, "ok": true, "cmd": "range", "ucas": "it(x: u32) = popcount(x)\nrange it", "structured": true, "result": {"kind": "range", "type": "u32", "empty": false, "exhaustive": false, "points": 65536, "undefined_points": 0, "min": {"value": 0, "exact": "0"}, "max": {"value": 32, "exact": "32"}, "fits": "u6", "sound_bound": [0, 32]}, "notes": [], "conditions": [], "checks": [], "proof": {"kind": "numeric", "text": "a sample of the domain"}, "files": [], "text": "range of it -> u32:\n  0..32  (sampled min/max; not a sound bound)\n  fits in u6\n  sampled 65536 points (domain has 4294967296 points); not exhaustive\n  sound bound (intervals): 0..32\n"}, "isError": false}}
