# Variable shifts: narrow-range (provable) and full-domain variants.
s1(x: u16, n: u16 in 0..15) = x << n
wrap s1
range s1
s2(x: u16, n: u16 in 0..15) = x >> n
wrap s2
range s2
s3(x: u32, n: u32 in 0..31) = x << n
wrap s3
range s3
s4(x: u32, n: u32 in 0..31) = x >> n
wrap s4
s5(x: u16, n: u16) = x << n
domain s5
wrap s5
range s5
