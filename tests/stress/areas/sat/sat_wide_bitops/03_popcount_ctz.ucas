# popcount / clz / ctz and bit-serial identities.
pc(x: u16) = popcount(x)
pbits(x: u16) = (x&1)+((x>>1)&1)+((x>>2)&1)+((x>>3)&1)+((x>>4)&1)+((x>>5)&1)+((x>>6)&1)+((x>>7)&1)+((x>>8)&1)+((x>>9)&1)+((x>>10)&1)+((x>>11)&1)+((x>>12)&1)+((x>>13)&1)+((x>>14)&1)+((x>>15)&1)
equiv pc pbits
range pc
clz16(x: u16) = clz(x)
range clz16
domain clz16
ctz16(x: u16) = ctz(x)
range ctz16
domain ctz16
