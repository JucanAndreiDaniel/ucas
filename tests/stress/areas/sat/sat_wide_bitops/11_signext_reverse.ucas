# Sign extension and manual bit reversal.
sx(i: i8) = i
wrap sx
sext(x: u32) = i64(i32(x))
wrap sext
signext(x: u16) = (x xor 32768) - 32768
wrap signext
rev4(x: u4) = ((x&1)<<3)|((x&2)<<1)|((x&4)>>1)|((x&8)>>3)
rev4b(x: u4) = ((x&8)>>3)|((x&4)>>1)|((x&2)<<1)|((x&1)<<3)
equiv rev4 rev4b
range rev4
maskchain(x: u32) = ((x & 0xff) + 1) & 0xff
wrap maskchain
range maskchain
