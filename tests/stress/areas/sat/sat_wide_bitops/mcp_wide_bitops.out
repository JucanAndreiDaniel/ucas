{"jsonrpc": "2.0", "id": 23, "result": {"content": [{"type": "text", "text": "it and that are equal on the domain of it (proved by SAT: 1192 AIG nodes, 0 conflicts)\n"}, {"type": "resource", "resource": {"uri": "ucas://file/bvproof.cert", "mimeType": "text/plain", "blob": ""}}], "structuredContent": {"id": 23, "ok": true, "cmd": "equiv", "ucas": "it(x: u32, n: u32 in 1..31) = (x << n) | (x >> (32 - n))\nthat(x: u32, n: u32 in 1..31) = (x >> (32 - n)) | (x << n)\nequiv it that", "structured": true, "result": {"kind": "equiv", "equal": true, "exhaustive": false, "mismatch_points": 0, "method": "sat", "sat": {"result": "proved", "aig_nodes": 1192, "conflicts": 0}}, "notes": [], "conditions": [], "checks": [{"kind": "drup_refutation", "points": 0, "passed": false, "text": "each learned clause rechecked by unit propagation, ending in the empty clause"}, {"kind": "aig_miter", "points": 1192, "passed": true, "text": "trivial false goal"}], "proof": {"kind": "sat", "text": "proved by SAT: 1192 AIG nodes, 0 conflicts"}, "files": [{"name": "bvproof.cert", "mime": "text/plain", "bytes": 17469}], "text": "it and that are equal on the domain of it (proved by SAT: 1192 AIG nodes, 0 conflicts)\n"}, "isError": false}}
{"jsonrpc": "2.0", "id": 24, "result": {"content": [{"type": "text", "text": "it and that are equal on the domain of it (proved by algebra: both sides expand to one polynomial in x, y mod 2^32)\n"}], "structuredContent": {"id": 24, "ok": true, "cmd": "equiv", "ucas": "it(x: u32, y: u32) = (x+y)*(x-y)\nthat(x: u32, y: u32) = x*x-y*y\nequiv it that", "structured": true, "result": {"kind": "equiv", "equal": true, "exhaustive": false, "mismatch_points": 0, "method": "algebra"}, "notes": [], "conditions": [], "checks": [], "proof": {"kind": "derivation", "text": "proved by algebra: both sides expand to one polynomial in x, y mod 2^32"}, "files": [], "text": "it and that are equal on the domain of it (proved by algebra: both sides expand to one polynomial in x, y mod 2^32)\n"}, "isError": false}}
