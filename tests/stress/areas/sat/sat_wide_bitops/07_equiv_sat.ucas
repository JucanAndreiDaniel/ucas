# Equivalences proved by exhaustive search, algebra and SAT.
sw1(x: u32) = x xor (x >> 16) xor (x >> 8) xor (x >> 4) xor (x >> 2) xor (x >> 1)
sw2(x: u32) = ((x xor (x >> 16)) xor (x >> 8)) xor ((x >> 4) xor (x >> 2)) xor (x >> 1)
equiv sw1 sw2
r1(x: u32, n: u32 in 1..31) = (x << n) | (x >> (32 - n))
r2(x: u32, n: u32 in 1..31) = (x >> (32 - n)) | (x << n)
equiv r1 r2
fp(x: u32, y: u32) = (x + y) * (x - y)
gq(x: u32, y: u32) = x*x - y*y
equiv fp gq
