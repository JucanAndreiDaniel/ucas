# OpFuzz type-aware operator mutation: 03_xor_mut
# 9 seeds, each mutated by one same-signature operator swap.
# u8 -> exhaustive ground truth; u32 -> sat/algebra proof on wide type.
# --- xorplus_basic [xorplus] identity=False: x xor y  <->  x + y ---
s_xorplus_basic_u8(x: u8, y: u8) = x xor y
m_xorplus_basic_u8(x: u8, y: u8) = x + y
equiv s_xorplus_basic_u8 m_xorplus_basic_u8
s_xorplus_basic_u32(x: u32, y: u32) = x xor y
m_xorplus_basic_u32(x: u32, y: u32) = x + y
equiv s_xorplus_basic_u32 m_xorplus_basic_u32
# --- xor_self [xorplus] identity=False: x xor x  <->  x + x ---
s_xor_self_u8(x: u8) = x xor x
m_xor_self_u8(x: u8) = x + x
equiv s_xor_self_u8 m_xor_self_u8
s_xor_self_u32(x: u32) = x xor x
m_xor_self_u32(x: u32) = x + x
equiv s_xor_self_u32 m_xor_self_u32
# --- xor_zero [xorplus] identity=True: x xor 0  <->  x + 0 ---
s_xor_zero_u8(x: u8) = x xor 0
m_xor_zero_u8(x: u8) = x + 0
equiv s_xor_zero_u8 m_xor_zero_u8
s_xor_zero_u32(x: u32) = x xor 0
m_xor_zero_u32(x: u32) = x + 0
equiv s_xor_zero_u32 m_xor_zero_u32
# --- xor_cancel [xorplus] identity=True: (x xor 7) xor 7  <->  x ---
s_xor_cancel_u8(x: u8) = (x xor 7) xor 7
m_xor_cancel_u8(x: u8) = x
equiv s_xor_cancel_u8 m_xor_cancel_u8
s_xor_cancel_u32(x: u32) = (x xor 7) xor 7
m_xor_cancel_u32(x: u32) = x
equiv s_xor_cancel_u32 m_xor_cancel_u32
# --- carry_save [xorplus] identity=True: (x & y) + (x xor y)  <->  x | y ---
s_carry_save_u8(x: u8, y: u8) = (x & y) + (x xor y)
m_carry_save_u8(x: u8, y: u8) = x | y
equiv s_carry_save_u8 m_carry_save_u8
s_carry_save_u32(x: u32, y: u32) = (x & y) + (x xor y)
m_carry_save_u32(x: u32, y: u32) = x | y
equiv s_carry_save_u32 m_carry_save_u32
# --- carry_save_bad [xorplus] identity=False: (x & y) + (x xor y)  <->  x xor y ---
s_carry_save_bad_u8(x: u8, y: u8) = (x & y) + (x xor y)
m_carry_save_bad_u8(x: u8, y: u8) = x xor y
equiv s_carry_save_bad_u8 m_carry_save_bad_u8
s_carry_save_bad_u32(x: u32, y: u32) = (x & y) + (x xor y)
m_carry_save_bad_u32(x: u32, y: u32) = x xor y
equiv s_carry_save_bad_u32 m_carry_save_bad_u32
# --- xor_assoc [xorplus] identity=True: (x xor y) xor z  <->  x xor (y xor z) ---
s_xor_assoc_u8(x: u8, y: u8, z: u8) = (x xor y) xor z
m_xor_assoc_u8(x: u8, y: u8, z: u8) = x xor (y xor z)
equiv s_xor_assoc_u8 m_xor_assoc_u8
s_xor_assoc_u32(x: u32, y: u32, z: u32) = (x xor y) xor z
m_xor_assoc_u32(x: u32, y: u32, z: u32) = x xor (y xor z)
equiv s_xor_assoc_u32 m_xor_assoc_u32
# --- xor_comm [xorplus] identity=True: x xor y  <->  y xor x ---
s_xor_comm_u8(x: u8, y: u8) = x xor y
m_xor_comm_u8(x: u8, y: u8) = y xor x
equiv s_xor_comm_u8 m_xor_comm_u8
s_xor_comm_u32(x: u32, y: u32) = x xor y
m_xor_comm_u32(x: u32, y: u32) = y xor x
equiv s_xor_comm_u32 m_xor_comm_u32
# --- xor_of_self [xorplus] identity=True: x xor x  <->  0 ---
s_xor_of_self_u8(x: u8) = x xor x
m_xor_of_self_u8(x: u8) = 0
equiv s_xor_of_self_u8 m_xor_of_self_u8
s_xor_of_self_u32(x: u32) = x xor x
m_xor_of_self_u32(x: u32) = 0
equiv s_xor_of_self_u32 m_xor_of_self_u32
