# OpFuzz type-aware operator mutation: 01_addsub_mut
# 11 seeds, each mutated by one same-signature operator swap.
# u8 -> exhaustive ground truth; u32 -> sat/algebra proof on wide type.
# --- add_basic [addsub] identity=False: x + y  <->  x - y ---
s_add_basic_u8(x: u8, y: u8) = x + y
m_add_basic_u8(x: u8, y: u8) = x - y
equiv s_add_basic_u8 m_add_basic_u8
s_add_basic_u32(x: u32, y: u32) = x + y
m_add_basic_u32(x: u32, y: u32) = x - y
equiv s_add_basic_u32 m_add_basic_u32
# --- add_zero [addsub] identity=True: x + 0  <->  x - 0 ---
s_add_zero_u8(x: u8, y: u8) = x + 0
m_add_zero_u8(x: u8, y: u8) = x - 0
equiv s_add_zero_u8 m_add_zero_u8
s_add_zero_u32(x: u32, y: u32) = x + 0
m_add_zero_u32(x: u32, y: u32) = x - 0
equiv s_add_zero_u32 m_add_zero_u32
# --- diffsq [addsub] identity=True: (x + y)*(x - y)  <->  x*x - y*y ---
s_diffsq_u8(x: u8, y: u8) = (x + y)*(x - y)
m_diffsq_u8(x: u8, y: u8) = x*x - y*y
equiv s_diffsq_u8 m_diffsq_u8
s_diffsq_u32(x: u32, y: u32) = (x + y)*(x - y)
m_diffsq_u32(x: u32, y: u32) = x*x - y*y
equiv s_diffsq_u32 m_diffsq_u32
# --- diffsq_bad [addsub] identity=False: (x + y)*(x - y)  <->  x*x + y*y ---
s_diffsq_bad_u8(x: u8, y: u8) = (x + y)*(x - y)
m_diffsq_bad_u8(x: u8, y: u8) = x*x + y*y
equiv s_diffsq_bad_u8 m_diffsq_bad_u8
s_diffsq_bad_u32(x: u32, y: u32) = (x + y)*(x - y)
m_diffsq_bad_u32(x: u32, y: u32) = x*x + y*y
equiv s_diffsq_bad_u32 m_diffsq_bad_u32
# --- add_assoc [addsub] identity=True: (x + y) + z  <->  x + (y + z) ---
s_add_assoc_u8(x: u8, y: u8, z: u8) = (x + y) + z
m_add_assoc_u8(x: u8, y: u8, z: u8) = x + (y + z)
equiv s_add_assoc_u8 m_add_assoc_u8
s_add_assoc_u32(x: u32, y: u32, z: u32) = (x + y) + z
m_add_assoc_u32(x: u32, y: u32, z: u32) = x + (y + z)
equiv s_add_assoc_u32 m_add_assoc_u32
# --- add_comm [addsub] identity=True: x + y  <->  y + x ---
s_add_comm_u8(x: u8, y: u8) = x + y
m_add_comm_u8(x: u8, y: u8) = y + x
equiv s_add_comm_u8 m_add_comm_u8
s_add_comm_u32(x: u32, y: u32) = x + y
m_add_comm_u32(x: u32, y: u32) = y + x
equiv s_add_comm_u32 m_add_comm_u32
# --- sub_neg [addsub] identity=True: x - y  <->  x + (0 - y) ---
s_sub_neg_u8(x: u8, y: u8) = x - y
m_sub_neg_u8(x: u8, y: u8) = x + (0 - y)
equiv s_sub_neg_u8 m_sub_neg_u8
s_sub_neg_u32(x: u32, y: u32) = x - y
m_sub_neg_u32(x: u32, y: u32) = x + (0 - y)
equiv s_sub_neg_u32 m_sub_neg_u32
# --- twice_plus [addsub] identity=True: x + x  <->  2*x ---
s_twice_plus_u8(x: u8) = x + x
m_twice_plus_u8(x: u8) = 2*x
equiv s_twice_plus_u8 m_twice_plus_u8
s_twice_plus_u32(x: u32) = x + x
m_twice_plus_u32(x: u32) = 2*x
equiv s_twice_plus_u32 m_twice_plus_u32
# --- inc_dec [addsub] identity=False: x + 1  <->  x - 1 ---
s_inc_dec_u8(x: u8) = x + 1
m_inc_dec_u8(x: u8) = x - 1
equiv s_inc_dec_u8 m_inc_dec_u8
s_inc_dec_u32(x: u32) = x + 1
m_inc_dec_u32(x: u32) = x - 1
equiv s_inc_dec_u32 m_inc_dec_u32
# --- sum_const [addsub] identity=False: x + y + 7  <->  x - y + 7 ---
s_sum_const_u8(x: u8, y: u8) = x + y + 7
m_sum_const_u8(x: u8, y: u8) = x - y + 7
equiv s_sum_const_u8 m_sum_const_u8
s_sum_const_u32(x: u32, y: u32) = x + y + 7
m_sum_const_u32(x: u32, y: u32) = x - y + 7
equiv s_sum_const_u32 m_sum_const_u32
# --- add_cancel [addsub] identity=True: x + (y - y)  <->  x ---
s_add_cancel_u8(x: u8, y: u8) = x + (y - y)
m_add_cancel_u8(x: u8, y: u8) = x
equiv s_add_cancel_u8 m_add_cancel_u8
s_add_cancel_u32(x: u32, y: u32) = x + (y - y)
m_add_cancel_u32(x: u32, y: u32) = x
equiv s_add_cancel_u32 m_add_cancel_u32
