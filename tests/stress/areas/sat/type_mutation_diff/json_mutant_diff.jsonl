{"id": 1, "cmd": "equiv", "args": {"f": {"body": "x + y", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}, "g": {"body": "x - y", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}}}
{"id": 2, "cmd": "equiv", "args": {"f": {"body": "(x + y)*(x - y)", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}, "g": {"body": "x*x - y*y", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}}}
{"id": 3, "cmd": "equiv", "args": {"f": {"body": "x & y", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}, "g": {"body": "x | y", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}}}
{"id": 4, "cmd": "equiv", "args": {"f": {"body": "~(x & y)", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}, "g": {"body": "~x | ~y", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}}}
{"id": 5, "cmd": "equiv", "args": {"f": {"body": "(x & y) + (x xor y)", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}, "g": {"body": "x | y", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}}}
{"id": 6, "cmd": "equiv", "args": {"f": {"body": "x < y", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}, "g": {"body": "x <= y", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}}}
{"id": 7, "cmd": "equiv", "args": {"f": {"body": "x*(y + z)", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}, {"name": "z", "type": "u8"}]}, "g": {"body": "x*y + x*z", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}, {"name": "z", "type": "u8"}]}}}
{"id": 8, "cmd": "equiv", "args": {"f": {"body": "x << 1", "params": [{"name": "x", "type": "u32"}]}, "g": {"body": "x + x", "params": [{"name": "x", "type": "u32"}]}}}
{"id": 9, "cmd": "equiv", "args": {"f": {"body": "min(x, y) + max(x, y)", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}, "g": {"body": "x + y", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}}}
{"id": 10, "cmd": "equiv", "args": {"f": {"body": "min(x, y)", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}, "g": {"body": "max(x, y)", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}}}
{"id": 11, "cmd": "equiv", "args": {"f": {"body": "x xor 0", "params": [{"name": "x", "type": "u8"}]}, "g": {"body": "x + 0", "params": [{"name": "x", "type": "u8"}]}}}
{"id": 12, "cmd": "equiv", "args": {"f": {"body": "x & (x | y)", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}, "g": {"body": "x", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}}}
{"id": 13, "cmd": "equiv", "args": {"f": {"body": "x * y", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}, "g": {"body": "y * x", "params": [{"name": "x", "type": "u8"}, {"name": "y", "type": "u8"}]}}}
{"id": 14, "cmd": "equiv", "args": {"f": {"body": "!(x < y)", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}, "g": {"body": "x >= y", "params": [{"name": "x", "type": "u32"}, {"name": "y", "type": "u32"}]}}}
{"id": 15, "cmd": "equiv", "args": {"f": {"body": "x << 1", "params": [{"name": "x", "type": "u8"}]}, "g": {"body": "x + x", "params": [{"name": "x", "type": "u8"}]}}}
