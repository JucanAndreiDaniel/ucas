# MR mined from tests/equivalg:r,s
# meaning-preserving rewrite: xor0
f(x: u8, y: u8) = (x/8)*y + (x/8)*3
g(x: u8, y: u8) = (x/8)*(y + 3)
f2(x: u8, y: u8) = ((x/8)*y + (x/8)*3) xor 0
g2(x: u8, y: u8) = ((x/8)*(y + 3)) xor 0
f1(x: u8, y: u8) = ((x/8)*y + (x/8)*3) xor 0
equiv f g
equiv f2 g2
equiv f1 g
equiv f f2
