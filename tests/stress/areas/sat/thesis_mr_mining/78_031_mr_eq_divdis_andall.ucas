# MR mined from tests/equivalg:r,s
# meaning-preserving rewrite: andall
f(x: u8, y: u8) = (x/8)*y + (x/8)*3
g(x: u8, y: u8) = (x/8)*(y + 3)
f2(x: u8, y: u8) = ((x/8)*y + (x/8)*3) & 255
g2(x: u8, y: u8) = ((x/8)*(y + 3)) & 255
f1(x: u8, y: u8) = ((x/8)*y + (x/8)*3) & 255
equiv f g
equiv f2 g2
equiv f1 g
equiv f f2
