# MR mined from tests/equivalg:p,q
# meaning-preserving rewrite: andall
f(x: u8, y: u8) = (x + y)*(x - y)
g(x: u8, y: u8) = x*x - y*y
f2(x: u8, y: u8) = ((x + y)*(x - y)) & 255
g2(x: u8, y: u8) = (x*x - y*y) & 255
f1(x: u8, y: u8) = ((x + y)*(x - y)) & 255
equiv f g
equiv f2 g2
equiv f1 g
equiv f f2
