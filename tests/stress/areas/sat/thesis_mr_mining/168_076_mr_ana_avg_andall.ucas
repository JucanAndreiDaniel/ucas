# MR mined from tests/analysis:avg,avg2
# meaning-preserving rewrite: andall
f(a: u8, b: u8) = (a + b) / 2
g(a: u8, b: u8) = (a & b) + ((a xor b) >> 1)
f2(a: u8, b: u8) = ((a + b) / 2) & 255
g2(a: u8, b: u8) = ((a & b) + ((a xor b) >> 1)) & 255
f1(a: u8, b: u8) = ((a + b) / 2) & 255
equiv f g
equiv f2 g2
equiv f1 g
equiv f f2
