# MR mined from tests/counter:avg,low
# meaning-preserving rewrite: minus0
f(a: u8, b: u8) = (a + b)/2
g(a: u8, b: u8) = (a & b) + ((a xor b) >> 1)
f2(a: u8, b: u8) = ((a + b)/2) - 0
g2(a: u8, b: u8) = ((a & b) + ((a xor b) >> 1)) - 0
f1(a: u8, b: u8) = ((a + b)/2) - 0
equiv f g
equiv f2 g2
equiv f1 g
equiv f f2
