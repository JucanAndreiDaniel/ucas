# proof/kernel mutation: proof T and axioms T must agree on the axiom set
theorem t_ab: forall x y:el: 2*(x + y) - x = x + 2*y
prove t_ab
proof t_ab
axioms t_ab
# mutated (false) theorem: automation must reject it, check must reject it
theorem t_ab_mut: forall x y:el: 2*(x + y) - x = x + 3*y
prove t_ab_mut
check t_ab_mut
