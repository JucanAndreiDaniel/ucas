# meaning-preserving rewrite: xor0
f(v: i8, m: i8) = min(max(v + m, 0), 255)
g(v: i8, m: i8) = v + m
f2(v: i8, m: i8) = (min(max(v + m, 0), 255)) xor 0
g2(v: i8, m: i8) = (v + m) xor 0
f1(v: i8, m: i8) = (min(max(v + m, 0), 255)) xor 0
equiv f g
equiv f2 g2
equiv f1 g
equiv f f2
