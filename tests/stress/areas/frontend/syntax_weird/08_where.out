> f(x: int) = x*x where x in 0..5
> range f
range of f -> int:
  0..25
  fits in u5
  over all 6 points of the domain
> g(x: int) = x where x in 0..5 where x in 1..3
> range g
range of g -> int:
  1..3
  fits in u2
  over all 3 points of the domain
> h(x: int) = x where x >= 0 and x <= 5
> range h
range of h -> int:
  0..5
  fits in u3
  over all 6 points of the domain
> k(x: int) = x where x in 0..5 && x != 3
> range k
range of k -> int:
  0..5
  fits in u3
  over all 5 points of the domain
> p(x: int) = x where x in {1, 5, 9}
> range p
range of p -> int:
  1..9
  fits in u4
  over all 3 points of the domain
> u(v: u32, n: u32 in 5..8) = v + n where v < 1 << n
> range u
range of u -> u32:
  5..263
  fits in u9
  over all 480 points of the domain
