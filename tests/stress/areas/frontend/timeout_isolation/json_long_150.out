{"id": 183, "ok": true, "cmd": "state", "structured": true, "result": {"kind": "state", "functions": [{"name": "g6a", "params": [{"name": "x", "type": "u6"}], "body": "x*x*x + 47", "signature": "g6a(x: u6)"}, {"name": "g6b", "params": [{"name": "x", "type": "u6"}], "body": "x*x + (x << 2) + 7", "signature": "g6b(x: u6)"}, {"name": "g6c", "params": [{"name": "x", "type": "u6"}], "body": "x*x*x + (x >> 1)", "signature": "g6c(x: u6)"}, {"name": "g6d", "params": [{"name": "x", "type": "u6"}], "body": "x*(x + 1)*(x + 2)", "signature": "g6d(x: u6)"}, {"name": "g6e", "params": [{"name": "x", "type": "u6"}], "body": "(x | 0x15) + (x & 6) - (x & 1)", "signature": "g6e(x: u6)"}, {"name": "g6f", "params": [{"name": "x", "type": "u6"}], "body": "(13x >> 1) + (x & 5)", "signature": "g6f(x: u6)"}, {"name": "g6g", "params": [{"name": "x", "type": "u6"}], "body": "x*x*x*x + x*x + 3", "signature": "g6g(x: u6)"}, {"name": "g6h", "params": [{"name": "x", "type": "u6"}], "body": "(x << 3) - (x >> 2) + 11", "signature": "g6h(x: u6)"}, {"name": "ra1", "params": [{"name": "x", "type": "real"}], "body": "sin(x)*exp(cos(x))", "signature": "ra1(x: real)"}, {"name": "ra2", "params": [{"name": "x", "type": "real"}], "body": "sin(x^2)*cos(exp(x))", "signature": "ra2(x: real)"}, {"name": "ra3", "params": [{"name": "x", "type": "real"}], "body": "exp(sin(x))*log(cos(x) + 2)", "signature": "ra3(x: real)"}, {"name": "ra4", "params": [{"name": "x", "type": "real"}], "body": "sin(exp(x))*cos(exp(x))", "signature": "ra4(x: real)"}, {"name": "ra5", "params": [{"name": "x", "type": "real"}], "body": "sqrt(x^2 + 1)*sin(3x)", "signature": "ra5(x: real)"}, {"name": "h1", "params": [{"name": "x", "type": "u64"}], "body": "11400714819323198485*11400714819323198485x", "signature": "h1(x: u64)"}, {"name": "h2", "params": [{"name": "x", "type": "u64"}], "body": "16088033396387240377x", "signature": "h2(x: u64)"}, {"name": "h3", "params": [{"name": "x", "type": "u64"}], "body": "10723151780598845931*137878487931