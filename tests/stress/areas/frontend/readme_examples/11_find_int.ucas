sd(a: i32 in 0..1000, b: i32) = a / 7 + b
find sd 1
ud(a: u32 in 0..60000, b: u32 in 30..4000) = a / b
find ud 1
dv(n: u32) = n % 7 == 0
find dv 1
d(x: u32 in 0..99, y: u32) = x / 10 + y
find d 1
sw(x: u32 in 0..7, y: u32) = (x == 0 ? 3 : x == 1 ? 7 : x == 2 ? 1 : x == 5 ? 9 : 0) + y
find sw 1
q(v: u32 in 0..255) = (v*31 + 127)/255
find q 1
