{"jsonrpc": "2.0", "id": 3, "result": {"prompts": [{"name": "cheaper_implementation", "description": "Find and prove a cheaper implementation of a function on its machine types", "arguments": [{"name": "f", "description": "the function, with types: \"days(m: u8 in 1..12) = match m { 2 => 28, 4 | 6 | 9 | 11 => 30, _ => 31 }\" or isqrt(x: u4)", "required": true}]}, {"name": "prove_identity", "description": "Prove (or refute with a counterexample) that two expressions are equal", "arguments": [{"name": "identity", "description": "the claimed identity, e.g. sin(x)^2 + cos(x)^2 = 1 or (x: u8) * 2 = x << 1", "required": true}]}, {"name": "explore_function", "description": "Study a function: its properties, critical points, integral and a plot", "arguments": [{"name": "f", "description": "the function, e.g. x^3 - 3x or sin(x)/x", "required": true}]}]}}
