f(y: u8, t: u8, w: u8, x: u8) = y*t*w + x*t
g(y: u8, t: u8, w: u8, x: u8) = (y*w + x)*t
equiv f g
q1(x: u32) = asfloat(x | 0x7fc00000)
q2(x: u32) = asfloat(u32(0x7fc00000))
equiv q1 q2
equiv q1 q2 nanbits
m1(x: u32) = -(-asfloat(x))
m2(x: u32) = asfloat(x)
equiv m1 m2 nanbits
l2a(x: f32, y: f32) = x * y
l2b(x: f32, y: f32) = f32(f64(x) * f64(y))
equiv l2a l2b
u1(x: f16, y: f16) = x + y
u2(x: f16, y: f16) = x == f16(1) && y == f16(2^(-10)) ? x : x + y
equiv u1 u2
