{"jsonrpc": "2.0", "id": 6, "result": {"content": [{"type": "text", "text": "wrap analysis of 2x:\n  2x   (u8)\n      nuw fails: unsigned wrap at 128 points, e.g. x=128\n      nsw fails: signed wrap at 128 points, e.g. x=64\n  end to end: differs from the mathematical result at 128 points, e.g. x=128\n      exact for: 0..127\n  over all 256 points of the domain\n"}], "structuredContent": {"id": 6, "ok": true, "cmd": "wrap", "ucas": "wrap (x: u8)*2", "structured": true, "result": {"kind": "wrap", "exhaustive": true, "operations": [{"op": "2x", "type": "u8", "nuw": false, "unsigned_wrap_points": 128, "unsigned_wrap_example": "x=128", "nsw": false, "signed_wrap_points": 128, "signed_wrap_example": "x=64", "c_ub": false}], "end_to_end": {"exact": false, "mismatch_points": 128, "mismatch_example": "x=128", "exact_for": [[0, 127]]}}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "wrap analysis of 2x:\n  2x   (u8)\n      nuw fails: unsigned wrap at 128 points, e.g. x=128\n      nsw fails: signed wrap at 128 points, e.g. x=64\n  end to end: differs from the mathematical result at 128 points, e.g. x=128\n      exact for: 0..127\n  over all 256 points of the domain\n"}, "isError": false}}
{"jsonrpc": "2.0", "id": 7, "result": {"content": [{"type": "text", "text": "critical points of x^3 - 3x:\n  x^3 - 3x' = 3x^2 - 3\n  x ≈ -1: local maximum, x^3 - 3x = 2\n  x ≈ 1: local minimum, x^3 - 3x = -2\n  searched [-10, 10] (default; give x a range)\n"}], "structuredContent": {"id": 7, "ok": true, "cmd": "crit", "ucas": "crit x^3 - 3x", "structured": true, "result": {"kind": "crit", "derivative": "3x^2 - 3", "points": [{"x": -1, "kind": "local maximum", "value": 2}, {"x": 1, "kind": "local minimum", "value": -2}]}, "notes": [], "conditions": [], "checks": [], "proof": {"kind": "numeric", "text": "sign changes of the derivative on a grid, refined by bisection"}, "files": [], "text": "critical points of x^3 - 3x:\n  x^3 - 3x' = 3x^2 - 3\n  x ≈ -1: local maximum, x^3 - 3x = 2\n  x ≈ 1: local minimum, x^3 - 3x = -2\n  searched [-10, 10] (default; give x a range)\n"}, "isError": false}}
