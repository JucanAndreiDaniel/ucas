# hypercomplex commands (hyper.c): associator, commutator, axisangle, rotmatrix, frommatrix, slerp
associator e1, e2, e4
associator i, j, k
commutator i, j
commutator e1, e2
axisangle (0, 0, 1), 90 degrees
axisangle 1 + i
rotmatrix 1 + i + j + k
frommatrix 0, -1, 0, 1, 0, 0, 0, 0, 1
slerp 1, k, 1/2
