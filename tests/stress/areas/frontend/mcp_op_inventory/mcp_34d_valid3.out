loat v129 = v105 + v128;\n\tfloat v130 = subgroupShuffleXor(v119, 2u);\n\tfloat v131 = v115 + v130;\n\tfloat v132 = subgroupShuffleXor(v121, 2u);\n\tfloat v133 = v117 + v132;\n\tfloat v134 = subgroupShuffleXor(v127, 2u);\n\tfloat v135 = v123 + v134;\n\tfloat v136 = subgroupShuffleXor(v129, 2u);\n\tfloat v137 = v125 + v136;\n\tfloat v138 = c[0];\n\tfloat v139 = v131 + v138;\n\tfloat v140 = c[1];\n\tfloat v141 = v133 + v140;\n\tfloat v142 = c[2];\n\tfloat v143 = v135 + v142;\n\tfloat v144 = c[3];\n\tfloat v145 = v137 + v144;\n\td[0] = v139;\n\td[1] = v141;\n\td[2] = v143;\n\td[3] = v145;\n}\n"}, "notes": [], "conditions": ["every lane of the warp active, the warp a subgroup of 32 or 32 aligned lanes of a larger one", "the f32 sums round to nearest"], "checks": [{"kind": "random", "points": 8192, "max_diff": 0.5941549191367976, "passed": true, "text": "random fragments against the exact sums, as a fraction of the bound"}], "proof": {"kind": "exhaustive", "text": "the plan run on symbols in all 32 lanes: every element of D is exactly its K products and its C, each once"}, "files": [{"name": "mma_m16n8k16_f32.glsl", "mime": "text/plain", "bytes": 5755}], "text": "mma m16n8k16: D = A B + C on a warp's fragments as PTX's mma.sync.aligned.m16n8k16.row.col lays them out, f16 A and B, f32 C and D, 32 lanes, under gt1030 (8488 dataflows tried)\n  each of D's 128 elements is a sum of 16 products of f16 and its C\n   1. 306       A-stationary; B: 32 shuffles (unpacked); partial sums: 12 xor shuffles, depth 6\n   2. 306       blocked (a lane: 2 rows x 8 columns x 4 of k); B: 32 shuffles (unpacked); partial sums: 12 xor shuffles, depth 6\n   3. 306       blocked (a lane: 2 rows x 8 columns x 4 of k); B: 32 shuffles (unpacked); partial sums: 12 xor shuffles, depth 6\n   4. 326       A-stationary; B: 16 shuffles; partial sums: 12 xor shuffles, depth 6\n   5. 326       blocked (a lane: 2 rows x 8 columns x 4 of k); B: 16 shuffles; partial sums: 12 xor shuffles, depth 6\n   6. 326       blocked (a lane: 2 rows x 8 columns x 4 of k); B: 16 shuffles; partial sums: 12 xor shuffles, depth 6\n  (30 more: mma ... all)\n  B-stationary: none possible: no assignment of the partial sums to registers (a xor of the lane's bits) lets a butterfly send and read them from the same registers in every lane\n  reference, each word fetched from the lane that holds it: 401 (output-stationary; A: 16 shuffles; B: 16 shuffles, depth 16); the chosen is 1.31x cheaper\n  chosen: A-stationary; B: 32 shuffles (unpacked); partial sums: 12 xor shuffles, cost 306\n    44 exchanges, 0 loads and 0 stores of shared memory (bank conflicts at most 1-way), 0 barriers, 12 unpacks, 64 multiply-adds, 16 adds\n    8 shuffle indices, 12 integer operations\n  proof: the plan run on symbols in all 32 lanes gives every element of D as exactly its 16 products and its C, each once (exhaustive over the lanes)\n  bound: |D - (A B + C)| <= gamma_6 (sum_k |A_ik B_kj| + |C_ij|), gamma_6 = 6 u / (1 - 6 u) = 3.576e-07, u = 2^-24\n    a product of two f16 is exact in f32 (22 significant bits, exponents within f32's normals), so only the sums round: each term through at most 6 roundings\n  holds when: every lane of the warp active, the warp a subgroup of 32 or 32 aligned lanes of a larger one; the f32 sums round to nearest\n  check: 64 random sets of fragments in f32 against the exact sums: within the bound, the largest error 0.594 of the bound (sampled, not a proof)\n  GLSL (mma_m16n8k16_f32.glsl):\n    // D = A B + C on a warp's fragments as PTX's mma.sync.aligned.m16n8k16.row.col\n    // lays them out (f16 A and B, f32 C and D), for a GPU without a matrix unit.\n    // ucas mma m16n8k16 f32 under gt1030: A-stationary; B: 32 shuffles (unpacked); partial sums: 12 xor shuffles;\n    // cost 306 (each word fetched from its lane: 401).\n    // Proved over the 32 lanes: each element of D is its 16 products and C, each once;\n    // |D - (A B + C)| <= gamma_6 (sum_k |A_ik B_kj| + |C_ij|), u = 2^-24.\n    #extension GL_KHR_shader_subgroup_basic : require\n    #extension GL_KHR_shader_subgroup_shuffle : require\n    void mma_m16n8k16_f32(uint a[4], uint b[2], float c[4], out float d[4])\n    {\n    \tuint lane = gl_SubgroupInvocationID & 31u;\n    \tuint base = gl_SubgroupInvocationID & ~31u;\n    \tuint v0 = a[0];\n    \tfloat v1 = unpackHalf2x16(v0).x;\n    \tuint v2 = b[0];\n    \tfloat v3 = unpackHalf2x16(v2).x;\n    \tuint i0 = base | ((lane & 3u) ^ ((lane & 3u) << 3u));\n    \tfloat v4 = subgroupShuffle(v3, i0);\n    \tfloat v5 = v1 * v4;\n    \tfloat v6 = unpackHalf2x16(v0).y;\n    \tfloat v7 = unpackHalf2x16(v2).y;\n    \tfloat v8 = subgroupShuffle(v7, i0);\n    \tfloat v9 = fma(v6, v8, v5);\n    \tuint v10 = a[2];\n    \tfloat v11 = unpackHalf2x16(v10).x;\n    \tuint v12 = b[1];\n    \tfloat v13 = unpackHalf2x16(v12).x;\n    \tfloat v14 = subgroupShuffle(v13, i0);\n    \tfloat v15 = fma(v11, v14, v9);\n    \tfloat v16 = unpackHalf2x16(v10).y;\n    \tfloat v17 = unpackHalf2x16(v12).y;\n    \tfloat v18 = subgroupShuffle(v17, i0);\n    \tfloat v19 = fma(v16, v18, v15);\n    \tuint i1 = i0 ^ 4u;\n    \tfloat v20 = subgroupShuffle(v3, i1);\n    \tfloat v21 = v1 * v20;\n    \tfloat v22 = subgroupShuffle(v7, i1);\n    \tfloat v23 = fma(v6, v22, v21);\n    \tfloat v24 = subgroupShuffle(v13, i1);\n    \tfloat v25 = fma(v11, v24, v23);\n    \tfloat v26 = subgroupShuffle(v17, i1);\n    \tfloat v27 = fma(v16, v26, v25);\n    \tuint i2 = i0 ^ 8u;\n    \tfloat v28 = subgroupShuffle(v3, i2);\n    \tfloat v29 = v1 * v28;\n    \tfloat v30 = subgroupShuffle(v7, i2);\n    \tfloat v31 = fma(v6, v30, v29);\n    \tfloat v32 = subgroupShuffle(v13, i2);\n    \tfloat v33 = fma(v11, v32, v31);\n    \tfloat v34 = subgroupShuffle(v17, i2);\n    \tfloat v35 = fma(v16, v34, v33);\n    \tuint i3 = i0 ^ 12u;\n    \tfloat v36 = subgroupShuffle(v3, i3);\n    \tfloat v37 = v1 * v36;\n    \tfloat v38 = subgroupShuffle(v7, i3);\n    \tfloat v39 = fma(v6, v38, v37);\n    \tfloat v40 = subgroupShuffle(v13, i3);\n    \tfloat v41 = fma(v11, v40, v39);\n    \tfloat v42 = subgroupShuffle(v17, i3);\n    \tfloat v43 = fma(v16, v42, v41);\n    \tuint i4 = i0 ^ 16u;\n    \tfloat v44 = subgroupShuffle(v3, i4);\n    \tfloat v45 = v1 * v44;\n    \tfloat v46 = subgroupShuffle(v7, i4);\n    \tfloat v47 = fma(v6, v46, v45);\n    \tfloat v48 = subgroupShuffle(v13, i4);\n    \tfloat v49 = fma(v11, v48, v47);\n    \tfloat v50 = subgroupShuffle(v17, i4);\n    \tfloat v51 = fma(v16, v50, v49);\n    \tuint i5 = i0 ^ 20u;\n    \tfloat v52 = subgroupShuffle(v3, i5);\n    \tfloat v53 = v1 * v52;\n    \tfloat v54 = subgroupShuffle(v7, i5);\n    \tfloat v55 = fma(v6, v54, v53);\n    \tfloat v56 = subgroupShuffle(v13, i5);\n    \tfloat v57 = fma(v11, v56, v55);\n    \tfloat v58 = subgroupShuffle(v17, i5);\n    \tfloat v59 = fma(v16, v58, v57);\n    \tuint i6 = i0 ^ 24u;\n    \tfloat v60 = subgroupShuffle(v3, i6);\n    \tfloat v61 = v1 * v60;\n    \tfloat v62 = subgroupShuffle(v7, i6);\n    \tfloat v63 = fma(v6, v62, v61);\n    \tfloat v64 = subgroupShuffle(v13, i6);\n    \tfloat v65 = fma(v11, v64, v63);\n    \tfloat v66 = subgroupShuffle(v17, i6);\n    \tfloat v67 = fma(v16, v66, v65);\n    \tuint i7 = i0 ^ 28u;\n    \tfloat v68 = subgroupShuffle(v3, i7);\n    \tfloat v69 = v1 * v68;\n    \tfloat v70 = subgroupShuffle(v7, i7);\n    \tfloat v71 = fma(v6, v70, v69);\n    \tfloat v72 = subgroupShuffle(v13, i7);\n    \tfloat v73 = fma(v11, v72, v71);\n    \tfloat v74 = subgroupShuffle(v17, i7);\n    \tfloat v75 = fma(v16, v74, v73);\n    \tuint v76 = a[1];\n    \tfloat v77 = unpackHalf2x16(v76).x;\n    \tfloat v78 = v77 * v4;\n    \tfloat v79 = unpackHalf2x16(v76).y;\n    \tfloat v80 = fma(v79, v8, v78);\n    \tuint v81 = a[3];\n    \tfloat v82 = unpackHalf2x16(v81).x;\n    \tfloat v83 = fma(v82, v14, v80);\n    \tfloat v84 = unpackHalf2x16(v81).y;\n    \tfloat v85 = fma(v84, v18, v83);\n    \tfloat v86 = v77 * v20;\n    \tfloat v87 = fma(v79, v22, v86);\n    \tfloat v88 = fma(v82, v24,