= v27 + v116;\n    \tfloat v118 = subgroupShuffleXor(v67, 1u);\n    \tfloat v119 = v51 + v118;\n    \tfloat v120 = subgroupShuffleXor(v75, 1u);\n    \tfloat v121 = v59 + v120;\n    \tfloat v122 = subgroupShuffleXor(v93, 1u);\n    \tfloat v123 = v85 + v122;\n    \tfloat v124 = subgroupShuffleXor(v97, 1u);\n    \tfloat v125 = v89 + v124;\n    \tfloat v126 = subgroupShuffleXor(v109, 1u);\n    \tfloat v127 = v101 + v126;\n    \tfloat v128 = subgroupShuffleXor(v113, 1u);\n    \tfloat v129 = v105 + v128;\n    \tfloat v130 = subgroupShuffleXor(v119, 2u);\n    \tfloat v131 = v115 + v130;\n    \tfloat v132 = subgroupShuffleXor(v121, 2u);\n    \tfloat v133 = v117 + v132;\n    \tfloat v134 = subgroupShuffleXor(v127, 2u);\n    \tfloat v135 = v123 + v134;\n    \tfloat v136 = subgroupShuffleXor(v129, 2u);\n    \tfloat v137 = v125 + v136;\n    \tfloat v138 = c[0];\n    \tfloat v139 = v131 + v138;\n    \tfloat v140 = c[1];\n    \tfloat v141 = v133 + v140;\n    \tfloat v142 = c[2];\n    \tfloat v143 = v135 + v142;\n    \tfloat v144 = c[3];\n    \tfloat v145 = v137 + v144;\n    \td[0] = v139;\n    \td[1] = v141;\n    \td[2] = v143;\n    \td[3] = v145;\n    }\n  attached mma_m16n8k16_f32.glsl (5755 bytes)\n"}, {"type": "resource", "resource": {"uri": "ucas://file/mma_m16n8k16_f32.glsl", "mimeType": "text/plain", "blob": ""}}], "structuredContent": {"id": 1, "ok": true, "cmd": "mma", "ucas": "mma f32", "structured": true, "result": {"kind": "mma", "shape": "m16n8k16", "accumulator": "f32", "model": "gt1030", "tried": 8488, "dataflows": [{"cost": 306, "dataflow": "A-stationary; B: 32 shuffles (unpacked); partial sums: 12 xor shuffles", "depth": 6}, {"cost": 306, "dataflow": "blocked (a lane: 2 rows x 8 columns x 4 of k); B: 32 shuffles (unpacked); partial sums: 12 xor shuffles", "depth": 6}, {"cost": 306, "dataflow": "blocked (a lane: 2 rows x 8 columns x 4 of k); B: 32 shuffles (unpacked); partial sums: 12 xor shuffles", "depth": 6}, {"cost": 326, "dataflow": "A-stationary; B: 16 shuff