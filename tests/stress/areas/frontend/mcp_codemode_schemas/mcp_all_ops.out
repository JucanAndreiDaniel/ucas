 [\"cmd\"]}, {\"properties\": {\"cmd\": {\"const\": \"winograd\"}, \"args\": {\"type\": \"object\", \"properties\": {\"function\": {\"$ref\": \"#/$defs/function\", \"description\": \"a sum of an even number of products\"}, \"rows\": {\"type\": \"integer\", \"description\": \"rows sharing a column's correction (1)\"}, \"cols\": {\"type\": \"integer\", \"description\": \"columns sharing a row's correction (1)\"}, \"tol\": {\"$ref\": \"#/$defs/number\", \"description\": \"floats: the absolute error allowed\"}, \"assume\": {\"type\": \"object\", \"description\": \"answers to ambiguities: {key: reading or index}, e.g. {\\\"caret\\\": \\\"power\\\", \\\"z\\\": \\\"complex\\\"}\"}, \"defaults\": {\"type\": \"boolean\", \"description\": \"take the default reading of every ambiguity (as the CLI does with a note) instead of an error\"}, \"timeout_s\": {\"$ref\": \"#/$defs/number\", \"description\": \"wall-clock limit; the request runs in a forked child and the state is unchanged on a timeout\"}, \"files\": {\"enum\": [\"write\", \"base64\", \"both\", \"none\"], \"description\": \"what to do with files: write (to --dir, default), base64 (inline, nothing written), both, none\"}, \"answers\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"replies to follow-up questions, in order\"}}, \"required\": [\"function\"], \"additionalProperties\": false}, \"id\": {}}, \"required\": [\"cmd\"]}, {\"properties\": {\"cmd\": {\"const\": \"ozaki\"}, \"args\": {\"type\": \"object\", \"properties\": {\"function\": {\"$ref\": \"#/$defs/function\", \"description\": \"a float sum of products, its factors ranged (x: f32 in -1..1)\"}, \"slices\": {\"type\": \"integer\", \"description\": \"slices a factor (2): more bits, a smaller error\"}, \"tol\": {\"$ref\": \"#/$defs/number\", \"description\": \"the absolute error allowed: taken within it\"}, \"seed\": {\"type\": \"integer\", \"description\": \"the check's seed (1)\"}, \"model\": {\"$ref\": \"#/$defs/name\", \"description\": \"the model (the active one)\"}, \"assume\": {\"type\": \"object\", \"description\": \"answers to ambiguities: {key: reading or index}, e.g. {\\\"caret\\\": \\\"power\\\", \\\"z\\\": \\\"complex\\\"}\"}, \"defaults\": {\"type\": \"boolean\", \"description\": \"take the default reading of every ambiguity (as the CLI does with a note) instead of an error\"}, \"timeout_s\": {\"$ref\": \"#/$defs/number\", \"description\": \"wall-clock limit; the request runs in a forked child and the state is unchanged on a timeout\"}, \"files\": {\"enum\": [\"write\", \"base64\", \"both\", \"none\"], \"description\": \"what to do with files: write (to --dir, default), base64 (inline, nothing written), both, none\"}, \"answers\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"replies to follow-up questions, in order\"}}, \"required\": [\"function\"], \"additionalProperties\": false}, \"id\": {}}, \"required\": [\"cmd\"]}]}, \"response\": {\"type\": \"object\", \"required\": [\"id\", \"ok\", \"cmd\"], \"properties\": {\"id\": {\"description\": \"the request's id, as given (null if none)\"}, \"ok\": {\"type\": \"boolean\"}, \"cmd\": {\"type\": [\"string\", \"null\"]}, \"ucas\": {\"description\": \"the ucas statements that ran (error positions refer to them)\", \"type\": \"string\"}, \"structured\": {\"description\": \"result has fields beyond text\", \"type\": \"boolean\"}, \"result\": {\"description\": \"the command's fields (kind, ...); exact values as {value, exact}; expressions as ucas strings that parse back; unstructured commands give {text}\", \"type\": \"object\"}, \"results\": {\"description\": \"every result, when the request ran several commands\", \"type\": \"array\"}, \"notes\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"kind\": {\"enum\": [\"rule\", \"info\", \"assumed\", \"default\"]}, \"text\": {\"type\": \"string\"}}}}, \"conditions\": {\"description\": \"where the answer holds\", \"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"checks\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"kind\": {\"type\": \"string\"}, \"points\": {\"type\": \"integer\"}, \"max_diff\": {\"type\": \"number\"}, \"passed\": {\"type\": \"boolean\"}, \"text\": {\"type\": \"string\"}}}}, \"proof\": {\"type\": \"object\", \"properties\": {\"kind\": {\"enum\": [\"symbolic\", \"exhaustive\", \"sat\", \"numeric\", \"search\"]}, \"text\": {\"type\": \"string\"}}}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"mime\": {\"type\": \"string\"}, \"bytes\": {\"type\": \"integer\"}, \"path\": {\"type\": \"string\"}, \"base64\": {\"type\": \"string\"}}}}, \"text\": {\"description\": \"the output as the CLI prints it\", \"type\": \"string\"}, \"error\": {\"type\": \"object\", \"required\": [\"code\", \"message\"], \"properties\": {\"code\": {\"enum\": [\"bad_json\", \"bad_request\", \"unknown_command\", \"parse_error\", \"domain_error\", \"unsupported\", \"failed\", \"ambiguous\", \"needs_input\", \"not_understood\", \"timeout\", \"internal\"]}, \"message\": {\"type\": \"string\"}, \"pos\": {\"type\": \"object\", \"properties\": {\"line\": {\"type\": \"integer\"}, \"col\": {\"type\": \"integer\"}}}, \"key\": {\"description\": \"ambiguous: the args.assume key that picks a reading\", \"type\": \"string\"}, \"readings\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"index\": {\"type\": \"integer\"}, \"reading\": {\"type\": \"string\"}, \"default\": {\"type\": \"boolean\"}, \"how\": {\"type\": \"string\"}}}}, \"how\": {\"type\": \"string\"}}}}}}, \"options\": [{\"name\": \"assume\", \"type\": \"object\", \"description\": \"answers to ambiguities: {key: reading or index}, e.g. {\\\"caret\\\": \\\"power\\\", \\\"z\\\": \\\"complex\\\"}\"}, {\"name\": \"defaults\", \"type\": \"boolean\", \"description\": \"take the default reading of every ambiguity (as the CLI does with a note) instead of an error\"}, {\"name\": \"timeout_s\", \"type\": \"number\", \"description\": \"wall-clock limit; the request runs in a forked child and the state is unchanged on a timeout\"}, {\"name\": \"files\", \"type\": \"enum\", \"description\": \"what to do with files: write (to --dir, default), base64 (inline, nothing written), both, none\"}, {\"name\": \"answers\", \"type\": \"strings\", \"description\": \"replies to follow-up questions, in order\"}], \"commands\": [{\"cmd\": \"define\", \"description\": \"define a function: name(params) = body [where ...]; every parameter needs a type (or a range)\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"name\", \"required\": true, \"description\": \"the function's name\"}, {\"name\": \"params\", \"type\": \"parameters\", \"required\": false, \"description\": \"[{\\\"name\\\", \\\"type\\\", \\\"range\\\": [lo, hi], \\\"uniform\\\"}]; omitted: the body's free variables in order of appearance (an ambiguity: free_vars)\"}, {\"name\": \"body\", \"type\": \"expression\", \"required\": true, \"description\": \"the body\"}, {\"name\": \"where\", \"type\": \"strings\", \"required\": false, \"description\": \"where-clauses: bindings (\\\"y = x + 1\\\") and conditions (\\\"x != 0\\\")\"}]}, {\"cmd\": \"state\", \"description\": \"the session: functions, models, bases, assumptions\", \"structured\": true, \"params\": []}, {\"cmd\": \"reset\", \"description\": \"drop every definition (the process image is restarted)\", \"structured\": true, \"params\": []}, {\"cmd\": \"assume\", \"description\": \"session-wide answers to ambiguities (merged under each request's args.assume)\", \"structured\": true, \"params\": [{\"name\": \"set\", \"type\": \"object\", \"required\": false, \"description\": \"{key: reading}\"}, {\"name\": \"clear\", \"type\": \"boolean\", \"required\": false, \"description\": \"drop the session's assumptions first\"}]}, {\"cmd\": \"schema\", \"description\": \"this interface as JSON Schema\", \"structured\": true, \"params\": []}, {\"cmd\": \"ucas\", \"description\": \"raw ucas statements (the escape hatch)\", \"structured\": false, \"params\": [{\"name\": \"source\", \"type\": \"source\", \"required\": true, \"description\": \"ucas source; several lines allowed\"}, {\"name\": \"code\", \"type\": \"source\", \"required\": false, \"description\": \"a code block for the statement (SPIR-V assembly or GLSL)\"}]}, {\"cmd\": \"english\", \"description\": \"translate English (opt-in) and run it; the translated statements are returned\", \"structured\": true, \"params\": [{\"name\": \"text\", \"type\": \"string\", \"required\": true, \"description\": \"one English request\"}, {\"name\": \"answers\", \"type\": \"strings\", \"required\": false, \"description\": \"replies to follow-up questions (needs_input), in order\"}, {\"name\": \"code\", \"type\": \"source\", \"required\": false, \"description\": \"a code block the request is about (\\\"SAT simplify\\\" on SPIR-V, GLSL or C)\"}, {\"name\": \"lang\", \"type\": \"enum\", \"required\": false, \"description\": \"the code block's language (by default from the code)\", \"values\": \"spv|glsl|c\"}]}, {\"cmd\": \"help\", \"description\": \"the command summary\", \"ucas\": \"help\", \"structured\": false, \"params\": []}, {\"cmd\": \"funcs\", \"description\": \"every defined function\", \"ucas\": \"funcs\", \"structured\": false, \"params\": []}, {\"cmd\": \"models\", \"description\": \"the cost models\", \"ucas\": \"models\", \"structured\": false, \"params\": []}, {\"cmd\": \"use\", \"description\": \"make a cost model active\", \"ucas\": \"use\", \"structured\": false, \"params\": [{\"name\": \"model\", \"type\": \"name\", \"required\": true, \"description\": \"the model\"}]}, {\"cmd\": \"show\", \"description\": \"the function, typed\", \"ucas\": \"show\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"table\", \"description\": \"values at the points of the domain\", \"ucas\": \"table\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"max\", \"type\": \"integer\", \"required\": false, \"description\": \"at most this many rows (64)\"}]}, {\"cmd\": \"parse\", \"description\": \"the expression fully parenthesised\", \"ucas\": \"parse\", \"structured\": true, \"params\": [{\"name\": \"expr\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}]}, {\"cmd\": \"range\", \"description\": \"min/max over the domain\", \"ucas\": \"range\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"nocrit\", \"type\": \"boolean\", \"required\": false, \"description\": \"grid only, no refinement at critical points\"}]}, {\"cmd\": \"domain\", \"description\": \"the conditions of the partial operations and the inputs where F is defined\", \"ucas\": \"domain\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"wrap\", \"description\": \"nuw/nsw per operation, C UB, end-to-end agreement with the mathematical result\", \"ucas\": \"wrap\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"crit\", \"description\": \"critical points, extrema, inflection points\", \"ucas\": \"crit\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"diff\", \"description\": \"derivative (higher, partial, mixed)\", \"ucas\": \"diff\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"vars\", \"type\": \"names\", \"required\": false, \"description\": \"variables, in order (x y: d2/dydx)\"}, {\"name\": \"order\", \"type\": \"integer\", \"required\": false, \"description\": \"the order\"}]}, {\"cmd\": \"grad\", \"description\": \"the gradient\", \"ucas\": \"grad\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"at\", \"type\": \"expressions\", \"required\": false, \"description\": \"a point\"}]}, {\"cmd\": \"hessian\", \"description\": \"the Hessian (and at a point the second-derivative test)\", \"ucas\": \"hessian\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"at\", \"type\": \"expressions\", \"required\": false, \"description\": \"a point\"}]}, {\"cmd\": \"laplacian\", \"description\": \"the Laplacian\", \"ucas\": \"laplacian\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"at\", \"type\": \"expressions\", \"required\": false, \"description\": \"a point\"}]}, {\"cmd\": \"jacobian\", \"description\": \"the Jacobian matrix\", \"ucas\": \"jacobian\", \"structured\": true, \"params\": [{\"name\": \"fs\", \"type\": \"expressions\", \"required\": true, \"description\": \"the functions\"}, {\"name\": \"wrt\", \"type\": \"names\", \"required\": false, \"description\": \"the variables\"}, {\"name\": \"at\", \"type\": \"expressions\", \"required\": false, \"description\": \"a point\"}]}, {\"cmd\": \"wronskian\", \"description\": \"the Wronskian and linear independence\", \"ucas\": \"wronskian\", \"structured\": true, \"params\": [{\"name\": \"fs\", \"type\": \"expressions\", \"required\": true, \"description\": \"the functions\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"limit\", \"description\": \"a limit, symbolically and numerically\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable (needed with several)\"}, {\"name\": \"to\", \"type\": \"expression\", \"required\": true, \"description\": \"the point: a number, inf or -inf\"}, {\"name\": \"side\", \"type\": \"enum\", \"required\": false, \"description\": \"one-sided: + (from the right) or -\", \"values\": \"+|-\"}]}, {\"cmd\": \"taylor\", \"description\": \"Taylor polynomial, checked\", \"ucas\": \"taylor\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable (default: the only one)\"}, {\"name\": \"at\", \"type\": \"number\", \"required\": false, \"description\": \"expansion point (0)\"}, {\"name\": \"order\", \"type\": \"integer\", \"required\": false, \"description\": \"the order\"}]}, {\"cmd\": \"implicit\", \"description\": \"dy/dx of an implicit curve\", \"ucas\": \"implicit\", \"structured\": true, \"params\": [{\"name\": \"equation\", \"type\": \"expression\", \"required\": true, \"description\": \"L = R\"}, {\"name\": \"for\", \"type\": \"name\", \"required\": false, \"description\": \"y\"}, {\"name\": \"wrt\", \"type\": \"name\", \"required\": false, \"description\": \"x\"}, {\"name\": \"order\", \"type\": \"integer\", \"required\": false, \"description\": \"1 or 2\"}]}, {\"cmd\": \"integrate\", \"description\": \"antiderivative (checked by differentiating back) or definite integral\", \"ucas\": \"integrate\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable of integration\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"lower bound (with to)\"}, {\"name\": \"to\", \"type\": \"number\", \"required\": false, \"description\": \"upper bound (with from)\"}, {\"name\": \"around\", \"type\": \"string\", \"required\": false, \"description\": \"a contour for a complex integrand: \\\"|z| = 1\\\"\"}, {\"name\": \"qmc\", \"type\": \"boolean\", \"required\": false, \"description\": \"a quasi-Monte Carlo estimate on Sobol points: over from..to, or without them over the box of every parameter's range\"}, {\"name\": \"points\", \"type\": \"integer\", \"required\": false, \"description\": \"qmc: points a replicate, a power of two (4096)\"}, {\"name\": \"replicates\", \"type\": \"integer\", \"required\": false, \"description\": \"qmc: randomised replicates (8)\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"qmc: the random seed (UCAS_SEED, else 1)\"}, {\"name\": \"owen\", \"type\": \"boolean\", \"required\": false, \"description\": \"qmc: a nested uniform (Owen) scrambling of each replicate, not a digital shift\"}]}, {\"cmd\": \"antiderivative\", \"description\": \"an antiderivative + C\", \"ucas\": \"antiderivative\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"equiv\", \"description\": \"equal on F's domain? (with a counterexample)\", \"ucas\": \"equiv\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"g\", \"type\": \"function\", \"required\": true, \"description\": \"the other function\"}, {\"name\": \"ftz\", \"type\": \"boolean\", \"required\": false, \"description\": \"needed when f or g has a float: true, every float operation (a bit cast aside) reads a subnormal as the zero of its sign and gives one; false, subnormals kept (IEEE)\", \"values\": \" noftz\"}, {\"name\": \"nanbits\", \"type\": \"boolean\", \"required\": false, \"description\": \"needed when the result is a float: true, two NaN results are equal only with the same sign and payload; false, every NaN is equal\"}]}, {\"cmd\": \"find\", \"description\": \"cheaper implementations under the cost model\", \"ucas\": \"find\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"n\", \"type\": \"integer\", \"required\": false, \"description\": \"how many (5)\"}, {\"name\": \"max\", \"type\": \"integer\", \"required\": false, \"description\": \"maximum cost\"}]}, {\"cmd\": \"texalu\", \"description\": \"table reads and weighted sums of neighbouring entries as reads through the texture unit, where the model prices them lower, with the pipeline change they need\", \"ucas\": \"texalu\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"tol\", \"type\": \"number\", \"required\": false, \"description\": \"the error allowed on a filtered sum (the sum's own rounding)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"texenc\", \"description\": \"a constant table as BC4 blocks (two of one shape as BC5), or as ASTC, EAC, ETC2, BC7 or BC6H blocks: endpoints, selectors and bytes, exact or within a tolerance\", \"ucas\": \"texenc\", \"structured\": true, \"params\": [{\"name\": \"table\", \"type\": \"expression\", \"required\": true, \"description\": \"the table: [t0, t1, ...] or its name\"}, {\"name\": \"green\", \"type\": \"expression\", \"required\": false, \"description\": \"a second table of the same shape: the two as BC5, the first red and this one green (with astc: a block's second plane, the alpha)\"}, {\"name\": \"astc\", \"type\": \"string\", \"required\": false, \"description\": \"an ASTC footprint, BWxBH (4x4 to 12x12): the table as ASTC blocks of it instead\"}, {\"name\": \"eac\", \"type\": \"boolean\", \"required\": false, \"description\": \"the table as R11_EAC blocks instead (two as RG11_EAC; signed when an entry is negative)\"}, {\"name\": \"etc2\", \"type\": \"boolean\", \"required\": false, \"description\": \"the table in the red channel of RGB8_ETC2 blocks instead (two as RGBA8_ETC2_EAC, the second the alpha)\"}, {\"name\": \"bc7\", \"type\": \"boolean\", \"required\": false, \"description\": \"the table in the red channel of BC7 blocks instead (two in red and alpha)\"}, {\"name\": \"srgb\", \"type\": \"boolean\", \"required\": false, \"description\": \"with astc, etc2 or bc7: the sRGB format, the first table read through the sRGB EOTF (alpha linear)\"}, {\"name\": \"bc6h\", \"type\": \"boolean\", \"required\": false, \"description\": \"the table, numbers of a half float's range, in the red channel of BC6H blocks instead (SFLOAT when an entry is negative)\"}, {\"name\": \"rows\", \"type\": \"integer\", \"required\": false, \"description\": \"texels in a row (4)\"}, {\"name\": \"tol\", \"type\": \"number\", \"required\": false, \"description\": \"the error allowed on an entry\"}]}, {\"cmd\": \"more\", \"description\": \"the next results of the last find\", \"ucas\": \"more\", \"structured\": false, \"params\": [{\"name\": \"n\", \"type\": \"integer\", \"required\": false, \"description\": \"how many\"}]}, {\"cmd\": \"stoke\", \"description\": \"MCMC (Metropolis-Hastings) over straight-line integer programs priced by the model; what reaches distance 0 is verified on the whole domain\", \"ucas\": \"stoke\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"steps\", \"type\": \"integer\", \"required\": false, \"description\": \"proposals a chain (200000)\"}, {\"name\": \"restarts\", \"type\": \"integer\", \"required\": false, \"description\": \"chains (4)\"}, {\"name\": \"len\", \"type\": \"integer\", \"required\": false, \"description\": \"instructions at most (8)\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the random seed (UCAS_SEED, else 1)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"pit\", \"description\": \"polynomial identity testing (Schwartz-Zippel): a probabilistic answer with its error bound\", \"ucas\": \"pit\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"g\", \"type\": \"function\", \"required\": true, \"description\": \"the other polynomial\"}, {\"name\": \"trials\", \"type\": \"integer\", \"required\": false, \"description\": \"random points (4)\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the random seed (UCAS_SEED, else 1)\"}]}, {\"cmd\": \"phash\", \"description\": \"a switch's keys hashed injectively into a table, when the model prices the lookup below the compare chain\", \"ucas\": \"phash\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the random seed (UCAS_SEED, else 1)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"fit\", \"description\": \"choose G's extra parameters to approximate F\", \"ucas\": \"fit\", \"structured\": true, \"params\": [{\"name\": \"g\", \"type\": \"function\", \"required\": true, \"description\": \"the approximation, with extra parameters\"}, {\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the target\"}, {\"name\": \"metric\", \"type\": \"enum\", \"required\": false, \"description\": \"the error to minimise\", \"values\": \"maxrel|maxabs|rms\"}]}, {\"cmd\": \"error\", \"description\": \"error of G as an approximation of F\", \"ucas\": \"error\", \"structured\": true, \"params\": [{\"name\": \"g\", \"type\": \"function\", \"required\": true, \"description\": \"the approximation\"}, {\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the target\"}]}, {\"cmd\": \"cost\", \"description\": \"price under a cost model\", \"ucas\": \"cost\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}, {\"name\": \"consecutive\", \"type\": \"name\", \"required\": false, \"description\": \"an integer parameter whose values run along the lanes of a warp (a branch's expected cost is then counted over those warps)\"}]}, {\"cmd\": \"dword\", \"description\": \"f64 arithmetic over f32 (alone, or as double-word pairs) where the model prices that lower, with a derived error bound and its conditions\", \"ucas\": \"dword\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"tol\", \"type\": \"number\", \"required\": false, \"description\": \"relative error allowed\"}, {\"name\": \"atol\", \"type\": \"number\", \"required\": false, \"description\": \"absolute error allowed\"}, {\"name\": \"ulp\", \"type\": \"number\", \"required\": false, \"description\": \"for a final f32: ulp beyond its own rounding\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"foldproof\", \"description\": \"the float round trips the model's driver folds, and their rounding as integer arithmetic it cannot fold, proved equal\", \"ucas\": \"foldproof\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"rop\", \"description\": \"graphics fixed-function states (blending, logic ops, stencil) that compute a per-cell update F(s, d), each proved and priced\", \"ucas\": \"rop\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"banks\", \"description\": \"the bank-conflict degree of shared-memory index expressions over a warp, and a proved index swizzle that lowers it when the model prices conflicts\", \"ucas\": \"banks\", \"structured\": true, \"params\": [{\"name\": \"accesses\", \"type\": \"expressions\", \"required\": true, \"description\": \"the index expressions (functions of a lane parameter and uniform ones)\"}, {\"name\": \"size\", \"type\": \"integer\", \"required\": false, \"description\": \"the array's length\"}, {\"name\": \"elem\", \"type\": \"integer\", \"required\": false, \"description\": \"bytes per element (4)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"intatomic\", \"description\": \"a float atomic add as an integer atomic add on fixed point, when its values are proved exact there (or within tol) and the model prices it lower\", \"ucas\": \"intatomic\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"count\", \"type\": \"integer\", \"required\": false, \"description\": \"adds into one cell at most (1024)\"}, {\"name\": \"tol\", \"type\": \"number\", \"required\": false, \"description\": \"absolute error allowed on the total\"}, {\"name\": \"global\", \"type\": \"boolean\", \"required\": false, \"description\": \"a device-scope atomic (shared: workgroup)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"mma\", \"description\": \"a warp's matrix product (PTX mma.sync m16n8k16 or m16n8k8, f16 A and B) on a GPU without a matrix unit: the dataflows priced under the model, the cheapest proved over the 32 lanes with its error bound, as GLSL\", \"ucas\": \"mma\", \"structured\": true, \"params\": [{\"name\": \"shape\", \"type\": \"enum\", \"required\": false, \"description\": \"the product's shape (m16n8k16)\", \"values\": \"m16n8k16|m16n8k8\"}, {\"name\": \"accumulator\", \"type\": \"enum\", \"required\": false, \"description\": \"C and D's type (f32)\", \"values\": \"f32|f16\"}, {\"name\": \"tm\", \"type\": \"integer\", \"required\": false, \"description\": \"HMMAs in the tile along m, sharing B (1)\"}, {\"name\": \"tn\", \"type\": \"integer\", \"required\": false, \"description\": \"along n, sharing A (1)\"}, {\"name\": \"tk\", \"type\": \"integer\", \"required\": false, \"description\": \"along k, a chain: each one's D the next one's C (1); tm tn tk at most 4\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}, {\"name\": \"all\", \"type\": \"boolean\", \"required\": false, \"description\": \"every dataflow's best, not the first six\"}, {\"name\": \"validate\", \"type\": \"boolean\", \"required\": false, \"description\": \"compile the GLSL with glslangValidator and spirv-val\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"a checksum instead of the GLSL file\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the random check's seed (1)\"}]}, {\"cmd\": \"gates\", \"description\": \"minimal gate network, with proof\", \"ucas\": \"gates\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"basis\", \"type\": \"name\", \"required\": false, \"description\": \"c, a64, a64sha, x86bmi, nand ...\"}, {\"name\": \"max\", \"type\": \"integer\", \"required\": false, \"description\": \"maximum cost (12)\"}, {\"name\": \"nodes\", \"type\": \"integer\", \"required\": false, \"description\": \"search budget\"}, {\"name\": \"as_c\", \"type\": \"boolean\", \"required\": false, \"description\": \"also a C function\"}]}, {\"cmd\": \"approx\", \"description\": \"polynomial/rational approximations, measured\", \"ucas\": \"approx\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"in\", \"type\": \"interval\", \"required\": false, \"description\": \"the interval\"}, {\"name\": \"options\", \"type\": \"string\", \"required\": false, \"description\": \"approx options as in the CLI: \\\"degree 5 as f64 keep endpoints\\\"\"}]}, {\