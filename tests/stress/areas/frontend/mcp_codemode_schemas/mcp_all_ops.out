ms\"}"}]}, {"cmd": "trig", "description": "equivalent trig forms", "ucas": "trig", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "mode", "type": "enum", "required": false, "description": "one kind of form", "values": "simplify|sincos|exp|reduce|product|sum|expand|harmonic|half|weierstrass|inverse|double|all"}]}, {"cmd": "nthroots", "description": "the N complex N-th roots", "ucas": "nthroots", "structured": true, "params": [{"name": "n", "type": "integer", "required": true, "description": "N"}, {"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "unity", "description": "the N-th roots of unity", "ucas": "unity", "structured": true, "params": [{"name": "n", "type": "integer", "required": true, "description": "N"}]}, {"cmd": "holomorphic", "description": "Cauchy-Riemann; the complex derivative", "ucas": "holomorphic", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}]}, {"cmd": "residue", "description": "the residue at a point", "ucas": "residue", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)\"), or {\"body\", \"params\"}"}, {"name": "at", "type": "expression", "required": true, "description": "the point"}]}, {"cmd": "poles", "description": "the poles and their orders", "ucas": "poles", "structured": true, "params": [{"name": "f", "type": "function", "required": true, "description": "the function: a defined name, an expression (inline types allowed: \"isqrt(x: u4)