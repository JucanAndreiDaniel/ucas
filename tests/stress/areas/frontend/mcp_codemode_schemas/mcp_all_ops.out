 h2 in Hc(B) and HM(B,C,g,h2,0) -> exists h:el: HM(A,B,f,h,h2)) and (forall h2 e h:el: HM(B,C,g,h2,e) and Del(A,B,C,f,g,e,h) -> h = 0) and (forall e:el: Del(A,B,C,f,g,e,0) -> exists h2:el: HM(B,C,g,h2,e)) and (forall e h h2:el: Del(A,B,C,f,g,e,h) and HM(A,B,f,h,h2) -> h2 = 0) and (forall h:el: h in Hc(A) and HM(A,B,f,h,0) -> exists e:el: Del(A,B,C,f,g,e,h))\nprime_ge2          forall p:int: prime(p) -> 2 <= p\nred_cx             forall C:cx, p:int: iscx(C) -> iscx(red(C,p))\nisses_bock         forall C:cx, p:int: fintype(C) and prime(p) -> isses(C,C,red(C,p),mulp(p),rh(C,p))\nsub_eqv            forall S T:set: subgroup(T) and (forall x:el: x in S <-> x in T) -> subgroup(S)\nbock_couple        forall C:cx, p:int: fintype(C) and prime(p) -> excouple(bock(C,p))\nbock_ip            forall C:cx, p:int, x:el: fintype(C) and x in D(bock(C,p)) -> i(bock(C,p),x) = p*x\nzs_mem             forall a:el, S:set: zsummand(a,S) -> a in S and subgroup(S)\nipow_bock          forall C:cx, p:int: fintype(C) and prime(p) -> forall m:int: 0 <= m -> forall x:el: x in D(bock(C,p)) -> ipow(bock(C,p),m,x) = p^m*x\nred_dif_wd         forall C:cx, p:int, x y:el: iscx(C) and x in Ch(C) and y in Ch(C) and ap(rh(C,p),x) = ap(rh(C,p),y) -> ap(rh(C,p),dif(C,x)) = ap(rh(C,p),dif(C,y))\ndeg_i              forall C:cx, p n:int, h:el: fintype(C) and h in H(C,n) -> i(bock(C,p),h) in H(C,n)\ndeg_j              forall C:cx, p n:int, h:el: fintype(C) and h in H(C,n) -> j(bock(C,p),h) in H(red(C,p),n)\ndeg_k              forall C:cx, p n:int, e:el: fintype(C) and prime(p) and e in H(red(C,p),n) -> k(bock(C,p),e) in H(C,n+1)\nbockstein_paper    forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C,n) and zsummand(a,H(C,n)) -> Zr(bock(C,p),r,j(bock(C,p),a)) and dzero(bock(C,p),r,j(bock(C,p),a)) and not dimg(bock(C,p),r,n-1,j(bock(C,p),a))\nbockstein_coords   forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C,n) and zsummand(a,H(C,n)) -> Zr(bock(C,p),r,j(bock(C,p),a)) and dzero(bock(C,p),r,j(bock(C,p),a)) and not dimg(bock(C,p),r,n-1,j(bock(C,p),a))\npow_add            forall p a:int: 0 <= a -> forall b:int: 0 <= b -> p^(a+b) = p^a*p^b\nunit_p             forall p z:int: 2 <= p and 1 = p*z -> false\nzpk_mem            forall a:el, S:set, p k:int: zpksummand(a,S,p,k) -> a in S and subgroup(S) and p^k*a = 0\nzpksummand_trans   forall a:el, S T:set, p k:int: zpksummand(a,S,p,k) and summand(S,T) -> zpksummand(a,T,p,k)\nzpk_unit           forall a:el, S:set, p k r:int, x y:el: zpksummand(a,S,p,k) and 2 <= p and 1 <= r and r <= k and x in S and y in S and p^(r-1)*x = 0 and a = x + p*y -> false\ncyclic_order       forall a:el, S:set, p e k:int: zpksummand(a,S,p,e) and 2 <= p and 0 <= k and k < e -> p^k*a != 0\nbockstein_torsion  forall C:cx, p n k:int, a:el: fintype(C) and prime(p) and 1 <= k and a in H(C,n) and zpksummand(a,H(C,n),p,k) -> (forall r:int: 1 <= r and r <= k -> not Br(bock(C,p),r,j(bock(C,p),a))) and Br(bock(C,p),k+1,j(bock(C,p),a))\nmodular_law        forall A B C:set: subgroup(A) and subgroup(B) and subgroup(C) and (forall x:el: x in A -> x in C) -> (forall x:el: x in ssum(A,inter(B,C)) <-> (x in ssum(A,B) and x in C))\nshort_five_mono    forall f g f2 g2 al be ga:hom, A B C A2:set: (forall x:el: x in A -> ap(f,x) in B) and (forall y:el: y in B -> ap(g,y) in C) and (forall x:el: x in A -> ap(al,x) in A2) and (forall y:el: y in B and ap(g,y) = 0 -> exists x:el: x in A and y = ap(f,x)) and (forall x:el: x in A2 and ap(f2,x) = 0 -> x = 0) and (forall x:el: x in A -> ap(be,ap(f,x)) = ap(f2,ap(al,x))) and (forall y:el: y in B -> ap(ga,ap(g,y)) = ap(g2,ap(be,y))) and (forall x:el: x in A and ap(al,x) = 0 -> x = 0) and (forall z:el: z in C and ap(ga,z) = 0 -> z = 0) -> (forall y:el: y in B and ap(be,y) = 0 -> y = 0)\nsnake_ker_exact    forall f g f2 g2 al be ga:hom, A B A2:set: (forall y:el: y in B and ap(g,y) = 0 -> exists x:el: x in A and y = ap(f,x)) and (forall x:el: x in A -> ap(al,x) in A2) and (forall x:el: x in A2 and ap(f2,x) = 0 -> x = 0) and (forall x:el: x in A -> ap(be,ap(f,x)) = ap(f2,ap(al,x))) -> (forall y:el: y in B and ap(be,y) = 0 and ap(g,y) = 0 -> exists x:el: x in A and ap(al,x) = 0 and y = ap(f,x))\n"}], "structuredContent": {"id": 239, "ok": true, "cmd": "lemmas", "ucas": "lemmas", "structured": true, "result": {"kind": "lemmas", "lemmas": [{"name": "pow_pos", "statement": "forall p:int: 1 <= p -> forall m:int: 0 <= m -> 1 <= p^m"}, {"name": "sub_zero", "statement": "forall S:set: subgroup(S) -> 0 in S"}, {"name": "sub_add", "statement": "forall S:set, x y:el: subgroup(S) and x in S and y in S -> x + y in S"}, {"name": "sub_neg", "statement": "forall S:set, x:el: subgroup(S) and x in S -> -x in S"}, {"name": "sub_natmul", "statement": "forall S:set, x:el: subgroup(S) and x in S -> forall n:int: 0 <= n -> n*x in S"}, {"name": "sub_smul", "statement": "forall S:set, n:int, x:el: subgroup(S) and x in S -> n*x in S"}, {"name": "ssum_sub", "statement": "forall A B:set: subgroup(A) and subgroup(B) -> subgroup(ssum(A,B))"}, {"name": "zsummand_trans", "statement": "forall a:el, S T:set: zsummand(a,S) and summand(S,T) -> zsummand(a,T)"}, {"name": "zsum_val", "statement": "forall a:el, S:set, p q:int, t x:el: zsummand(a,S) and 2 <= p and 1 <= q and t in S and x in S and p*t = 0 and q*a = t + (p*q)*x -> false"}, {"name": "zsum_unit", "statement": "forall a:el, S:set, p w:int, x y:el: zsummand(a,S) and 2 <= p and 1 <= w and x in S and y in S and w*x = 0 and a = x + p*y -> false"}, {"name": "ec_subD", "statement": "forall c:cpl: excouple(c) -> subgroup(D(c))"}, {"name": "ec_subE", "statement": "forall c:cpl: excouple(c) -> subgroup(E(c))"}, {"name": "ec_iD", "statement": "forall c:cpl, x:el: excouple(c) and x in D(c) -> i(c,x) in D(c)"}, {"name": "ec_jE", "statement": "forall c:cpl, x:el: excouple(c) and x in D(c) -> j(c,x) in E(c)"}, {"name": "ec_kD", "statement": "forall c:cpl, e:el: excouple(c) and e in E(c) -> k(c,e) in D(c)"}, {"name": "ec_kerj", "statement": "forall c:cpl, x:el: excouple(c) and x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)"}, {"name": "ec_ji", "statement": "forall c:cpl, x:el: excouple(c) and x in D(c) -> j(c,i(c,x)) = 0"}, {"name": "ec_kerk", "statement": "forall c:cpl, e:el: excouple(c) and e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)"}, {"name": "ec_kj", "statement": "forall c:cpl, x:el: excouple(c) and x in D(c) -> k(c,j(c,x)) = 0"}, {"name": "ec_keri", "statement": "forall c:cpl, x:el: excouple(c) and x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)"}, {"name": "ec_ik", "statement": "forall c:cpl, e:el: excouple(c) and e in E(c) -> i(c,k(c,e)) = 0"}, {"name": "ipow_add", "statement": "forall c:cpl, m:int, x y:el: ipow(c,m,x+y) = ipow(c,m,x) + ipow(c,m,y)"}, {"name": "ipow_smul", "statement": "forall c:cpl, m:int, n:int, x:el: ipow(c,m,n*x) = n*ipow(c,m,x)"}, {"name": "ipow_shift", "statement": "forall c:cpl, m:int: 0 <= m -> forall x:el: ipow(c,m+1,x) = ipow(c,m,i(c,x))"}, {"name": "ipow_D", "statement": "forall c:cpl: excouple(c) -> forall m:int, x:el: x in D(c) -> ipow(c,m,x) in D(c)"}, {"name": "closed_forms", "statement": "forall c:cpl: excouple(c) -> forall r:int: 1 <= r -> (forall y:el: Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x))) and (forall e:el: Zr(c,r,e) <-> (e in E(c) and exists x:el: x in D(c) and k(c,e) = ipow(c,r-1,x))) and (forall e:el: Br(c,r,e) <-> (exists x:el: x in D(c) and ipow(c,r-1,x) = 0 and e = j(c,x))) and (forall y e:el: Jr(c,r,y,e) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x) and Br(c,r,e - j(c,x))))"}, {"name": "cf_D", "statement": "forall c:cpl, r:int, y:el: excouple(c) and 1 <= r -> (Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x)))"}, {"name": "cf_Z", "statement": "forall c:cpl, r:int, e:el: excouple(c) and 1 <= r -> (Zr(c,r,e) <-> (e in E(c) and exists x:el: x in D(c) and k(c,e) = ipow(c,r-1,x)))"}, {"name": "cf_B", "statement": "forall c:cpl, r:int, e:el: excouple(c) and 1 <= r -> (Br(c,r,e) <-> (exists x:el: x in D(c) and ipow(c,r-1,x) = 0 and e = j(c,x)))"}, {"name": "cf_J", "statement": "forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r -> (Jr(c,r,y,e) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x) and Br(c,r,e - j(c,x))))"}, {"name": "dc_B0", "statement": "forall c:cpl, r:int: excouple(c) and 1 <= r -> Br(c,r,0)"}, {"name": "dc_Bsub", "statement": "forall c:cpl, r:int, u v:el: excouple(c) and 1 <= r and Br(c,r,u) and Br(c,r,v) -> Br(c,r,u - v)"}, {"name": "dc_Dr", "statement": "forall c:cpl, r:int, y:el: excouple(c) and 1 <= r -> (Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x)))"}, {"name": "dc_DD", "statement": "forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> y in D(c)"}, {"name": "dc_iD", "statement": "forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> Dr(c,r,i(c,y))"}, {"name": "dc_jr", "statement": "forall c:cpl, r:int, x:el: excouple(c) and 1 <= r and x in D(c) -> Jr(c,r,ipow(c,r-1,x),j(c,x))"}, {"name": "dc_Jsub", "statement": "forall c:cpl, r:int, y1 y2 e1 e2:el: excouple(c) and 1 <= r and Jr(c,r,y1,e1) and Jr(c,r,y2,e2) -> Jr(c,r,y1 - y2,e1 - e2)"}, {"name": "dc_Jwd", "statement": "forall c:cpl, r:int, y e1 e2:el: excouple(c) and 1 <= r and Jr(c,r,y,e1) and Jr(c,r,y,e2) -> Br(c,r,e1 - e2)"}, {"name": "dc_kerj", "statement": "forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) and Br(c,r,e) -> exists y2:el: Dr(c,r,y2) and y = i(c,y2)"}, {"name": "dc_imi", "statement": "forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> Jr(c,r,i(c,y),0)"}, {"name": "dc_kerk", "statement": "forall c:cpl, r:int, e:el: excouple(c) and 1 <= r and Zr(c,r,e) and k(c,e) = 0 -> exists y:el: Jr(c,r,y,e)"}, {"name": "dc_imj", "statement": "forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) -> k(c,e) = 0"}, {"name": "dc_JZ", "statement": "forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) -> Zr(c,r,e)"}, {"name": "dc_keri", "statement": "forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) and i(c,y) = 0 -> exists e:el: Zr(c,r,e) and y = k(c,e)"}, {"name": "dc_imk", "statement": "forall c:cpl, r:int, e:el: excouple(c) and 1 <= r and Zr(c,r,e) -> Dr(c,r,k(c,e)) and i(c,k(c,e)) = 0"}, {"name": "derived_exact", "statement": "forall c:cpl, r:int: excouple(c) and 1 <= r -> (forall y e:el: Jr(c,r,y,e) and Br(c,r,e) -> exists y2:el: Dr(c,r,y2) and y = i(c,y2)) and (forall y:el: Dr(c,r,y) -> Jr(c,r,i(c,y),0)) and (forall e:el: Zr(c,r,e) and k(c,e) = 0 -> exists y:el: Jr(c,r,y,e)) and (forall y e:el: Jr(c,r,y,e) -> k(c,e) = 0) and (forall y:el: Dr(c,r,y) and i(c,y) = 0 -> exists e:el: Zr(c,r,e) and y = k(c,e)) and (forall e:el: Zr(c,r,e) -> Dr(c,r,k(c,e)) and i(c,k(c,e)) = 0)"}, {"name": "dd_zero", "statement": "forall c:cpl, r:int, e f:el: excouple(c) and 1 <= r and Zr(c,r,e) and Jr(c,r,k(c,e),f) -> dzero(c,r,f)"}, {"name": "cx_sub", "statement": "forall A:cx: iscx(A) -> subgroup(Ch(A))"}, {"name": "cx_d", "statement": "forall A:cx, x:el: iscx(A) and x in Ch(A) -> dif(A,x) in Ch(A)"}, {"name": "cx_dd", "statement": "forall A:cx, x:el: iscx(A) and x in Ch(A) -> dif(A,dif(A,x)) = 0"}, {"name": "cls_zero0", "statement": "forall A:cx, h:el: iscx(A) and Cls(A,0,h) -> h = 0"}, {"name": "cls_00", "statement": "forall A:cx: iscx(A) -> Cls(A,0,0)"}, {"name": "cls_neg", "statement": "forall A:cx, z h:el: iscx(A) and Cls(A,z,h) -> Cls(A,-z,-h)"}, {"name": "cls_add", "statement": "forall A:cx, z1 z2 h1 h2:el: iscx(A) and Cls(A,z1,h1) and Cls(A,z2,h2) -> Cls(A,z1 + z2,h1 + h2)"}, {"name": "cls_eq", "statement": "forall A:cx, z1 z2 h1 h2 y:el: iscx(A) and Cls(A,z1,h1) and Cls(A,z2,h2) and y in Ch(A) and z1 - z2 = dif(A,y) -> h1 = h2"}, {"name": "cls_fun", "statement": "forall A:cx, z h1 h2:el: iscx(A) and Cls(A,z,h1) and Cls(A,z,h2) -> h1 = h2"}, {"name": "cls_rep", "statement": "forall A:cx, z1 z2 h:el: Cls(A,z1,h) and Cls(A,z2,h) -> exists y:el: y in Ch(A) and z1 - z2 = dif(A,y)"}, {"name": "cls_natmul", "statement": "forall A:cx, z h:el: iscx(A) and Cls(A,z,h) -> forall n:int: 0 <= n -> Cls(A,n*z,n*h)"}, {"name": "cls_smul", "statement": "forall A:cx, n:int, z h:el: iscx(A) and Cls(A,z,h) -> Cls(A,n*z,n*h)"}, {"name": "Hc_sub", "statement": "forall A:cx: iscx(A) -> subgroup(Hc(A))"}, {"name": "Cn_sub", "statement": "forall A:cx, n:int: iscx(A) -> subgroup(Cn(A,n))"}, {"name": "H_in", "statement": "forall A:cx, n:int, h:el: h in H(A,n) -> h in Hc(A)"}, {"name": "Hco_in", "statement": "forall A:cx, n:int, h:el: h in Hco(A,n) -> h in Hc(A)"}, {"name": "H_sub", "statement": "forall A:cx, n:int: iscx(A) -> subgroup(H(A,n))"}, {"name": "Hco_sub", "statement": "forall A:cx, n:int: iscx(A) -> subgroup(Hco(A,n))"}, {"name": "H_summand", "statement": "forall A:cx, n:int: iscx(A) -> summand(H(A,n),Hc(A))"}, {"name": "cm_A", "statement": "forall A B:cx, f:hom: chmap(A,B,f) -> iscx(A)"}, {"name": "cm_B", "statement": "forall A B:cx, f:hom: chmap(A,B,f) -> iscx(B)"}, {"name": "cm_in", "statement": "forall A B:cx, f:hom, x:el: chmap(A,B,f) and x in Ch(A) -> ap(f,x) in Ch(B)"}, {"name": "cm_d", "statement": "forall A B:cx, f:hom, x:el: chmap(A,B,f) and x in Ch(A) -> ap(f,dif(A,x)) = dif(B,ap(f,x))"}, {"name": "ss_f", "statement": "forall A B C:cx, f g:hom: isses(A,B,C,f,g) -> chmap(A,B,f)"}, {"name": "ss_g", "statement": "forall A B C:cx, f g:hom: isses(A,B,C,f,g) -> chmap(B,C,g)"}, {"name": "ss_inj", "statement": "forall A B C:cx, f g:hom, x:el: isses(A,B,C,f,g) and x in Ch(A) and ap(f,x) = 0 -> x = 0"}, {"name": "ss_sur", "statement": "forall A B C:cx, f g:hom, w:el: isses(A,B,C,f,g) and w in Ch(C) -> exists b:el: b in Ch(B) and w = ap(g,b)"}, {"name": "ss_ker", "statement": "forall A B C:cx, f g:hom, b:el: isses(A,B,C,f,g) and b in Ch(B) and ap(g,b) = 0 -> exists x:el: x in Ch(A) and b = ap(f,x)"}, {"name": "ss_gf", "statement": "forall A B C:cx, f g:hom, x:el: isses(A,B,C,f,g) and x in Ch(A) -> ap(g,ap(f,x)) = 0"}, {"name": "HM_dom", "statement": "forall A B:cx, f:hom, h h2:el: HM(A,B,f,h,h2) -> h in Hc(A) and h2 in Hc(B)"}, {"name": "Del_dom", "statement": "forall A B C:cx, f g:hom, e h:el: Del(A,B,C,f,g,e,h) -> e in Hc(C) and h in Hc(A)"}, {"name": "HM_tot", "statement": "forall A B:cx, f:hom, h:el: chmap(A,B,f) and h in Hc(A) -> exists h2:el: HM(A,B,f,h,h2)"}, {"name": "HM_fun", "statement": "forall A B:cx, f:hom, h h1 h2:el: chmap(A,B,f) and HM(A,B,f,h,h1) and HM(A,B,f,h,h2) -> h1 = h2"}, {"name": "Del_tot", "statement": "forall A B C:cx, f g:hom, e:el: isses(A,B,C,f,g) and e in Hc(C) -> exists h:el: Del(A,B,C,f,g,e,h)"}, {"name": "Del_fun", "statement": "forall A B C:cx, f g:hom, e h1 h2:el: isses(A,B,C,f,g) and Del(A,B,C,f,g,e,h1) and Del(A,B,C,f,g,e,h2) -> h1 = h2"}, {"name": "les_fg", "statement": "forall A B C:cx, f g:hom, h h2 h3:el: isses(A,B,C,f,g) and HM(A,B,f,h,h2) and HM(B,C,g,h2,h3) -> h3 = 0"}, {"name": "les_kerg", "statement": "forall A B C:cx, f g:hom, h2:el: isses(A,B,C,f,g) and h2 in Hc(B) and HM(B,C,g,h2,0) -> exists h:el: HM(A,B,f,h,h2)"}, {"name": "les_gdel", "statement": "forall A B C:cx, f g:hom, h2 e h:el: isses(A,B,C,f,g) and HM(B,C,g,h2,e) and Del(A,B,C,f,g,e,h) -> h = 0"}, {"name": "les_kerdel", "statement": "forall A B C:cx, f g:hom, e:el: isses(A,B,C,f,g) and Del(A,B,C,f,g,e,0) -> exists h2:el: HM(B,C,g,h2,e)"}, {"name": "les_delf", "statement": "forall A B C:cx, f g:hom, e h h2:el: isses(A,B,C,f,g) and Del(A,B,C,f,g,e,h) and HM(A,B,f,h,h2) -> h2 = 0"}, {"name": "les_kerf", "statement": "forall A B C:cx, f g:hom, h:el: isses(A,B,C,f,g) and h in Hc(A) and HM(A,B,f,h,0) -> exists e:el: Del(A,B,C,f,g,e,h)"}, {"name": "les_exact", "statement": "forall A B C:cx, f g:hom: isses(A,B,C,f,g) -> (forall h h2 h3:el: HM(A,B,f,h,h2) and HM(B,C,g,h2,h3) -> h3 = 0) and (forall h2:el: h2 in Hc(B) and HM(B,C,g,h2,0) -> exists h:el: HM(A,B,f,h,h2)) and (forall h2 e h:el: HM(B,C,g,h2,e) and Del(A,B,C,f,g,e,h) -> h = 0) and (forall e:el: Del(A,B,C,f,g,e,0) -> exists h2:el: HM(B,C,g,h2,e)) and (forall e h h2:el: Del(A,B,C,f,g,e,h) and HM(A,B,f,h,h2) -> h2 = 0) and (forall h:el: h in Hc(A) and HM(A,B,f,h,0) -> exists e:el: Del(A,B,C,f,g,e,h))"}, {"name": "prime_ge2", "statement": "forall p:int: prime(p) -> 2 <= p"}, {"name": "red_cx", "statement": "forall C:cx, p:int: iscx(C) -> iscx(red(C,p))"}, {"name": "isses_bock", "statement": "forall C:cx, p:int: fintype(C) and prime(p) -> isses(C,C,red(C,p),mulp(p),rh(C,p))"}, {"name": "sub_eqv", "statement": "forall S T:set: subgroup(T) and (forall x:el: x in S <-> x in T) -> subgroup(S)"}, {"name": "bock_couple", "statement": "forall C:cx, p:int: fintype(C) and prime(p) -> excouple(bock(C,p))"}, {"name": "bock_ip", "statement": "forall C:cx, p:int, x:el: fintype(C) and x in D(bock(C,p)) -> i(bock(C,p),x) = p*x"}, {"name": "zs_mem", "statement": "forall a:el, S:set: zsummand(a,S) -> a in S and subgroup(S)"}, {"name": "ipow_bock", "statement": "forall C:cx, p:int: fintype(C) and prime(p) -> forall m:int: 0 <= m -> forall x:el: x in D(bock(C,p)) -> ipow(bock(C,p),m,x) = p^m*x"}, {"name": "red_dif_wd", "statement": "forall C:cx, p:int, x y:el: iscx(C) and x in Ch(C) and y in Ch(C) and ap(rh(C,p),x) = ap(rh(C,p),y) -> ap(rh(C,p),dif(C,x)) = ap(rh(C,p),dif(C,y))"}, {"name": "deg_i", "statement": "forall C:cx, p n:int, h:el: fintype(C) and h in H(C,n) -> i(bock(C,p),h) in H(C,n)"}, {"name": "deg_j", "statement": "forall C:cx, p n:int, h:el: fintype(C) and h in H(C,n) -> j(bock(C,p),h) in H(red(C,p),n)"}, {"name": "deg_k", "statement": "forall C:cx, p n:int, e:el: fintype(C) and prime(p) and e in H(red(C,p),n) -> k(bock(C,p),e) in H(C,n+1)"}, {"name": "bockstein_paper", "statement": "forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C,n) and zsummand(a,H(C,n)) -> Zr(bock(C,p),r,j(bock(C,p),a)) and dzero(bock(C,p),r,j(bock(C,p),a)) and not dimg(bock(C,p),r,n-1,j(bock(C,p),a))"}, {"name": "bockstein_coords", "statement": "forall C:cx, p n r:int, a:el: fintype(C) and prime(p) and 0 <= n and 1 <= r and a in H(C,n) and zsummand(a,H(C,n)) -> Zr(bock(C,p),r,j(bock(C,p),a)) and dzero(bock(C,p),r,j(bock(C,p),a)) and not dimg(bock(C,p),r,n-1,j(bock(C,p),a))"}, {"name": "pow_add", "statement": "forall p a:int: 0 <= a -> forall b:int: 0 <= b -> p^(a+b) = p^a*p^b"}, {"name": "unit_p", "statement": "forall p z:int: 2 <= p and 1 = p*z -> false"}, {"name": "zpk_mem", "statement": "forall a:el, S:set, p k:int: zpksummand(a,S,p,k) -> a in S and subgroup(S) and p^k*a = 0"}, {"name": "zpksummand_trans", "statement": "forall a:el, S T:set, p k:int: zpksummand(a,S,p,k) and summand(S,T) -> zpksummand(a,T,p,k)"}, {"name": "zpk_unit", "statement": "forall a:el, S:set, p k r:int, x y:el: zpksummand(a,S,p,k) and 2 <= p and 1 <= r and r <= k and x in S and y in S and p^(r-1)*x = 0 and a = x + p*y -> false"}, {"name": "cyclic_order", "statement": "forall a:el, S:set, p e k:int: zpksummand(a,S,p,e) and 2 <= p and 0 <= k and k < e -> p^k*a != 0"}, {"name": "bockstein_torsion", "statement": "forall C:cx, p n k:int, a:el: fintype(C) and prime(p) and 1 <= k and a in H(C,n) and zpksummand(a,H(C,n),p,k) -> (forall r:int: 1 <= r and r <= k -> not Br(bock(C,p),r,j(bock(C,p),a))) and Br(bock(C,p),k+1,j(bock(C,p),a))"}, {"name": "modular_law", "statement": "forall A B C:set: subgroup(A) and subgroup(B) and subgroup(C) and (forall x:el: x in A -> x in C) -> (forall x:el: x in ssum(A,inter(B,C)) <-> (x in ssum(A,B) and x in C))"}, {"name": "short_five_mono", "statement": "forall f g f2 g2 al be ga:hom, A B C A2:set: (forall x:el: x in A -> ap(f,x) in B) and (forall y:el: y in B -> ap(g,y) in C) and (forall x:el: x in A -> ap(al,x) in A2) and (forall y:el: y in B and ap(g,y) = 0 -> exists x:el: x in A and y = ap(f,x)) and (forall x:el: x in A2 and ap(f2,x) = 0 -> x = 0) and (forall x:el: x in A -> ap(be,ap(f,x)) = ap(f2,ap(al,x))) and (forall y:el: y in B -> ap(ga,ap(g,y)) = ap(g2,ap(be,y))) and (forall x:el: x in A and ap(al,x) = 0 -> x = 0) and (forall z:el: z in C and ap(ga,z) = 0 -> z = 0) -> (forall y:el: y in B and ap(be,y) = 0 -> y = 0)"}, {"name": "snake_ker_exact", "statement": "forall f g f2 g2 al be ga:hom, A B A2:set: (forall y:el: y in B and ap(g,y) = 0 -> exists x:el: x in A and y = ap(f,x)) and (forall x:el: x in A -> ap(al,x) in A2) and (forall x:el: x in A2 and ap(f2,x) = 0 -> x = 0) and (forall x:el: x in A -> ap(be,ap(f,x)) = ap(f2,ap(al,x))) -> (forall y:el: y in B and ap(be,y) = 0 and ap(g,y) = 0 -> exists x:el: x in A and ap(al,x) = 0 and y = ap(f,x))"}]}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "pow_pos            forall p:int: 1 <= p -> forall m:int: 0 <= m -> 1 <= p^m\nsub_zero           forall S:set: subgroup(S) -> 0 in S\nsub_add            forall S:set, x y:el: subgroup(S) and x in S and y in S -> x + y in S\nsub_neg            forall S:set, x:el: subgroup(S) and x in S -> -x in S\nsub_natmul         forall S:set, x:el: subgroup(S) and x in S -> forall n:int: 0 <= n -> n*x in S\nsub_smul           forall S:set, n:int, x:el: subgroup(S) and x in S -> n*x in S\nssum_sub           forall A B:set: subgroup(A) and subgroup(B) -> subgroup(ssum(A,B))\nzsummand_trans     forall a:el, S T:set: zsummand(a,S) and summand(S,T) -> zsummand(a,T)\nzsum_val           forall a:el, S:set, p q:int, t x:el: zsummand(a,S) and 2 <= p and 1 <= q and t in S and x in S and p*t = 0 and q*a = t + (p*q)*x -> false\nzsum_unit          forall a:el, S:set, p w:int, x y:el: zsummand(a,S) and 2 <= p and 1 <= w and x in S and y in S and w*x = 0 and a = x + p*y -> false\nec_subD            forall c:cpl: excouple(c) -> subgroup(D(c))\nec_subE            forall c:cpl: excouple(c) -> subgroup(E(c))\nec_iD              forall c:cpl, x:el: excouple(c) and x in D(c) -> i(c,x) in D(c)\nec_jE              forall c:cpl, x:el: excouple(c) and x in D(c) -> j(c,x) in E(c)\nec_kD              forall c:cpl, e:el: excouple(c) and e in E(c) -> k(c,e) in D(c)\nec_kerj            forall c:cpl, x:el: excouple(c) and x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)\nec_ji              forall c:cpl, x:el: excouple(c) and x in D(c) -> j(c,i(c,x)) = 0\nec_kerk            forall c:cpl, e:el: excouple(c) and e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)\nec_kj              forall c:cpl, x:el: excouple(c) and x in D(c) -> k(c,j(c,x)) = 0\nec_keri            forall c:cpl, x:el: excouple(c) and x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)\nec_ik              forall c:cpl, e:el: excouple(c) and e in E(c) -> i(c,k(c,e)) = 0\nipow_add           forall c:cpl, m:int, x y:el: ipow(c,m,x+y) = ipow(c,m,x) + ipow(c,m,y)\nipow_smul          forall c:cpl, m:int, n:int, x:el: ipow(c,m,n*x) = n*ipow(c,m,x)\nipow_shift         forall c:cpl, m:int: 0 <= m -> forall x:el: ipow(c,m+1,x) = ipow(c,m,i(c,x))\nipow_D             forall c:cpl: excouple(c) -> forall m:int, x:el: x in D(c) -> ipow(c,m,x) in D(c)\nclosed_forms       forall c:cpl: excouple(c) -> forall r:int: 1 <= r -> (forall y:el: Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x))) and (forall e:el: Zr(c,r,e) <-> (e in E(c) and exists x:el: x in D(c) and k(c,e) = ipow(c,r-1,x))) and (forall e:el: Br(c,r,e) <-> (exists x:el: x in D(c) and ipow(c,r-1,x) = 0 and e = j(c,x))) and (forall y e:el: Jr(c,r,y,e) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x) and Br(c,r,e - j(c,x))))\ncf_D               forall c:cpl, r:int, y:el: excouple(c) and 1 <= r -> (Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x)))\ncf_Z               forall c:cpl, r:int, e:el: excouple(c) and 1 <= r -> (Zr(c,r,e) <-> (e in E(c) and exists x:el: x in D(c) and k(c,e) = ipow(c,r-1,x)))\ncf_B               forall c:cpl, r:int, e:el: excouple(c) and 1 <= r -> (Br(c,r,e) <-> (exists x:el: x in D(c) and ipow(c,r-1,x) = 0 and e = j(c,x)))\ncf_J               forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r -> (Jr(c,r,y,e) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x) and Br(c,r,e - j(c,x))))\ndc_B0              forall c:cpl, r:int: excouple(c) and 1 <= r -> Br(c,r,0)\ndc_Bsub            forall c:cpl, r:int, u v:el: excouple(c) and 1 <= r and Br(c,r,u) and Br(c,r,v) -> Br(c,r,u - v)\ndc_Dr              forall c:cpl, r:int, y:el: excouple(c) and 1 <= r -> (Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x)))\ndc_DD              forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> y in D(c)\ndc_iD              forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> Dr(c,r,i(c,y))\ndc_jr              forall c:cpl, r:int, x:el: excouple(c) and 1 <= r and x in D(c) -> Jr(c,r,ipow(c,r-1,x),j(c,x))\ndc_Jsub            forall c:cpl, r:int, y1 y2 e1 e2:el: excouple(c) and 1 <= r and Jr(c,r,y1,e1) and Jr(c,r,y2,e2) -> Jr(c,r,y1 - y2,e1 - e2)\ndc_Jwd             forall c:cpl, r:int, y e1 e2:el: excouple(c) and 1 <= r and Jr(c,r,y,e1) and Jr(c,r,y,e2) -> Br(c,r,e1 - e2)\ndc_kerj            forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) and Br(c,r,e) -> exists y2:el: Dr(c,r,y2) and y = i(c,y2)\ndc_imi             forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> Jr(c,r,i(c,y),0)\ndc_kerk            forall c:cpl, r:int, e:el: excouple(c) and 1 <= r and Zr(c,r,e) and k(c,e) = 0 -> exists y:el: Jr(c,r,y,e)\ndc_imj             forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) -> k(c,e) = 0\ndc_JZ              forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) -> Zr(c,r,e)\ndc_keri            forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) and i(c,y) = 0 -> exists e:el: Zr(c,r,e) and y = k(c,e)\ndc_imk             forall c:cpl, r:int, e:el: excouple(c) and 1 <= r and Zr(c,r,e) -> Dr(c,r,k(c,e)) and i(c,k(c,e)) = 0\nderived_exact      forall c:cpl, r:int: excouple(c) and 1 <= r -> (forall y e:el: Jr(c,r,y,e) and Br(c,r,e) -> exists y2:el: Dr(c,r,y2) and y = i(c,y2)) and (forall y:el: Dr(c,r,y) -> Jr(c,r,i(c,y),0)) and (forall e:el: Zr(c,r,e) and k(c,e) = 0 -> exists y:el: Jr(c,r,y,e)) and (forall y e:el: Jr(c,r,y,e) -> k(c,e) = 0) and (forall y:el: Dr(c,r,y) and i(c,y) = 0 -> exists e:el: Zr(c,r,e) and y = k(c,e)) and (forall e:el: Zr(c,r,e) -> Dr(c,r,k(c,e)) and i(c,k(c,e)) = 0)\ndd_zero            forall c:cpl, r:int, e f:el: excouple(c) and 1 <= r and Zr(c,r,e) and Jr(c,r,k(c,e),f) -> dzero(c,r,f)\ncx_sub             forall A:cx: iscx(A) -> subgroup(Ch(A))\ncx_d               forall A:cx, x:el: iscx(A) and x in Ch(A) -> dif(A,x) in Ch(A)\ncx_dd              forall A:cx, x:el: iscx(A) and x in Ch(A) -> dif(A,dif(A,x)) = 0\ncls_zero0          forall A:cx, h:el: iscx(A) and Cls(A,0,h) -> h = 0\ncls_00             forall A:cx: iscx(A) -> Cls(A,0,0)\ncls_neg            forall A:cx, z h:el: iscx(A) and Cls(A,z,h) -> Cls(A,-z,-h)\ncls_add            forall A:cx, z1 z2 h1 h2:el: iscx(A) and Cls(A,z1,h1) and Cls(A,z2,h2) -> Cls(A,z1 + z2,h1 + h2)\ncls_eq             forall A:cx, z1 z2 h1 h2 y:el: iscx(A) and Cls(A,z1,h1) and Cls(A,z2,h2) and y in Ch(A) and z1 - z2 = dif(A,y) -> h1 = h2\ncls_fun            forall A:cx, z h1 h2:el: iscx(A) and Cls(A,z,h1) and Cls(A,z,h2) -> h1 = h2\ncls_rep            forall A:cx, z1 z2 h:el: Cls(A,z1,h) and Cls(A,z2,h) -> exists y:el: y in Ch(A) and z1 - z2 = dif(A,y)\ncls_natmul         forall A:cx, z h:el: iscx(A) and Cls(A,z,h) -> forall n:int: 0 <= n -> Cls(A,n*z,n*h)\ncls_smul           forall A:cx, n:int, z h:el: iscx(A) and Cls(A,z,h) -> Cls(A,n*z,n*h)\nHc_sub             forall A:cx: iscx(A) -> subgroup(Hc(A))\nCn_sub             forall A:cx, n:int: iscx(A) -> subgroup(Cn(A,n))\nH_in               forall A:cx, n:int, h:el: h in H(A,n) -> h in Hc(A)\nHco_in             forall A:cx, n:int, h:el: h in Hco(A,n) -> h in Hc(A)\nH_sub              forall A:cx, n:int: iscx(A) -> subgroup(H(A,n))\nHco_sub            forall A:cx, n:int: iscx(A) -> subgroup(Hco(A,n))\nH_summand          forall A:cx, n:int: iscx(A) -> summand(H(A,n),Hc(A))\ncm_A               forall A B:cx, f:hom: chmap(A,B,f) -> iscx(A)\ncm_B               forall A B:cx, f:hom: