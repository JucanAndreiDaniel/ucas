d (forall e:el: e in E(c) -> k(c,e) in D(c)) and (forall x:el: x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)) and (forall x:el: x in D(c) -> j(c,i(c,x)) = 0) and (forall e:el: e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)) and (forall x:el: x in D(c) -> k(c,j(c,x)) = 0) and (forall x:el: x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)) and (forall e:el: e in E(c) -> i(c,k(c,e)) = 0))"}, {"name": "ipow_zero", "kind": "definition", "statement": "forall c:cpl, x:el: ipow(c,0,x) = x"}, {"name": "ipow_succ", "kind": "definition", "statement": "forall c:cpl, m:int, x:el: 0 <= m -> ipow(c,m+1,x) = i(c,ipow(c,m,x))"}, {"name": "ipow_neg", "kind": "definition", "statement": "forall c:cpl, m:int, x:el: m < 0 -> ipow(c,m,x) = 0"}, {"name": "D1_def", "kind": "definition", "statement": "forall c:cpl, x:el: Dr(c,1,x) <-> x in D(c)"}, {"name": "Z1_def", "kind": "definition", "statement": "forall c:cpl, e:el: Zr(c,1,e) <-> e in E(c)"}, {"name": "B1_def", "kind": "definition", "statement": "forall c:cpl, e:el: Br(c,1,e) <-> e = 0"}, {"name": "J1_def", "kind": "definition", "statement": "forall c:cpl, x e:el: Jr(c,1,x,e) <-> (x in D(c) and e = j(c,x))"}, {"name": "Dsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, y:el: 1 <= r -> (Dr(c,r+1,y) <-> (exists x:el: Dr(c,r,x) and y = i(c,x)))"}, {"name": "Zsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, e:el: 1 <= r -> (Zr(c,r+1,e) <-> (Zr(c,r,e) and exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f)))"}, {"name": "Bsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, e:el: 1 <= r -> (Br(c,r+1,e) <-> (exists e0 f:el: Zr(c,r,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f)))"}, {"name": "Jsucc_def", "kind": "definition", "statement": "forall c:cpl, r:int, y e:el: 1 <= r -> (Jr(c,r+1,y,e) <-> (exists x f:el: Dr(c,r,x) and y = i(c,x) and Jr(c,r,x,f) and Br(c,r+1,e - f)))"}, {"name": "dzero_def", "kind": "definition", "statement": "forall c:cpl, r:int, e:el: dzero(c,r,e) <-> (exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f))"}, {"name": "dimg_def", "kind": "definition", "statement": "forall c:cpl, r m:int, e:el: dimg(c,r,m,e) <-> (exists e0 f:el: Zr(c,r,e0) and Edeg(c,m,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f))"}, {"name": "iscx_def", "kind": "definition", "statement": "forall A:cx: iscx(A) <-> (subgroup(Ch(A)) and (forall x:el: x in Ch(A) -> dif(A,x) in Ch(A)) and (forall x:el: x in Ch(A) -> dif(A,dif(A,x)) = 0))"}, {"name": "cls_dom", "kind": "definition", "statement": "forall A:cx, z h:el: Cls(A,z,h) -> z in Ch(A) and dif(A,z) = 0 and h in Hc(A)"}, {"name": "cls_tot", "kind": "definition", "statement": "forall A:cx, z:el: z in Ch(A) and dif(A,z) = 0 -> exists h:el: Cls(A,z,h)"}, {"name": "cls_sur", "kind": "definition", "statement": "forall A:cx, h:el: h in Hc(A) -> exists z:el: Cls(A,z,h)"}, {"name": "cls_sub", "kind": "definition", "statement": "forall A:cx, z1 z2 h1 h2:el: Cls(A,z1,h1) and Cls(A,z2,h2) -> Cls(A,z1 - z2,h1 - h2)"}, {"name": "cls_zero", "kind": "definition", "statement": "forall A:cx, z h:el: Cls(A,z,h) -> (h = 0 <-> (exists y:el: y in Ch(A) and z = dif(A,y)))"}, {"name": "proj_in", "kind": "definition", "statement": "forall A:cx, n:int, x:el: x in Ch(A) -> proj(A,n,x) in Cn(A,n)"}, {"name": "Cn_ch", "kind": "definition", "statement": "forall A:cx, n:int, x:el: x in Cn(A,n) -> x in Ch(A)"}, {"name": "proj_id", "kind": "definition", "statement": "forall A:cx, n:int, x:el: x in Cn(A,n) -> proj(A,n,x) = x"}, {"name": "proj_dif", "kind": "definition", "statement": "forall A:cx, n:int, x:el: x in Ch(A) -> proj(A,n+1,dif(A,x)) = dif(A,proj(A,n,x))"}, {"name": "H_def", "kind": "definition", "statement": "forall A:cx, n:int, h:el: h in H(A,n) <-> (exists z:el: z in Cn(A,n) and Cls(A,z,h))"}, {"name": "Hco_def", "kind": "definition", "statement": "forall A:cx, n:int, h:el: h in Hco(A,n) <-> (exists z:el: z in Ch(A) and proj(A,n,z) = 0 and Cls(A,z,h))"}, {"name": "chmap_def", "kind": "definition", "statement": "forall A B:cx, f:hom: chmap(A,B,f) <-> (iscx(A) and iscx(B) and (forall x:el: x in Ch(A) -> ap(f,x) in Ch(B)) and (forall x:el: x in Ch(A) -> ap(f,dif(A,x)) = dif(B,ap(f,x))))"}, {"name": "isses_def", "kind": "definition", "statement": "forall A B C:cx, f g:hom: isses(A,B,C,f,g) <-> (chmap(A,B,f) and chmap(B,C,g) and (forall x:el: x in Ch(A) and ap(f,x) = 0 -> x = 0) and (forall w:el: w in Ch(C) -> exists b:el: b in Ch(B) and w = ap(g,b)) and (forall b:el: b in Ch(B) and ap(g,b) = 0 -> exists x:el: x in Ch(A) and b = ap(f,x)) and (forall x:el: x in Ch(A) -> ap(g,ap(f,x)) = 0))"}, {"name": "HM_def", "kind": "definition", "statement": "forall A B:cx, f:hom, h h2:el: HM(A,B,f,h,h2) <-> (exists z:el: Cls(A,z,h) and Cls(B,ap(f,z),h2))"}, {"name": "Del_def", "kind": "definition", "statement": "forall A B C:cx, f g:hom, e h:el: Del(A,B,C,f,g,e,h) <-> (exists w b z:el: Cls(C,w,e) and b in Ch(B) and w = ap(g,b) and z in Ch(A) and ap(f,z) = dif(B,b) and Cls(A,z,h))"}, {"name": "mulp_def", "kind": "definition", "statement": "forall p:int, x:el: ap(mulp(p),x) = p*x"}, {"name": "red_ch", "kind": "definition", "statement": "forall C:cx, p:int, w:el: w in Ch(red(C,p)) <-> (exists x:el: x in Ch(C) and w = ap(rh(C,p),x))"}, {"name": "red_ker", "kind": "definition", "statement": "forall C:cx, p:int, x:el: x in Ch(C) -> (ap(rh(C,p),x) = 0 <-> (exists y:el: y in Ch(C) and x = p*y))"}, {"name": "red_dif", "kind": "definition", "statement": "forall C:cx, p:int, x:el: x in Ch(C) -> dif(red(C,p),ap(rh(C,p),x)) = ap(rh(C,p),dif(C,x))"}, {"name": "red_Cn", "kind": "definition", "statement": "forall C:cx, p n:int, w:el: w in Cn(red(C,p),n) <-> (exists x:el: x in Cn(C,n) and w = ap(rh(C,p),x))"}, {"name": "fintype_def", "kind": "definition", "statement": "forall C:cx: fintype(C) <-> (iscx(C) and (forall m:int, x:el: x in Ch(C) and 1 <= m and m*x = 0 -> x = 0))"}, {"name": "prime_def", "kind": "definition", "statement": "forall p:int: prime(p) <-> (2 <= p and (forall d q:int: 1 <= d and p = d*q -> d = 1 or d = p))"}, {"name": "bock_D", "kind": "definition", "statement": "forall C:cx, p:int, x:el: x in D(bock(C,p)) <-> x in Hc(C)"}, {"name": "bock_E", "kind": "definition", "statement": "forall C:cx, p:int, x:el: x in E(bock(C,p)) <-> x in Hc(red(C,p))"}, {"name": "bock_i", "kind": "definition", "statement": "forall C:cx, p:int, h h2:el: HM(C,C,mulp(p),h,h2) -> i(bock(C,p),h) = h2"}, {"name": "bock_j", "kind": "definition", "statement": "forall C:cx, p:int, h h2:el: HM(C,red(C,p),rh(C,p),h,h2) -> j(bock(C,p),h) = h2"}, {"name": "bock_k", "kind": "definition", "statement": "forall C:cx, p:int, e h:el: Del(C,C,red(C,p),mulp(p),rh(C,p),e,h) -> k(bock(C,p),e) = h"}, {"name": "bock_Edeg", "kind": "definition", "statement": "forall C:cx, p m:int, e:el: Edeg(bock(C,p),m,e) <-> e in H(red(C,p),m)"}, {"name": "inter_def", "kind": "definition", "statement": "forall A B:set, x:el: x in inter(A,B) <-> (x in A and x in B)"}]}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "int_discrete   [integer arithmetic] forall n:int: n <= 0 or 1 <= n\nle_antisym     [integer arithmetic] forall a:int: 0 <= a and 0 <= -a -> a = 0\nmul_nonneg     [integer arithmetic] forall a b:int: 0 <= a and 0 <= b -> 0 <= a*b\nint_domain     [integer arithmetic] forall a b:int: a*b = 0 -> a = 0 or b = 0\npow_zero       [integer arithmetic] forall a:int: a^0 = 1\npow_succ       [integer arithmetic] forall a m:int: 0 <= m -> a^(m+1) = a^m*a\nsubgroup_def   [definition] forall S:set: subgroup(S) <-> (0 in S and (forall x y:el: x in S and y in S -> x + y in S) and (forall x:el: x in S -> -x in S))\nssum_def       [definition] forall A B:set, x:el: x in ssum(A,B) <-> (exists a b:el: a in A and b in B and x = a + b)\nsummand_def    [definition] forall S T:set: summand(S,T) <-> (exists M:set: subgroup(S) and subgroup(T) and subgroup(M) and (forall x:el: x in S -> x in T) and (forall x:el: x in M -> x in T) and (forall x:el: x in T -> exists s m:el: s in S and m in M and x = s + m) and (forall s m:el: s in S and m in M and s + m = 0 -> s = 0))\nzsummand_def   [definition] forall a:el, S:set: zsummand(a,S) <-> (exists M:set: a in S and subgroup(S) and subgroup(M) and (forall x:el: x in M -> x in S) and (forall x:el: x in S -> exists n:int, m:el: m in M and x = n*a + m) and (forall n:int, m:el: m in M and n*a + m = 0 -> n = 0))\nzpksummand_def [definition] forall a:el, S:set, p k:int: zpksummand(a,S,p,k) <-> (exists M:set: a in S and subgroup(S) and subgroup(M) and p^k*a = 0 and (forall x:el: x in M -> x in S) and (forall x:el: x in S -> exists n:int, m:el: m in M and x = n*a + m) and (forall n:int, m:el: m in M and n*a + m = 0 -> exists q:int: n = p^k*q))\nexcouple_def   [definition] forall c:cpl: excouple(c) <-> (subgroup(D(c)) and subgroup(E(c)) and (forall x:el: x in D(c) -> i(c,x) in D(c)) and (forall x:el: x in D(c) -> j(c,x) in E(c)) and (forall e:el: e in E(c) -> k(c,e) in D(c)) and (forall x:el: x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)) and (forall x:el: x in D(c) -> j(c,i(c,x)) = 0) and (forall e:el: e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)) and (forall x:el: x in D(c) -> k(c,j(c,x)) = 0) and (forall x:el: x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)) and (forall e:el: e in E(c) -> i(c,k(c,e)) = 0))\nipow_zero      [definition] forall c:cpl, x:el: ipow(c,0,x) = x\nipow_succ      [definition] forall c:cpl, m:int, x:el: 0 <= m -> ipow(c,m+1,x) = i(c,ipow(c,m,x))\nipow_neg       [definition] forall c:cpl, m:int, x:el: m < 0 -> ipow(c,m,x) = 0\nD1_def         [definition] forall c:cpl, x:el: Dr(c,1,x) <-> x in D(c)\nZ1_def         [definition] forall c:cpl, e:el: Zr(c,1,e) <-> e in E(c)\nB1_def         [definition] forall c:cpl, e:el: Br(c,1,e) <-> e = 0\nJ1_def         [definition] forall c:cpl, x e:el: Jr(c,1,x,e) <-> (x in D(c) and e = j(c,x))\nDsucc_def      [definition] forall c:cpl, r:int, y:el: 1 <= r -> (Dr(c,r+1,y) <-> (exists x:el: Dr(c,r,x) and y = i(c,x)))\nZsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Zr(c,r+1,e) <-> (Zr(c,r,e) and exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f)))\nBsucc_def      [definition] forall c:cpl, r:int, e:el: 1 <= r -> (Br(c,r+1,e) <-> (exists e0 f:el: Zr(c,r,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f)))\nJsucc_def      [definition] forall c:cpl, r:int, y e:el: 1 <= r -> (Jr(c,r+1,y,e) <-> (exists x f:el: Dr(c,r,x) and y = i(c,x) and Jr(c,r,x,f) and Br(c,r+1,e - f)))\ndzero_def      [definition] forall c:cpl, r:int, e:el: dzero(c,r,e) <-> (exists f:el: Jr(c,r,k(c,e),f) and Br(c,r,f))\ndimg_def       [definition] forall c:cpl, r m:int, e:el: dimg(c,r,m,e) <-> (exists e0 f:el: Zr(c,r,e0) and Edeg(c,m,e0) and Jr(c,r,k(c,e0),f) and Br(c,r,e - f))\niscx_def       [definition] forall A:cx: iscx(A) <-> (subgroup(Ch(A)) and (forall x:el: x in Ch(A) -> dif(A,x) in Ch(A)) and (forall x:el: x in Ch(A) -> dif(A,dif(A,x)) = 0))\ncls_dom        [definition] forall A:cx, z h:el: Cls(A,z,h) -> z in Ch(A) and dif(A,z) = 0 and h in Hc(A)\ncls_tot        [definition] forall A:cx, z:el: z in Ch(A) and dif(A,z) = 0 -> exists h:el: Cls(A,z,h)\ncls_sur        [definition] forall A:cx, h:el: h in Hc(A) -> exists z:el: Cls(A,z,h)\ncls_sub        [definition] forall A:cx, z1 z2 h1 h2:el: Cls(A,z1,h1) and Cls(A,z2,h2) -> Cls(A,z1 - z2,h1 - h2)\ncls_zero       [definition] forall A:cx, z h:el: Cls(A,z,h) -> (h = 0 <-> (exists y:el: y in Ch(A) and z = dif(A,y)))\nproj_in        [definition] forall A:cx, n:int, x:el: x in Ch(A) -> proj(A,n,x) in Cn(A,n)\nCn_ch          [definition] forall A:cx, n:int, x:el: x in Cn(A,n) -> x in Ch(A)\nproj_id        [definition] forall A:cx, n:int, x:el: x in Cn(A,n) -> proj(A,n,x) = x\nproj_dif       [definition] forall A:cx, n:int, x:el: x in Ch(A) -> proj(A,n+1,dif(A,x)) = dif(A,proj(A,n,x))\nH_def          [definition] forall A:cx, n:int, h:el: h in H(A,n) <-> (exists z:el: z in Cn(A,n) and Cls(A,z,h))\nHco_def        [definition] forall A:cx, n:int, h:el: h in Hco(A,n) <-> (exists z:el: z in Ch(A) and proj(A,n,z) = 0 and Cls(A,z,h))\nchmap_def      [definition] forall A B:cx, f:hom: chmap(A,B,f) <-> (iscx(A) and iscx(B) and (forall x:el: x in Ch(A) -> ap(f,x) in Ch(B)) and (forall x:el: x in Ch(A) -> ap(f,dif(A,x)) = dif(B,ap(f,x))))\nisses_def      [definition] forall A B C:cx, f g:hom: isses(A,B,C,f,g) <-> (chmap(A,B,f) and chmap(B,C,g) and (forall x:el: x in Ch(A) and ap(f,x) = 0 -> x = 0) and (forall w:el: w in Ch(C) -> exists b:el: b in Ch(B) and w = ap(g,b)) and (forall b:el: b in Ch(B) and ap(g,b) = 0 -> exists x:el: x in Ch(A) and b = ap(f,x)) and (forall x:el: x in Ch(A) -> ap(g,ap(f,x)) = 0))\nHM_def         [definition] forall A B:cx, f:hom, h h2:el: HM(A,B,f,h,h2) <-> (exists z:el: Cls(A,z,h) and Cls(B,ap(f,z),h2))\nDel_def        [definition] forall A B C:cx, f g:hom, e h:el: Del(A,B,C,f,g,e,h) <-> (exists w b z:el: Cls(C,w,e) and b in Ch(B) and w = ap(g,b) and z in Ch(A) and ap(f,z) = dif(B,b) and Cls(A,z,h))\nmulp_def       [definition] forall p:int, x:el: ap(mulp(p),x) = p*x\nred_ch         [definition] forall C:cx, p:int, w:el: w in Ch(red(C,p)) <-> (exists x:el: x in Ch(C) and w = ap(rh(C,p),x))\nred_ker        [definition] forall C:cx, p:int, x:el: x in Ch(C) -> (ap(rh(C,p),x) = 0 <-> (exists y:el: y in Ch(C) and x = p*y))\nred_dif        [definition] forall C:cx, p:int, x:el: x in Ch(C) -> dif(red(C,p),ap(rh(C,p),x)) = ap(rh(C,p),dif(C,x))\nred_Cn         [definition] forall C:cx, p n:int, w:el: w in Cn(red(C,p),n) <-> (exists x:el: x in Cn(C,n) and w = ap(rh(C,p),x))\nfintype_def    [definition] forall C:cx: fintype(C) <-> (iscx(C) and (forall m:int, x:el: x in Ch(C) and 1 <= m and m*x = 0 -> x = 0))\nprime_def      [definition] forall p:int: prime(p) <-> (2 <= p and (forall d q:int: 1 <= d and p = d*q -> d = 1 or d = p))\nbock_D         [definition] forall C:cx, p:int, x:el: x in D(bock(C,p)) <-> x in Hc(C)\nbock_E         [definition] forall C:cx, p:int, x:el: x in E(bock(C,p)) <-> x in Hc(red(C,p))\nbock_i         [definition] forall C:cx, p:int, h h2:el: HM(C,C,mulp(p),h,h2) -> i(bock(C,p),h) = h2\nbock_j         [definition] forall C:cx, p:int, h h2:el: HM(C,red(C,p),rh(C,p),h,h2) -> j(bock(C,p),h) = h2\nbock_k         [definition] forall C:cx, p:int, e h:el: Del(C,C,red(C,p),mulp(p),rh(C,p),e,h) -> k(bock(C,p),e) = h\nbock_Edeg      [definition] forall C:cx, p m:int, e:el: Edeg(bock(C,p),m,e) <-> e in H(red(C,p),m)\ninter_def      [definition] forall A B:set, x:el: x in inter(A,B) <-> (x in A and x in B)\n"}, "isError": false}}
{"jsonrpc": "2.0", "id": 239, "result": {"content": [{"type": "text", "text": "pow_pos            forall p:int: 1 <= p -> forall m:int: 0 <= m -> 1 <= p^m\nsub_zero           forall S:set: subgroup(S) -> 0 in S\nsub_add            forall S:set, x y:el: subgroup(S) and x in S and y in S -> x + y in S\nsub_neg            forall S:set, x:el: subgroup(S) and x in S -> -x in S\nsub_natmul         forall S:set, x:el: subgroup(S) and x in S -> forall n:int: 0 <= n -> n*x in S\nsub_smul           forall S:set, n:int, x:el: subgroup(S) and x in S -> n*x in S\nssum_sub           forall A B:set: subgroup(A) and subgroup(B) -> subgroup(ssum(A,B))\nzsummand_trans     forall a:el, S T:set: zsummand(a,S) and summand(S,T) -> zsummand(a,T)\nzsum_val           forall a:el, S:set, p q:int, t x:el: zsummand(a,S) and 2 <= p and 1 <= q and t in S and x in S and p*t = 0 and q*a = t + (p*q)*x -> false\nzsum_unit          forall a:el, S:set, p w:int, x y:el: zsummand(a,S) and 2 <= p and 1 <= w and x in S and y in S and w*x = 0 and a = x + p*y -> false\nec_subD            forall c:cpl: excouple(c) -> subgroup(D(c))\nec_subE            forall c:cpl: excouple(c) -> subgroup(E(c))\nec_iD              forall c:cpl, x:el: excouple(c) and x in D(c) -> i(c,x) in D(c)\nec_jE              forall c:cpl, x:el: excouple(c) and x in D(c) -> j(c,x) in E(c)\nec_kD              forall c:cpl, e:el: excouple(c) and e in E(c) -> k(c,e) in D(c)\nec_kerj            forall c:cpl, x:el: excouple(c) and x in D(c) and j(c,x) = 0 -> exists y:el: y in D(c) and x = i(c,y)\nec_ji              forall c:cpl, x:el: excouple(c) and x in D(c) -> j(c,i(c,x)) = 0\nec_kerk            forall c:cpl, e:el: excouple(c) and e in E(c) and k(c,e) = 0 -> exists x:el: x in D(c) and e = j(c,x)\nec_kj              forall c:cpl, x:el: excouple(c) and x in D(c) -> k(c,j(c,x)) = 0\nec_keri            forall c:cpl, x:el: excouple(c) and x in D(c) and i(c,x) = 0 -> exists e:el: e in E(c) and x = k(c,e)\nec_ik              forall c:cpl, e:el: excouple(c) and e in E(c) -> i(c,k(c,e)) = 0\nipow_add           forall c:cpl, m:int, x y:el: ipow(c,m,x+y) = ipow(c,m,x) + ipow(c,m,y)\nipow_smul          forall c:cpl, m:int, n:int, x:el: ipow(c,m,n*x) = n*ipow(c,m,x)\nipow_shift         forall c:cpl, m:int: 0 <= m -> forall x:el: ipow(c,m+1,x) = ipow(c,m,i(c,x))\nipow_D             forall c:cpl: excouple(c) -> forall m:int, x:el: x in D(c) -> ipow(c,m,x) in D(c)\nclosed_forms       forall c:cpl: excouple(c) -> forall r:int: 1 <= r -> (forall y:el: Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x))) and (forall e:el: Zr(c,r,e) <-> (e in E(c) and exists x:el: x in D(c) and k(c,e) = ipow(c,r-1,x))) and (forall e:el: Br(c,r,e) <-> (exists x:el: x in D(c) and ipow(c,r-1,x) = 0 and e = j(c,x))) and (forall y e:el: Jr(c,r,y,e) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x) and Br(c,r,e - j(c,x))))\ncf_D               forall c:cpl, r:int, y:el: excouple(c) and 1 <= r -> (Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x)))\ncf_Z               forall c:cpl, r:int, e:el: excouple(c) and 1 <= r -> (Zr(c,r,e) <-> (e in E(c) and exists x:el: x in D(c) and k(c,e) = ipow(c,r-1,x)))\ncf_B               forall c:cpl, r:int, e:el: excouple(c) and 1 <= r -> (Br(c,r,e) <-> (exists x:el: x in D(c) and ipow(c,r-1,x) = 0 and e = j(c,x)))\ncf_J               forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r -> (Jr(c,r,y,e) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x) and Br(c,r,e - j(c,x))))\ndc_B0              forall c:cpl, r:int: excouple(c) and 1 <= r -> Br(c,r,0)\ndc_Bsub            forall c:cpl, r:int, u v:el: excouple(c) and 1 <= r and Br(c,r,u) and Br(c,r,v) -> Br(c,r,u - v)\ndc_Dr              forall c:cpl, r:int, y:el: excouple(c) and 1 <= r -> (Dr(c,r,y) <-> (exists x:el: x in D(c) and y = ipow(c,r-1,x)))\ndc_DD              forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> y in D(c)\ndc_iD              forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> Dr(c,r,i(c,y))\ndc_jr              forall c:cpl, r:int, x:el: excouple(c) and 1 <= r and x in D(c) -> Jr(c,r,ipow(c,r-1,x),j(c,x))\ndc_Jsub            forall c:cpl, r:int, y1 y2 e1 e2:el: excouple(c) and 1 <= r and Jr(c,r,y1,e1) and Jr(c,r,y2,e2) -> Jr(c,r,y1 - y2,e1 - e2)\ndc_Jwd             forall c:cpl, r:int, y e1 e2:el: excouple(c) and 1 <= r and Jr(c,r,y,e1) and Jr(c,r,y,e2) -> Br(c,r,e1 - e2)\ndc_kerj            forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) and Br(c,r,e) -> exists y2:el: Dr(c,r,y2) and y = i(c,y2)\ndc_imi             forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) -> Jr(c,r,i(c,y),0)\ndc_kerk            forall c:cpl, r:int, e:el: excouple(c) and 1 <= r and Zr(c,r,e) and k(c,e) = 0 -> exists y:el: Jr(c,r,y,e)\ndc_imj             forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) -> k(c,e) = 0\ndc_JZ              forall c:cpl, r:int, y e:el: excouple(c) and 1 <= r and Jr(c,r,y,e) -> Zr(c,r,e)\ndc_keri            forall c:cpl, r:int, y:el: excouple(c) and 1 <= r and Dr(c,r,y) and i(c,y) = 0 -> exists e:el: Zr(c,r,e) and y = k(c,e)\ndc_imk             forall c:cpl, r:int, e:el: excouple(c) and 1 <= r and Zr(c,r,e) -> Dr(c,r,k(c,e)) and i(c,k(c,e)) = 0\nderived_exact      forall c:cpl, r:int: excouple(c) and 1 <= r -> (forall y e:el: Jr(c,r,y,e) and Br(c,r,e) -> exists y2:el: Dr(c,r,y2) and y = i(c,y2)) and (forall y:el: Dr(c,r,y) -> Jr(c,r,i(c,y),0)) and (forall e:el: Zr(c,r,e) and k(c,e) = 0 -> exists y:el: Jr(c,r,y,e)) and (forall y e:el: Jr(c,r,y,e) -> k(c,e) = 0) and (forall y:el: Dr(c,r,y) and i(c,y) = 0 -> exists e:el: Zr(c,r,e) and y = k(c,e)) and (forall e:el: Zr(c,r,e) -> Dr(c,r,k(c,e)) and i(c,k(c,e)) = 0)\ndd_zero            forall c:cpl, r:int, e f:el: excouple(c) and 1 <= r and Zr(c,r,e) and Jr(c,r,k(c,e),f) -> dzero(c,r,f)\ncx_sub             forall A:cx: iscx(A) -> subgroup(Ch(A))\ncx_d               forall A:cx, x:el: iscx(A) and x in Ch(A) -> dif(A,x) in Ch(A)\ncx_dd              forall A:cx, x:el: iscx(A) and x in Ch(A) -> dif(A,dif(A,x)) = 0\ncls_zero0          forall A:cx, h:el: iscx(A) and Cls(A,0,h) -> h = 0\ncls_00             forall A:cx: iscx(A) -> Cls(A,0,0)\ncls_neg            forall A:cx, z h:el: iscx(A) and Cls(A,z,h) -> Cls(A,-z,-h)\ncls_add            forall A:cx, z1 z2 h1 h2:el: iscx(A) and Cls(A,z1,h1) and Cls(A,z2,h2) -> Cls(A,z1 + z2,h1 + h2)\ncls_eq             forall A:cx, z1 z2 h1 h2 y:el: iscx(A) and Cls(A,z1,h1) and Cls(A,z2,h2) and y in Ch(A) and z1 - z2 = dif(A,y) -> h1 = h2\ncls_fun            forall A:cx, z h1 h2:el: iscx(A) and Cls(A,z,h1) and Cls(A,z,h2) -> h1 = h2\ncls_rep            forall A:cx, z1 z2 h:el: Cls(A,z1,h) and Cls(A,z2,h) -> exists y:el: y in Ch(A) and z1 - z2 = dif(A,y)\ncls_natmul         forall A:cx, z h:el: iscx(A) and Cls(A,z,h) -> forall n:int: 0 <= n -> Cls(A,n*z,n*h)\ncls_smul           forall A:cx, n:int, z h:el: iscx(A) and Cls(A,z,h) -> Cls(A,n*z,n*h)\nHc_sub             forall A:cx: iscx(A) -> subgroup(Hc(A))\nCn_sub             forall A:cx, n:int: iscx(A) -> subgroup(Cn(A,n))\nH_in               forall A:cx, n:int, h:el: h in H(A,n) -> h in Hc(A)\nHco_in             forall A:cx, n:int, h:el: h in Hco(A,n) -> h in Hc(A)\nH_sub              forall A:cx, n:int: iscx(A) -> subgroup(H(A,n))\nHco_sub            forall A:cx, n:int: iscx(A) -> subgroup(Hco(A,n))\nH_summand          forall A:cx, n:int: iscx(A) -> summand(H(A,n),Hc(A))\ncm_A               forall A B:cx, f:hom: chmap(A,B,f) -> iscx(A)\ncm_B               forall A B:cx, f:hom: chmap(A,B,f) -> iscx(B)\ncm_in              forall A B:cx, f:hom, x:el: chmap(A,B,f) and x in Ch(A) -> ap(f,x) in Ch(B)\ncm_d               forall A B:cx, f:hom, x:el: chmap(A,B,f) and x in Ch(A) -> ap(f,dif(A,x)) = dif(B,ap(f,x))\nss_f               forall A B C:cx, f g:hom: isses(A,B,C,f,g) -> chmap(A,B,f)\nss_g               forall A B C:cx, f g:hom: isses(A,B,C,f,g) -> chmap(B,C,g)\nss_inj             forall A B C:cx, f g:hom, x:el: isses(A,B,C,f,g) and x in Ch(