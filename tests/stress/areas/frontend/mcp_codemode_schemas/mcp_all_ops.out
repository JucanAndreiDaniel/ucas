params\\\"}\"}]}, {\"cmd\": \"surjective\", \"description\": \"onto? (with a value never taken)\", \"ucas\": \"surjective\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"onto\", \"type\": \"interval\", \"required\": false, \"description\": \"the codomain\"}]}, {\"cmd\": \"bijective\", \"description\": \"a bijection?\", \"ucas\": \"bijective\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"continuity\", \"description\": \"discontinuities by kind\", \"ucas\": \"continuity\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"convexity\", \"description\": \"convex/concave intervals\", \"ucas\": \"convexity\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"asymptotes\", \"description\": \"vertical, horizontal, oblique\", \"ucas\": \"asymptotes\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"expand\", \"description\": \"expanded over Q\", \"ucas\": \"expand\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}]}, {\"cmd\": \"factor\", \"description\": \"factored over Q\", \"ucas\": \"factor\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}]}, {\"cmd\": \"simplify\", \"description\": \"the simplest normal form\", \"ucas\": \"simplify\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}]}, {\"cmd\": \"together\", \"description\": \"one fraction\", \"ucas\": \"together\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}]}, {\"cmd\": \"cancel\", \"description\": \"common factors cancelled\", \"ucas\": \"cancel\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}]}, {\"cmd\": \"collect\", \"description\": \"collected in a variable\", \"ucas\": \"collect\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"apart\", \"description\": \"partial fractions\", \"ucas\": \"apart\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"gcd\", \"description\": \"polynomial gcd\", \"ucas\": \"gcd\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"expression\", \"required\": true, \"description\": \"P\"}, {\"name\": \"q\", \"type\": \"expression\", \"required\": true, \"description\": \"Q\"}]}, {\"cmd\": \"lcm\", \"description\": \"polynomial lcm\", \"ucas\": \"lcm\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"expression\", \"required\": true, \"description\": \"P\"}, {\"name\": \"q\", \"type\": \"expression\", \"required\": true, \"description\": \"Q\"}]}, {\"cmd\": \"resultant\", \"description\": \"the resultant\", \"ucas\": \"resultant\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"expression\", \"required\": true, \"description\": \"P\"}, {\"name\": \"q\", \"type\": \"expression\", \"required\": true, \"description\": \"Q\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"discriminant\", \"description\": \"the discriminant\", \"ucas\": \"discriminant\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"expression\", \"required\": true, \"description\": \"P\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"quo\", \"description\": \"polynomial quotient\", \"ucas\": \"quo\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"expression\", \"required\": true, \"description\": \"P\"}, {\"name\": \"q\", \"type\": \"expression\", \"required\": true, \"description\": \"Q\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"rem\", \"description\": \"polynomial remainder\", \"ucas\": \"rem\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"expression\", \"required\": true, \"description\": \"P\"}, {\"name\": \"q\", \"type\": \"expression\", \"required\": true, \"description\": \"Q\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"divide\", \"description\": \"division with remainder\", \"ucas\": \"divide\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"expression\", \"required\": true, \"description\": \"P\"}, {\"name\": \"q\", \"type\": \"expression\", \"required\": true, \"description\": \"Q\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"the variable\"}]}, {\"cmd\": \"solve\", \"description\": \"equations and systems, every solution substituted back\", \"ucas\": \"solve\", \"structured\": true, \"params\": [{\"name\": \"equations\", \"type\": \"expressions\", \"required\": true, \"description\": \"L = R (or F, meaning F = 0)\"}, {\"name\": \"for\", \"type\": \"names\", \"required\": false, \"description\": \"the unknowns\"}]}, {\"cmd\": \"substitute\", \"description\": \"F at values\", \"ucas\": \"substitute\", \"structured\": true, \"params\": [{\"name\": \"values\", \"type\": \"substitutions\", \"required\": true, \"description\": \"{\\\"x\\\": expr, ...}\"}, {\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}]}, {\"cmd\": \"plot\", \"description\": \"a GIF plot (files)\", \"ucas\": \"plot\", \"structured\": true, \"params\": [{\"name\": \"fs\", \"type\": \"expressions\", \"required\": true, \"description\": \"functions, an equation, a region, a curve ...\"}, {\"name\": \"options\", \"type\": \"string\", \"required\": false, \"description\": \"plot options as in the CLI: \\\"x in -1..1 deriv logy\\\"\"}, {\"name\": \"to\", \"type\": \"name\", \"required\": false, \"description\": \"the file's name (plot)\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"a checksum instead of the file\"}]}, {\"cmd\": \"plot3d\", \"description\": \"a surface (files)\", \"ucas\": \"plot3d\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"options\", \"type\": \"string\", \"required\": false, \"description\": \"plot options\"}, {\"name\": \"to\", \"type\": \"name\", \"required\": false, \"description\": \"name\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"a checksum instead of the file\"}]}, {\"cmd\": \"neighbourhood\", \"description\": \"a plot around the interesting part (files)\", \"ucas\": \"neighbourhood\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}, {\"name\": \"at\", \"type\": \"number\", \"required\": false, \"description\": \"the point\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"a checksum instead of the file\"}]}, {\"cmd\": \"animate\", \"description\": \"an animated GIF: scans, lockstep execution, a shader over images (files)\", \"ucas\": \"animate\", \"structured\": false, \"params\": [{\"name\": \"spec\", \"type\": \"string\", \"required\": false, \"description\": \"as in the CLI: \\\"hillis scan n 8\\\", \\\"exec of 32-bit x*x + 1\\\"; with code, \\\"exec\\\" (the default)\"}, {\"name\": \"code\", \"type\": \"source\", \"required\": false, \"description\": \"SPIR-V assembly or GLSL for animate exec\"}, {\"name\": \"inputs\", \"type\": \"image inputs\", \"required\": false, \"description\": \"the shader's image inputs, in (set, binding) order: each a colour name, #rrggbb, \\\"noise\\\", \\\"gradient\\\", \\\"checker\\\", or {\\\"color\\\" | \\\"pattern\\\" | \\\"png_base64\\\" (any PNG/JPEG/GIF/BMP/PPM, base64) | \\\"file\\\", \\\"format\\\": \\\"R8\\\", \\\"width\\\", \\\"height\\\", \\\"filter\\\": \\\"nearest\\\", \\\"address\\\": \\\"clamp\\\"}; inputs not given are noise\"}, {\"name\": \"output_format\", \"type\": \"string\", \"required\": false, \"description\": \"the colour target's format: RGBA8 (default), RGB8, RG8, R8, SRGB8_A8, RGBA16F, R32F, RGBA32F ...\"}, {\"name\": \"size\", \"type\": \"string\", \"required\": false, \"description\": \"the image run's size, \\\"128x128\\\" (the first input's, at most 256x256)\"}, {\"name\": \"sampler\", \"type\": \"string\", \"required\": false, \"description\": \"the sampler state SPIR-V does not carry: \\\"nearest clamp\\\", \\\"linear mirror\\\", \\\"border white\\\" (linear repeat)\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the random inputs' seed\"}, {\"name\": \"lanes\", \"type\": \"integer\", \"required\": false, \"description\": \"4 (a 2x2 quad), 8, 16 or 32\"}, {\"name\": \"to\", \"type\": \"name\", \"required\": false, \"description\": \"the file's name (exec)\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"a checksum instead of the file\"}]}, {\"cmd\": \"symmetry\", \"description\": \"axes x = c, centres, f(x, y) = f(y, x)\", \"ucas\": \"symmetry\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function: a defined name, an expression (inline types allowed: \\\"isqrt(x: u4)\\\"), or {\\\"body\\\", \\\"params\\\"}\"}]}, {\"cmd\": \"ring\", \"description\": \"a ring's structure (units, zero divisors, ideals ...), an element of it, or a value computed in it\", \"ucas\": \"ring\", \"structured\": true, \"params\": [{\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"Z/12, GF(2^8), GF(2)[x]/(x^4 + 1), Z[i], Q[x]/(x^2 - 2) ...\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}, {\"name\": \"what\", \"type\": \"string\", \"required\": false, \"description\": \"units | zero divisors | idempotents | table, an element (\\\"4\\\", \\\"0x53\\\"), or an expression (\\\"0x57 * 0x83\\\")\"}]}, {\"cmd\": \"inverse_mod\", \"description\": \"a multiplicative inverse (of a number, an element, a matrix)\", \"ucas\": \"inverse\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"string\", \"required\": true, \"description\": \"the element (\\\"3\\\", \\\"0x53\\\", \\\"[[1,2],[3,5]]\\\")\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"order_mod\", \"description\": \"multiplicative order (of a residue, an element, a polynomial over GF)\", \"ucas\": \"order\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"string\", \"required\": true, \"description\": \"the element\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"phi\", \"description\": \"Euler's totient\", \"ucas\": \"phi\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"number\", \"required\": true, \"description\": \"n\"}]}, {\"cmd\": \"carmichael\", \"description\": \"Carmichael's lambda\", \"ucas\": \"carmichael\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"number\", \"required\": true, \"description\": \"n\"}]}, {\"cmd\": \"factorint\", \"description\": \"integer factorisation (Pollard-Brent, Miller-Rabin)\", \"ucas\": \"factorint\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"number\", \"required\": true, \"description\": \"n\"}]}, {\"cmd\": \"legendre\", \"description\": \"the Legendre symbol (a/p)\", \"ucas\": \"legendre\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"number\", \"required\": true, \"description\": \"a\"}, {\"name\": \"p\", \"type\": \"number\", \"required\": true, \"description\": \"p (an odd prime)\"}]}, {\"cmd\": \"jacobi\", \"description\": \"the Jacobi symbol (a/n)\", \"ucas\": \"jacobi\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"number\", \"required\": true, \"description\": \"a\"}, {\"name\": \"n\", \"type\": \"number\", \"required\": true, \"description\": \"n (odd)\"}]}, {\"cmd\": \"sqrtmod\", \"description\": \"square roots mod n (Tonelli-Shanks, Hensel, CRT)\", \"ucas\": \"sqrtmod\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"number\", \"required\": true, \"description\": \"a\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"qr\", \"description\": \"the quadratic residues mod n\", \"ucas\": \"qr\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"number\", \"required\": true, \"description\": \"n\"}]}, {\"cmd\": \"primroot\", \"description\": \"the smallest primitive root mod n, or whether a is one\", \"ucas\": \"primroot\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"number\", \"required\": false, \"description\": \"a candidate (with modulus)\"}, {\"name\": \"n\", \"type\": \"number\", \"required\": false, \"description\": \"n (alone)\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": false, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"dlog\", \"description\": \"the discrete logarithm\", \"ucas\": \"dlog\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"string\", \"required\": true, \"description\": \"the value\"}, {\"name\": \"base\", \"type\": \"string\", \"required\": false, \"description\": \"the base (default a primitive root)\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"crt\", \"description\": \"the Chinese remainder theorem\", \"ucas\": \"crt\", \"structured\": true, \"params\": [{\"name\": \"congruences\", \"type\": \"congruences\", \"required\": true, \"description\": \"[{\\\"residue\\\": 2, \\\"modulus\\\": 3}, ...]\"}]}, {\"cmd\": \"congruence\", \"description\": \"a linear or polynomial congruence\", \"ucas\": \"congruence\", \"structured\": true, \"params\": [{\"name\": \"equation\", \"type\": \"string\", \"required\": true, \"description\": \"\\\"3x = 4\\\", \\\"x^2 + x + 1 = 0\\\"\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"magic\", \"description\": \"the multiply-shift for dividing by a constant\", \"ucas\": \"magic\", \"structured\": true, \"params\": [{\"name\": \"divisor\", \"type\": \"integer\", \"required\": true, \"description\": \"the divisor\"}, {\"name\": \"type\", \"type\": \"enum\", \"required\": true, \"description\": \"the integer type\", \"values\": \"u8|u16|u32|u64|i8|i16|i32|i64\"}]}, {\"cmd\": \"ring_factor\", \"description\": \"factor a polynomial over a finite field or Z/n (or an element of Z[i])\", \"ucas\": \"factor\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"string\", \"required\": true, \"description\": \"the polynomial (or crc16, crc32 ...)\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"GF(q), Z[i]\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"irreducible\", \"description\": \"Rabin's irreducibility test\", \"ucas\": \"irreducible\", \"structured\": true, \"params\": [{\"name\": \"p\", \"type\": \"string\", \"required\": true, \"description\": \"the polynomial\"}, {\"