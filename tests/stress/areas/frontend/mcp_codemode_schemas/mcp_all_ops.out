true, \"description\": \"Q\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"ring_norm\", \"description\": \"the norm of a quadratic integer\", \"ucas\": \"norm\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"string\", \"required\": true, \"description\": \"the element\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"Z[i], Z[sqrt(2)]\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"matrix\", \"description\": \"a matrix over Z/n or GF(q): its properties, det, rank, nullspace, inverse, or a solve\", \"structured\": true, \"params\": [{\"name\": \"matrix\", \"type\": \"matrix\", \"required\": true, \"description\": \"[[a, b], [c, d]]\"}, {\"name\": \"op\", \"type\": \"enum\", \"required\": false, \"description\": \"what (default matrix: the summary)\", \"values\": \"matrix|det|rank|nullspace|inverse|solve\"}, {\"name\": \"rhs\", \"type\": \"values\", \"required\": false, \"description\": \"solve: M x = rhs\"}, {\"name\": \"ring\", \"type\": \"ring\", \"required\": true, \"description\": \"the ring\"}, {\"name\": \"modulus\", \"type\": \"modulus\", \"required\": false, \"description\": \"N (mod N); with a GF(q) ring its polynomial or name (aes, crc32)\"}]}, {\"cmd\": \"gf2matrix\", \"description\": \"a GF(2)-linear bit map as a matrix\", \"ucas\": \"gf2matrix\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the map of x (x ^ (x << 3))\"}, {\"name\": \"type\", \"type\": \"enum\", \"required\": true, \"description\": \"the word\", \"values\": \"u8|u16|u32|u64\"}]}, {\"cmd\": \"laplace\", \"description\": \"the one-sided Laplace transform, with its region of convergence\", \"ucas\": \"laplace\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"t\"}, {\"name\": \"to_var\", \"type\": \"name\", \"required\": false, \"description\": \"s\"}, {\"name\": \"period\", \"type\": \"number\", \"required\": false, \"description\": \"the period of a periodic f\"}]}, {\"cmd\": \"ilaplace\", \"description\": \"the inverse Laplace transform\", \"ucas\": \"ilaplace\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"s\"}, {\"name\": \"to_var\", \"type\": \"name\", \"required\": false, \"description\": \"t\"}]}, {\"cmd\": \"laplace_solve\", \"description\": \"a linear ODE with constant coefficients through the Laplace transform\", \"ucas\": \"laplace solve\", \"structured\": true, \"params\": [{\"name\": \"equations\", \"type\": \"expressions\", \"required\": true, \"description\": \"the ODE and its initial values: [\\\"y'' + y = sin(t)\\\", \\\"y(0) = 0\\\", \\\"y'(0) = 1\\\"]\"}]}, {\"cmd\": \"ztrans\", \"description\": \"the one-sided Z transform, with its ROC\", \"ucas\": \"ztrans\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"n\"}, {\"name\": \"to_var\", \"type\": \"name\", \"required\": false, \"description\": \"z\"}]}, {\"cmd\": \"iztrans\", \"description\": \"the inverse Z transform (causal)\", \"ucas\": \"iztrans\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"z\"}, {\"name\": \"to_var\", \"type\": \"name\", \"required\": false, \"description\": \"n\"}]}, {\"cmd\": \"zsolve\", \"description\": \"a linear recurrence through the Z transform\", \"ucas\": \"zsolve\", \"structured\": true, \"params\": [{\"name\": \"equations\", \"type\": \"expressions\", \"required\": true, \"description\": \"[\\\"y[n+2] = y[n+1] + y[n]\\\", \\\"y[0] = 0\\\", \\\"y[1] = 1\\\"]\"}]}, {\"cmd\": \"tf\", \"description\": \"a transfer function: poles, zeros, stability, impulse response\", \"ucas\": \"tf\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"a difference equation, an ODE, or H(z)/H(s)\"}]}, {\"cmd\": \"fourier\", \"description\": \"the Fourier transform\", \"ucas\": \"fourier\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"x\"}, {\"name\": \"to_var\", \"type\": \"name\", \"required\": false, \"description\": \"w\"}]}, {\"cmd\": \"ifourier\", \"description\": \"the inverse Fourier transform\", \"ucas\": \"ifourier\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"w\"}, {\"name\": \"to_var\", \"type\": \"name\", \"required\": false, \"description\": \"x\"}]}, {\"cmd\": \"fourier_series\", \"description\": \"a Fourier series\", \"ucas\": \"fourier series\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"x\"}, {\"name\": \"on\", \"type\": \"interval\", \"required\": false, \"description\": \"the interval ([-pi, pi])\"}, {\"name\": \"period\", \"type\": \"number\", \"required\": false, \"description\": \"the period\"}, {\"name\": \"terms\", \"type\": \"integer\", \"required\": false, \"description\": \"terms shown\"}]}, {\"cmd\": \"dft\", \"description\": \"the discrete Fourier transform (FFT for powers of two)\", \"ucas\": \"dft\", \"structured\": true, \"params\": [{\"name\": \"values\", \"type\": \"values\", \"required\": true, \"description\": \"[x0, x1, ...] (numbers or \\\"1+2i\\\")\"}]}, {\"cmd\": \"idft\", \"description\": \"the inverse DFT\", \"ucas\": \"idft\", \"structured\": true, \"params\": [{\"name\": \"values\", \"type\": \"values\", \"required\": true, \"description\": \"[X0, X1, ...]\"}]}, {\"cmd\": \"dtft\", \"description\": \"the discrete-time Fourier transform\", \"ucas\": \"dtft\", \"structured\": true, \"params\": [{\"name\": \"values\", \"type\": \"values\", \"required\": false, \"description\": \"a finite sequence\"}, {\"name\": \"f\", \"type\": \"expression\", \"required\": false, \"description\": \"or a sequence x[n]\"}]}, {\"cmd\": \"genfunc\", \"description\": \"the ordinary generating function\", \"ucas\": \"genfunc\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"string\", \"required\": true, \"description\": \"a_n, a recurrence or a name (fibonacci, catalan)\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"n\"}]}, {\"cmd\": \"egf\", \"description\": \"the exponential generating function\", \"ucas\": \"egf\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"string\", \"required\": true, \"description\": \"a_n or a name\"}]}, {\"cmd\": \"infinite_sum\", \"description\": \"an infinite sum: convergence test, closed form, numeric value\", \"structured\": true, \"params\": [{\"name\": \"index\", \"type\": \"name\", \"required\": true, \"description\": \"n\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"the first index (1)\"}, {\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the term\"}]}, {\"cmd\": \"infinite_product\", \"description\": \"an infinite product\", \"structured\": true, \"params\": [{\"name\": \"index\", \"type\": \"name\", \"required\": true, \"description\": \"n\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"the first index (1)\"}, {\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the factor\"}]}, {\"cmd\": \"converge\", \"description\": \"convergence tests of sum a_n\", \"ucas\": \"converge\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"expression\", \"required\": true, \"description\": \"the term a_n (in n)\"}]}, {\"cmd\": \"radius\", \"description\": \"the radius and interval of convergence of a power series\", \"ucas\": \"radius\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"expression\", \"required\": true, \"description\": \"the term, x^n/n!\"}]}, {\"cmd\": \"powerseries\", \"description\": \"the general term of a power series\", \"ucas\": \"powerseries\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"the expression\"}, {\"name\": \"var\", \"type\": \"name\", \"required\": false, \"description\": \"x\"}, {\"name\": \"at\", \"type\": \"number\", \"required\": false, \"description\": \"the centre\"}]}, {\"cmd\": \"asymptotic\", \"description\": \"Euler-Maclaurin asymptotics of a partial sum\", \"ucas\": \"asymptotic\", \"structured\": true, \"params\": [{\"name\": \"sum\", \"type\": \"expression\", \"required\": true, \"description\": \"sum(k, 1, n, f)\"}]}, {\"cmd\": \"area\", \"description\": \"the area under or between curves (exact and numeric; a GIF)\", \"ucas\": \"area\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"F, or \\\"F and G\\\"\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"a\"}, {\"name\": \"to\", \"type\": \"number\", \"required\": false, \"description\": \"b\"}, {\"name\": \"options\", \"type\": \"string\", \"required\": false, \"description\": \"riemann left 8, accumulate ...\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"a checksum instead of the GIF\"}]}, {\"cmd\": \"revolve\", \"description\": \"the solid of revolution: volume, surface, centroid, Pappus (a GIF)\", \"ucas\": \"revolve\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"F, or \\\"F and G\\\"\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"a\"}, {\"name\": \"to\", \"type\": \"number\", \"required\": false, \"description\": \"b\"}, {\"name\": \"about\", \"type\": \"string\", \"required\": false, \"description\": \"x, y, x = 2, y = -1\"}, {\"name\": \"method\", \"type\": \"enum\", \"required\": false, \"description\": \"the slicing\", \"values\": \"disk|washer|shell\"}, {\"name\": \"options\", \"type\": \"string\", \"required\": false, \"description\": \"still, rotate ...\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"no GIF\"}]}, {\"cmd\": \"volume\", \"description\": \"the volume of the solid of revolution\", \"ucas\": \"volume\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"F\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"a\"}, {\"name\": \"to\", \"type\": \"number\", \"required\": false, \"description\": \"b\"}, {\"name\": \"about\", \"type\": \"string\", \"required\": false, \"description\": \"the axis\"}, {\"name\": \"method\", \"type\": \"enum\", \"required\": false, \"description\": \"the slicing\", \"values\": \"disk|washer|shell\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"no GIF\"}]}, {\"cmd\": \"surfacearea\", \"description\": \"the lateral surface area of the solid\", \"ucas\": \"surfacearea\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"F\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"a\"}, {\"name\": \"to\", \"type\": \"number\", \"required\": false, \"description\": \"b\"}, {\"name\": \"about\", \"type\": \"string\", \"required\": false, \"description\": \"the axis\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"no GIF\"}]}, {\"cmd\": \"arclength\", \"description\": \"the arc length of a curve\", \"ucas\": \"arclength\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"F\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"a\"}, {\"name\": \"to\", \"type\": \"number\", \"required\": false, \"description\": \"b\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"no GIF\"}]}, {\"cmd\": \"centroid\", \"description\": \"the centroid of the region under or between curves\", \"ucas\": \"centroid\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"expression\", \"required\": true, \"description\": \"F, or \\\"F and G\\\"\"}, {\"name\": \"from\", \"type\": \"number\", \"required\": false, \"description\": \"a\"}, {\"name\": \"to\", \"type\": \"number\", \"required\": false, \"description\": \"b\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"no GIF\"}]}, {\"cmd\": \"multiplication_table\", \"description\": \"an algebra's multiplication table (and the Fano plane)\", \"ucas\": \"table\", \"structured\": true, \"params\": [{\"name\": \"algebra\", \"type\": \"string\", \"required\": true, \"description\": \"complex | quaternion | octonion | sedenion | cd N\"}]}, {\"cmd\": \"algebra\", \"description\": \"an algebra's properties with counterexamples\", \"ucas\": \"algebra\", \"structured\": true, \"params\": [{\"name\": \"algebra\", \"type\": \"string\", \"required\": true, \"description\": \"complex | quaternion | octonion | sedenion | cd N\"}, {\"name\": \"property\", \"type\": \"string\", \"required\": false, \"description\": \"one property: associative, alternative ...\"}]}, {\"cmd\": \"zerodivisors\", \"description\": \"a pair of zero divisors\", \"ucas\": \"zerodivisors\", \"structured\": true, \"params\": [{\"name\": \"algebra\", \"type\": \"string\", \"required\": true, \"description\": \"sedenion | cd N (from the sedenions on)\"}]}, {\"cmd\": \"associator\", \"description\": \"(ab)c - a(bc)\", \"ucas\": \"associator\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"expression\", \"required\": true, \"description\": \"a\"}, {\"name\": \"b\", \"type\": \"expression\", \"required\": true, \"description\": \"b\"}, {\"name\": \"c\", \"type\": \"expression\", \"required\": true, \"description\": \"c\"}]}, {\"cmd\": \"commutator\", \"description\": \"ab - ba\", \"ucas\": \"commutator\", \"structured\": true, \"params\": [{\"name\": \"a\", \"type\": \"expression\", \"required\": true, \"description\": \"a\"}, {\"name\": \"b\", \"type\": \"expression\", \"required\": true, \"description\": \"b\"}]}, {\"cmd\": \"rotate\", \"description\": \"rotate a vector by a quaternion or an angle about an axis\", \"ucas\": \"rotate\", \"structured\": true, \"params\": [{\"name\": \"v\", \"type\": \"string\", \"required\": true, \"description\": \"(1, 0, 0)\"}, {\"name\": \"by\", \"type\": \"string\", \"required\": true, \"description\": \"a quaternion, or an angle (90 degrees, pi/2)\"}, {\"name\": \"about\", \"type\": \"string\", \"required\": false, \"description\": \"the axis: (0, 0, 1), x, y, z\"}]}, {\"cmd\": \"axisangle\", \"description\": \"axis and angle to a unit quaternion, or back\", \"ucas\": \"axisangle\", \"structured\": true, \"params\": [{\"name\": \"q\", \"type\": \"string\", \"required\": true, \"description\": \"\\\"(0, 0, 1), pi/2\\\" or a quaternion\"}]}, {\"cmd\": \"rotmatrix\", \"description\": \"a quaternion's 3x3 rotation matrix\", \"ucas\": \"rotmatrix\", \"structured\": true, \"params\": [{\"name\": \"q\", \"type\": \"string\", \"required\": true, \"description\": \"the quaternion\"}]}, {\"cmd\": \"frommatrix\", \"description\": \"the quaternion of a rotation matrix\", \"ucas\": \"frommatrix\", \"structured\": true, \"params\": [{\"name\": \"matrix\", \"type\": \"expressions\", \"required\": true, \"description\": \"m11, ..., m33 (9 numbers, by rows)\"}]}, {\"cmd\": \"slerp\", \"description\": \"spherical linear interpolation\", \"ucas\": \"slerp\", \"structured\": true, \"params\": [{\"name\": \"q1\", \"type\": \"string\", \"required\": true, \"description\": \"q1\"}, {\"name\": \"q2\", \"type\": \"string\", \"required\": true, \"description\": \"q2\"}, {\"name\": \"t\", \"type\": \"number\", \"required\": true, \"description\": \"t\"}]}, {\"cmd\": \"spirv_simplify\", \"description\": \"cheaper forms of a SPIR-V module's integer instructions, each proved by SAT\", \"structured\": true, \"params\": [{\"name\": \"code\", \"type\": \"source\", \"required\": true, \"description\": \"SPIR-V assembly, GLSL, or C (run as c_optimize)\"}, {\"name\": \"lang\", \"type\": \"enum\", \"required\": false, \"description\": \"the code's language (by default from the code; c: the C frontend, as c_optimize)\", \"values\": \"spv|glsl|c\"}, {\"name\": \"budget\", \"type\": \"number\", \"required\": false, \"description\": \"seconds (6)\"}, {\"name\": \"ranges\", \"type\": \"object\", \"required\": false, \"description\": \"{\\\"n\\\": [lo, hi]}: values assumed for an input\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"a checksum instead of the rewritten module\"}, {\"name\": \"float_only\", \"type\": \"boolean\", \"required\": false, \"description\": \"only the float instructions\"}, {\"name\": \"exact\", \"type\": \"boolean\", \"required\": false, \"description\": \"float rewrites: bit-exact ones only\"}, {\"name\": \"ulp\", \"type\": \"number\", \"required\": false, \"description\": \"float rewrites: within N ulp of the reference\"}, {\"name\": \"approx\", \"type\": \"boolean\", \"required\": false, \"description\": \"float rewrites: approximations too (with ulp)\"}, {\"name\": \"percomp\", \"type\": \"boolean\", \"required\": false, \"description\": \"float rewrites: per vector component\"}, {\"name\": \"search\", \"type\": \"enum\", \"required\": false, \"description\": \"float rewrites: the polynomials' coefficient search after rounding, kept when its certificate is better\", \"values\": \"anneal|cmaes\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the search's seed (UCAS_SEED, else 1)\"}, {\"name\": \"advice\", \"type\": \"boolean\", \"required\": false, \"description\": \"also report what could leave the shader: values of a draw's frequency, and in a fragment shader what is affine in the varyings\"}, {\"name\": \"overdraw\", \"type\": \"number\", \"required\": false, \"description\": \"advice: the fragments a pixel gets (1 or more): the shader's runs that early fragment tests and a depth prepass save\"}, {\"name\": \"sink\", \"type\": \"string\", \"required\": false, \"description\": \"float rewrites: the format the stored and returned floats end in (unorm8, rgba8, r8g8b8a8_unorm, rgb10a2, f16): one step of it is the error budget; or int: a floor or an int() conversion may move its integer by one\"}, {\"name\": \"texture\", \"type\": \"string\", \"required\": false, \"description\": \"\\\"S B\\\": the descriptor set and binding the host gives a constant table's texture; a read of it is then written through the texture unit (without it, proposed)\"}, {\"name\": \"functions\", \"type\": \"boolean\", \"required\": false, \"description\": \"GLSL: the function-level pass alone (true) or not at all (false); both levels run by default\"}, {\"name\": \"float_ranges\", \"type\": \"object\", \"required\": false, \"description\": \"{\\\"c\\\": [lo, hi]}: a float input's range (closed)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the cost model to price and choose under (made the active one; the dot products it offers are used)\"}]}, {\"cmd\": \"c_optimize\", \"description\": \"C99 in, faster C out for an x86-64 target: each rewrite proved (exhaustively, by SAT, by a derivation or by induction) against the original under C99 LP64 semantics with IEEE floats, unproved ones not applied; loops in closed form, element-wise loop bodies, strlen scans, loops vectorised with intrinsics (proved lane by lane)\", \"ucas\": \"c optimize\", \"structured\": true, \"params\": [{\"name\": \"code\", \"type\": \"source\", \"required\": false, \"description\": \"C99 source (or file)\"}, {\"name\": \"file\", \"type\": \"string\", \"required\": false, \"description\": \"a .c file instead of code\"}, {\"name\": \"target\", \"type\": \"string\", \"required\": false, \"description\": \"x86-64-v3 (default), zen4, skylake, alderlake, x86-64-v2 ... (c_targets)\"}, {\"name\": \"budget\", \"type\": \"number\", \"required\": false, \"description\": \"seconds for proofs (10)\"}, {\"name\": \"range\", \"type\": \"string\", \"required\": false, \"description\": \"NAME LO HI: a contract on an input (\\\"x 0 1000\\\")\"}, {\"name\": \"check\", \"type\": \"boolean\", \"required\": false, \"description\": \"compile both with the host cc and compare them on edge and random inputs (UB inputs skipped)\"}, {\"name\": \"bench\", \"type\": \"boolean\", \"required\": false, \"description\": \"check, and time both with rdtsc\"}, {\"name\": \"wrapv\", \"type\": \"boolean\", \"required\": false, \"description\": \"signed overflow wraps (do not exploit UB)\"}, {\"name\": \"nofile\", \"type\": \"boolean\", \"required\": false, \"description\": \"print the code instead of a file\"}, {\"name\": \"timed\", \"type\": \"boolean\", \"required\": false, \"description\": \"say how many seconds the proofs took\"}, {\"name\": \"trace\", \"type\": \"boolean\", \"required\": false, \"description\": \"list every candidate and why it was not taken\"}, {\"name\": \"vecstub\", \"type\": \"boolean\", \"required\": false, \"description\": \"a stub vectoriser that rebuilds each counted loop from its IR (tests the loop extraction)\"}, {\"name\": \"vectorize\", \"type\": \"boolean\", \"required\": false, \"description\": \"apply the proved vectorised loops (by default they are proposed; with bench, applied where they beat clang's own code)\"}, {\"name\": \"engines\", \"type\": \"string\", \"required\": false, \"description\": \"which of ucas's engines generate candidates: all (default), none, or a comma list of find gates alg ring dio gf2 loops bound synth\"}, {\"name\": \"steps\", \"type\": \"number\", \"required\": false, \"description\": \"sketches the synthesis may try per value (a deterministic budget; default 1000)\"}, {\"name\": \"ebudget\", \"type\": \"number\", \"required\": false, \"description\": \"CPU seconds for the engines' own searches, in total (default: a quarter of budget)\"}, {\"name\": \"approx\", \"type\": \"boolean\", \"required\": false, \"description\": \"apply approximations (loops as integrals, minimax) whose derived error bound is stated; by default they are proposed\"}, {\"name\": \"error\", \"type\": \"number\", \"required\": false, \"description\": \"with approx: apply an approximation only when its derived error bound is at most this\"}]}, {\"cmd\": \"c_lower\", \"description\": \"each C function as one ucas value of its parameters (with the C UB as a domain condition), or why not; for the others, each counted loop in the vectoriser's IR\", \"ucas\": \"c lower\", \"structured\": true, \"params\": [{\"name\": \"code\", \"type\": \"source\", \"required\": false, \"description\": \"C99 source (or file)\"}, {\"name\": \"file\", \"type\": \"string\", \"required\": false, \"description\": \"a .c file instead of code\"}, {\"name\": \"wrapv\", \"type\": \"boolean\", \"required\": false, \"description\": \"signed overflow wraps\"}]}, {\"cmd\": \"c_targets\", \"description\": \"the x86-64 targets and their instruction-set features\", \"ucas\": \"c targets\", \"structured\": true, \"params\": []}, {\"cmd\": \"x86_models\", \"description\": \"the x86 µarch cost models (skl skx glc rpl zen4 x86v2 x86v3 x86v4)\", \"ucas\": \"x86 models\", \"structured\": true, \"params\": []}, {\"cmd\": \"x86_model\", \"description\": \"one x86 µarch: features, ports, and per instruction class latency, reciprocal throughput, uops and ports at xmm/ymm/zmm (with where each number comes from)\", \"ucas\": \"model\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"string\", \"required\": true, \"description\": \"skl skx glc rpl zen4 x86v2 x86v3 x86v4, or an alias: skylake, znver4 ...\"}]}, {\"cmd\": \"mca\", \"description\": \"a cycle-level throughput estimate of a function's x86 code (critical path, port pressure, front end; no caches or mispredictions)\", \"ucas\": \"mca\", \"structured\": true, \"params\": [{\"name\": \"f\", \"type\": \"function\", \"required\": true, \"description\": \"the function\"}, {\"name\": \"model\", \"type\": \"string\", \"required\": false, \"description\": \"the µarch (default: the active x86 model, else skl)\"}]}, {\"cmd\": \"intrinsic\", \"description\": \"one x86 intrinsic: signature, features, instruction class, exact lane semantics (as ucas expressions) and costs per µarch\", \"ucas\": \"intrinsic\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"string\", \"required\": true, \"description\": \"_mm256_add_epi32 ...\"}, {\"name\": \"model\", \"type\": \"string\", \"required\": false, \"description\": \"only this µarch\"}]}, {\"cmd\": \"intrinsics\", \"description\": \"the intrinsics catalogue: count per feature, or the names matching a filter (a substring, a feature such as avx2, or a class)\", \"ucas\": \"intrinsics\", \"structured\": true, \"params\": [{\"name\": \"filter\", \"type\": \"string\", \"required\": false, \"description\": \"a substring, feature or class\"}, {\"name\": \"model\", \"type\": \"string\", \"required\": false, \"description\": \"only those this µarch has\"}]}, {\"cmd\": \"x86check\", \"description\": \"test the intrinsics' lane semantics against the host C compiler's intrinsics (compiled and run on random and edge inputs)\", \"ucas\": \"x86check\", \"structured\": true, \"params\": [{\"name\": \"filter\", \"type\": \"string\", \"required\": false, \"description\": \"a substring or feature\"}, {\"name\": \"n\", \"type\": \"integer\", \"required\": false, \"description\": \"points per test (64)\"}, {\"name\": \"avx512\", \"type\": \"boolean\", \"required\": false, \"description\": \"also the AVX-512 forms (lowered to run on this host, and cross-checked)\"}]}, {\"cmd\": \"bigint\", \"description\": \"an exact integer expression of any size (+ - * ^ !, / exact, div floor, % mod, gcd, lcm, abs, isprime, binomial)\", \"ucas\": \"bigint\", \"structured\": true, \"params\": [{\"name\": \"expr\", \"type\": \"string\", \"required\": true, \"description\": \"the expression: \\\"2^200 + 1\\\"\"}]}, {\"cmd\": \"bigint_factor\", \"description\": \"prime factorization of an integer of any size (Pollard-Brent rho; product and primality checked)\", \"ucas\": \"bigint factor\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"string\", \"required\": true, \"description\": \"the integer or expression\"}]}, {\"cmd\": \"snf\", \"description\": \"Smith normal form U A V = D with U, V and their inverses, verified; the cokernel\", \"ucas\": \"snf\", \"structured\": true, \"params\": [{\"name\": \"matrix\", \"type\": \"matrix\", \"required\": true, \"description\": \"an integer matrix (big entries as strings: \\\"2^100\\\")\"}]}, {\"cmd\": \"hnf\", \"description\": \"row Hermite normal form H = U A with U unimodular, verified\", \"ucas\": \"hnf\", \"structured\": true, \"params\": [{\"name\": \"matrix\", \"type\": \"matrix\", \"required\": true, \"description\": \"an integer matrix\"}]}, {\"cmd\": \"zmatrix\", \"description\": \"an integer matrix over Z: summary, det, rank, kernel (saturated basis), image (lattice basis), inverse over Z, cokernel group, or solve A x = b over Z\", \"ucas\": \"zmat\", \"structured\": true, \"params\": [{\"name\": \"op\", \"type\": \"enum\", \"required\": false, \"description\": \"what (default: a summary)\", \"values\": \"det|rank|kernel|image|inverse|cokernel|solve\"}, {\"name\": \"matrix\", \"type\": \"matrix\", \"required\": true, \"description\": \"the matrix\"}, {\"name\": \"rhs\", \"type\": \"values\", \"required\": false, \"description\": \"solve: b\"}]}, {\"cmd\": \"qmatrix\", \"description\": \"a matrix over Q (entries like \\\"1/2\\\"): rref, det, rank, inverse, nullspace, solve\", \"ucas\": \"qmat\", \"structured\": true, \"params\": [{\"name\": \"op\", \"type\": \"enum\", \"required\": false, \"description\": \"what (default rref)\", \"values\": \"rref|det|rank|inverse|nullspace|solve\"}, {\"name\": \"matrix\", \"type\": \"matrix\", \"required\": true, \"description\": \"the matrix\"}, {\"name\": \"rhs\", \"type\": \"values\", \"required\": false, \"description\": \"solve: b\"}]}, {\"cmd\": \"abgroup\", \"description\": \"a finitely generated abelian group: invariant factors, primary decomposition, order, rank, exponent, torsion, generators\", \"ucas\": \"abgroup\", \"structured\": true, \"params\": [{\"name\": \"group\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}]}, {\"cmd\": \"abiso\", \"description\": \"are two abelian groups isomorphic; if so an explicit isomorphism and its inverse, both checked\", \"ucas\": \"abiso\", \"structured\": true, \"params\": [{\"name\": \"g\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"h\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}]}, {\"cmd\": \"abhom\", \"description\": \"the group Hom(G, H)\", \"ucas\": \"abhom\", \"structured\": true, \"params\": [{\"name\": \"g\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"h\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}]}, {\"cmd\": \"abtensor\", \"description\": \"the tensor product G (x) H\", \"ucas\": \"abtensor\", \"structured\": true, \"params\": [{\"name\": \"g\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"h\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}]}, {\"cmd\": \"abtor\", \"description\": \"Tor(G, H) from a free resolution\", \"ucas\": \"abtor\", \"structured\": true, \"params\": [{\"name\": \"g\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"h\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}]}, {\"cmd\": \"abext\", \"description\": \"Ext(G, H) from a free resolution\", \"ucas\": \"abext\", \"structured\": true, \"params\": [{\"name\": \"g\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"h\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}]}, {\"cmd\": \"abmap\", \"description\": \"a homomorphism G -> H given by the images of G's generators (columns, in H's generators): well defined?, kernel, image, cokernel, injective, surjective, inverse\", \"ucas\": \"abmap\", \"structured\": true, \"params\": [{\"name\": \"from\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"to\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"matrix\", \"type\": \"matrix\", \"required\": true, \"description\": \"column j = the image of generator j\"}]}, {\"cmd\": \"abelem\", \"description\": \"an element of an abelian group: canonical form and order\", \"ucas\": \"abelem\", \"structured\": true, \"params\": [{\"name\": \"group\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"element\", \"type\": \"values\", \"required\": true, \"description\": \"its coordinates in the group's generators\"}]}, {\"cmd\": \"absub\", \"description\": \"the subgroup generated by elements, its quotient and index (membership witnesses checked)\", \"ucas\": \"absub\", \"structured\": true, \"params\": [{\"name\": \"group\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"generators\", \"type\": \"matrix\", \"required\": true, \"description\": \"the generators, one per row\"}]}, {\"cmd\": \"abexact\", \"description\": \"is G1 -f-> G2 -g-> G3 exact at G2 (with preimages of ker g as the certificate)\", \"ucas\": \"abexact\", \"structured\": true, \"params\": [{\"name\": \"g1\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"g2\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"g3\", \"type\": \"string\", \"required\": true, \"description\": \"an abelian group: \\\"Z/4 + Z/6\\\", \\\"Z^2 + Z/3\\\", \\\"(Z/2)^3\\\", \\\"0\\\", or \\\"coker [[2, 0], [0, 3]]\\\"\"}, {\"name\": \"f\", \"type\": \"string\", \"required\": true, \"description\": \"f as a matrix ([[...]]; \\\"[]\\\" from 0)\"}, {\"name\": \"g\", \"type\": \"string\", \"required\": true, \"description\": \"g as a matrix\"}]}, {\"cmd\": \"permgroup\", \"description\": \"a permutation group by Schreier-Sims: order (exact, any size), base and strong generators, orbits, abelian, derived and lower central series, solvable, nilpotent, centre\", \"ucas\": \"permgroup\", \"structured\": true, \"params\": [{\"name\": \"group\", \"type\": \"string\", \"required\": true, \"description\": \"a permutation group: \\\"S4\\\", \\\"A5\\\", \\\"C6\\\", \\\"D8\\\" (order 8), or generators in cycle notation \\\"(1 2 3 4), (1 2)\\\"\"}]}, {\"cmd\": \"permelem\", \"description\": \"is a permutation in the group (sifting, with the word in the transversals as the certificate); its order\", \"ucas\": \"permelem\", \"structured\": true, \"params\": [{\"name\": \"group\", \"type\": \"string\", \"required\": true, \"description\": \"a permutation group: \\\"S4\\\", \\\"A5\\\", \\\"C6\\\", \\\"D8\\\" (order 8), or generators in cycle notation \\\"(1 2 3 4), (1 2)\\\"\"}, {\"name\": \"perm\", \"type\": \"string\", \"required\": true, \"description\": \"the permutation: \\\"(1 2 3)(4 5)\\\" or \\\"()\\\"\"}]}, {\"cmd\": \"permsub\", \"description\": \"H in G: subgroup?, normal?, index, normal closure, coset representatives\", \"ucas\": \"permsub\", \"structured\": true, \"params\": [{\"name\": \"h\", \"type\": \"string\", \"required\": true, \"description\": \"a permutation group: \\\"S4\\\", \\\"A5\\\", \\\"C6\\\", \\\"D8\\\" (order 8), or generators in cycle notation \\\"(1 2 3 4), (1 2)\\\"\"}, {\"name\": \"g\", \"type\": \"string\", \"required\": true, \"description\": \"a permutation group: \\\"S4\\\", \\\"A5\\\", \\\"C6\\\", \\\"D8\\\" (order 8), or generators in cycle notation \\\"(1 2 3 4), (1 2)\\\"\"}]}, {\"cmd\": \"permhom\", \"description\": \"does sending G's generators to the given permutations define a homomorphism G -> H\", \"ucas\": \"permhom\", \"structured\": true, \"params\": [{\"name\": \"from\", \"type\": \"string\", \"required\": true, \"description\": \"a permutation group: \\\"S4\\\", \\\"A5\\\", \\\"C6\\\", \\\"D8\\\" (order 8), or generators in cycle notation \\\"(1 2 3 4), (1 2)\\\"\"}, {\"name\": \"to\", \"type\": \"string\", \"required\": true, \"description\": \"a permutation group: \\\"S4\\\", \\\"A5\\\", \\\"C6\\\", \\\"D8\\\" (order 8), or generators in cycle notation \\\"(1 2 3 4), (1 2)\\\"\"}, {\"name\": \"images\", \"type\": \"string\", \"required\": true, \"description\": \"the images of G's generators, in order: \\\"(), (1 2)\\\"\"}]}, {\"cmd\": \"cayley\", \"description\": \"a finite group by its Cayley table (entries 0..n-1): the axioms checked, abelian, element orders, solvable, nilpotent\", \"ucas\": \"cayley\", \"structured\": true, \"params\": [{\"name\": \"table\", \"type\": \"matrix\", \"required\": true, \"description\": \"the n x n table: row a, column b holds a*b\"}]}, {\"cmd\": \"groebner\", \"description\": \"the reduced Groebner basis of an ideal of polynomials over Q or F_p, each element with its cofactors in the generators (Buchberger with criteria; verified)\", \"ucas\": \"groebner\", \"structured\": true, \"params\": [{\"name\": \"polys\", \"type\": \"string\", \"required\": true, \"description\": \"the generators: \\\"x^2 + y^2 - 1, x - y\\\"\"}, {\"name\": \"order\", \"type\": \"enum\", \"required\": false, \"description\": \"the monomial order (default grevlex)\", \"values\": \"lex|grlex|grevlex\"}, {\"name\": \"modulus\", \"type\": \"integer\", \"required\": false, \"description\": \"a prime p: over F_p (default over Q)\"}, {\"name\": \"vars\", \"type\": \"string\", \"required\": false, \"description\": \"the variables, largest first: \\\"x, y, z\\\" (default: those that occur, alphabetical)\"}]}, {\"cmd\": \"idealmember\", \"description\": \"is h in the ideal: the cofactors h = sum c_j f_j (multiplied out and checked), or the nonzero normal form\", \"ucas\": \"idealmember\", \"structured\": true, \"params\": [{\"name\": \"h\", \"type\": \"string\", \"required\": true, \"description\": \"the polynomial\"}, {\"name\": \"polys\", \"type\": \"string\", \"required\": true, \"description\": \"the ideal's generators\"}, {\"name\": \"order\", \"type\": \"enum\", \"required\": false, \"description\": \"the monomial order (default grevlex)\", \"values\": \"lex|grlex|grevlex\"}, {\"name\": \"modulus\", \"type\": \"integer\", \"required\": false, \"description\": \"a prime p: over F_p (default over Q)\"}, {\"name\": \"vars\", \"type\": \"string\", \"required\": false, \"description\": \"the variables, largest first: \\\"x, y, z\\\" (default: those that occur, alphabetical)\"}]}, {\"cmd\": \"idealeq\", \"description\": \"compare two ideals: equal, one inside the other, or neither (each inclusion certified by cofactors)\", \"ucas\": \"idealeq\", \"structured\": true, \"params\": [{\"name\": \"i\", \"type\": \"string\", \"required\": true, \"description\": \"generators of I\"}, {\"name\": \"j\", \"type\": \"string\", \"required\": true, \"description\": \"generators of J\"}, {\"name\": \"order\", \"type\": \"enum\", \"required\": false, \"description\": \"the monomial order (default grevlex)\", \"values\": \"lex|grlex|grevlex\"}, {\"name\": \"modulus\", \"type\": \"integer\", \"required\": false, \"description\": \"a prime p: over F_p (default over Q)\"}, {\"name\": \"vars\", \"type\": \"string\", \"required\": false, \"description\": \"the variables, largest first: \\\"x, y, z\\\" (default: those that occur, alphabetical)\"}]}, {\"cmd\": \"fxmodule\", \"description\": \"F^n as an F[x]-module with x acting by a matrix: invariant factors, minimal and characteristic polynomial, rational canonical form (Smith form over F[x])\", \"ucas\": \"fxmodule\", \"structured\": true, \"params\": [{\"name\": \"matrix\", \"type\": \"matrix\", \"required\": true, \"description\": \"a square matrix over Q (\\\"1/2\\\" allowed)\"}, {\"name\": \"modulus\", \"type\": \"integer\", \"required\": false, \"description\": \"a prime p: over F_p\"}]}, {\"cmd\": \"pmsnf\", \"description\": \"the Smith normal form of a matrix of polynomials in one variable over Q or F_p, with U and V\", \"ucas\": \"pmsnf\", \"structured\": true, \"params\": [{\"name\": \"matrix\", \"type\": \"string\", \"required\": true, \"description\": \"\\\"[[x, 1], [0, x^2]]\\\"\"}, {\"name\": \"modulus\", \"type\": \"integer\", \"required\": false, \"description\": \"a prime p: over F_p\"}]}, {\"cmd\": \"space\", \"description\": \"a cell complex: its cells, Euler characteristic and boundaries (d o d = 0 checked)\", \"ucas\": \"space\", \"structured\": true, \"params\": [{\"name\": \"space\", \"type\": \"string\", \"required\": true, \"description\": \"a space: S^n, T^n, RP^n, CP^n, K (Klein bottle), L(m) or L(m,q), pt; _s for a simplicial model (RP^2_s, T^2_s, K_s, S^3_s); X x Y, X v Y, susp(X); cells([[d1]], [[d2]], ...) by boundary matrices, facets([[0,1,2], ...])\"}, {\"name\": \"unreduced\", \"type\": \"boolean\", \"required\": false, \"description\": \"use the space's own cells (by default unit pivots are cancelled first, with the homotopy equivalence checked)\"}]}, {\"cmd\": \"homology\", \"description\": \"H_n(X; G) for every n, exactly, with the universal coefficient theorem as a check\", \"ucas\": \"homology\", \"structured\": true, \"params\": [{\"name\": \"space\", \"type\": \"string\", \"required\": true, \"description\": \"a space: S^n, T^n, RP^n, CP^n, K (Klein bottle), L(m) or L(m,q), pt; _s for a simplicial model (RP^2_s, T^2_s, K_s, S^3_s); X x Y, X v Y, susp(X); cells([[d1]], [[d2]], ...) by boundary matrices, facets([[0,1,2], ...])\"}, {\"name\": \"unreduced\", \"type\": \"boolean\", \"required\": false, \"description\": \"use the space's own cells (by default unit pivots are cancelled first, with the homotopy equivalence checked)\"}, {\"name\": \"coefficients\", \"type\": \"string\", \"required\": false, \"description\": \"an abelian group: Z/2, Z/4 + Z (default Z)\"}, {\"name\": \"generators\", \"type\": \"boolean\", \"required\": false, \"description\": \"representative cycles\"}]}, {\"cmd\": \"cohomology\", \"description\": \"H^n(X; G) for every n, exactly, with both universal coefficient theorems as checks\", \"ucas\": \"cohomology\", \"structured\": true, \"params\": [{\"name\": \"space\", \"type\": \"string\", \"required\": true, \"description\": \"a space: S^n, T^n, RP^n, CP^n, K (Klein bottle), L(m) or L(m,q), pt; _s for a simplicial model (RP^2_s, T^2_s, K_s, S^3_s); X x Y, X v Y, susp(X); cells([[d1]], [[d2]], ...) by boundary matrices, facets([[0,1,2], ...])\"}, {\"name\": \"unreduced\", \"type\": \"boolean\", \"required\": false, \"description\": \"use the space's own cells (by default unit pivots are cancelled first, with the homotopy equivalence checked)\"}, {\"name\": \"coefficients\", \"type\": \"string\", \"required\": false, \"description\": \"an abelian group: Z/2, Z/4 + Z (default Z)\"}, {\"name\": \"generators\", \"type\": \"boolean\", \"required\": false, \"description\": \"representative cocycles\"}]}, {\"cmd\": \"les\", \"description\": \"the long exact sequence of 0 -> C -m-> C -> C (x) Z/m -> 0 on cochains, the connecting map by the snake lemma, exactness verified at every spot\", \"ucas\": \"les\", \"structured\": true, \"params\": [{\"name\": \"space\", \"type\": \"string\", \"required\": true, \"description\": \"a space: S^n, T^n, RP^n, CP^n, K (Klein bottle), L(m) or L(m,q), pt; _s for a simplicial model (RP^2_s, T^2_s, K_s, S^3_s); X x Y, X v Y, susp(X); cells([[d1]], [[d2]], ...) by boundary matrices, facets([[0,1,2], ...])\"}, {\"name\": \"unreduced\", \"type\": \"boolean\", \"required\": false, \"description\": \"use the space's own cells (by default unit pivots are cancelled first, with the homotopy equivalence checked)\"}, {\"name\": \"modulus\", \"type\": \"integer\", \"required\": true, \"description\": \"m >= 2\"}]}, {\"cmd\": \"bockstein\", \"description\": \"the Bockstein spectral sequence: pages E_r, D_r and d_r of the exact couple of 0 -> C -p-> C -> C (x) Z/p -> 0, derived exactly until stable\", \"ucas\": \"bockstein\", \"structured\": true, \"params\": [{\"name\": \"space\", \"type\": \"string\", \"required\": true, \"description\": \"a space: S^n, T^n, RP^n, CP^n, K (Klein bottle), L(m) or L(m,q), pt; _s for a simplicial model (RP^2_s, T^2_s, K_s, S^3_s); X x Y, X v Y, susp(X); cells([[d1]], [[d2]], ...) by boundary matrices, facets([[0,1,2], ...])\"}, {\"name\": \"unreduced\", \"type\": \"boolean\", \"required\": false, \"description\": \"use the space's own cells (by default unit pivots are cancelled first, with the homotopy equivalence checked)\"}, {\"name\": \"p\", \"type\": \"integer\", \"required\": true, \"description\": \"a prime\"}, {\"name\": \"pages\", \"type\": \"integer\", \"required\": false, \"description\": \"at most this many pages (64)\"}]}, {\"cmd\": \"bockstein_trace\", \"description\": \"trace a in H^n(X; Z) through the Bockstein spectral sequence: j_r(p^(r-1) a) in E_r, in ker d_r?, in im d_r? (with a preimage)\", \"ucas\": \"bockstein\", \"structured\": true, \"params\": [{\"name\": \"space\", \"type\": \"string\", \"required\": true, \"description\": \"a space: S^n, T^n, RP^n, CP^n, K (Klein bottle), L(m) or L(m,q), pt; _s for a simplicial model (RP^2_s, T^2_s, K_s, S^3_s); X x Y, X v Y, susp(X); cells([[d1]], [[d2]], ...) by boundary matrices, facets([[0,1,2], ...])\"}, {\"name\": \"unreduced\", \"type\": \"boolean\", \"required\": false, \"description\": \"use the space's own cells (by default unit pivots are cancelled first, with the homotopy equivalence checked)\"}, {\"name\": \"p\", \"type\": \"integer\", \"required\": true, \"description\": \"a prime\"}, {\"name\": \"degree\", \"type\": \"integer\", \"required\": true, \"description\": \"n\"}, {\"name\": \"element\", \"type\": \"string\", \"required\": false, \"description\": \"[c1, c2, ...]: canonical coordinates in H^n(X; Z) (default: each generator)\"}, {\"name\": \"page\", \"type\": \"integer\", \"required\": false, \"description\": \"only page r\"}]}, {\"cmd\": \"prop01\", \"description\": \"check Proposition 0.1 of bockstein.pdf on a space: for a generating a Z summand of H^n(X; Z), j_r(p^(r-1) a) is in ker d_r and not in im d_r, for every n and every r (all r up to the stable page, which covers the rest)\", \"ucas\": \"prop01\", \"structured\": true, \"params\": [{\"name\": \"space\", \"type\": \"string\", \"required\": true, \"description\": \"a space: S^n, T^n, RP^n, CP^n, K (Klein bottle), L(m) or L(m,q), pt; _s for a simplicial model (RP^2_s, T^2_s, K_s, S^3_s); X x Y, X v Y, susp(X); cells([[d1]], [[d2]], ...) by boundary matrices, facets([[0,1,2], ...])\"}, {\"name\": \"unreduced\", \"type\": \"boolean\", \"required\": false, \"description\": \"use the space's own cells (by default unit pivots are cancelled first, with the homotopy equivalence checked)\"}, {\"name\": \"p\", \"type\": \"integer\", \"required\": true, \"description\": \"a prime\"}, {\"name\": \"pages\", \"type\": \"integer\", \"required\": false, \"description\": \"at most this many pages (64)\"}]}, {\"cmd\": \"theorem\", \"description\": \"state a theorem in the kernel's language (forall x:el, n:int: ..., and or not -> <->, = <= <, in; the library's sorts, functions and predicates: see lemmas and axioms)\", \"ucas\": \"theorem\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"name\", \"required\": true, \"description\": \"its name\"}, {\"name\": \"statement\", \"type\": \"string\", \"required\": true, \"description\": \"the formula\"}]}, {\"cmd\": \"prove\", \"description\": \"prove a stated theorem: by the library's proofs of the same statement (every route, each re-checked independently), else by replaying the library's proofs and by automation; when it fails, a counterexample is searched in concrete Bockstein spectral sequences\", \"ucas\": \"prove\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"name\", \"required\": true, \"description\": \"the theorem\"}, {\"name\": \"using\", \"type\": \"names\", \"required\": false, \"description\": \"lemmas and axioms for the automation\"}]}, {\"cmd\": \"proof\", \"description\": \"print a proved theorem's proof: each route's script, the tree of lemmas it rests on with their kernel inferences, and the axioms used\", \"ucas\": \"proof\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"name\", \"required\": true, \"description\": \"the theorem or library lemma\"}]}, {\"cmd\": \"proof_check\", \"description\": \"re-check a proved theorem with the independent checker (kcheck.c)\", \"ucas\": \"check\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"name\", \"required\": true, \"description\": \"the theorem or library lemma\"}]}, {\"cmd\": \"axioms\", \"description\": \"the axioms of the proof library (definitions and the integer arithmetic of Z); with a name, the ones that theorem's proofs rest on\", \"ucas\": \"axioms\", \"structured\": true, \"params\": [{\"name\": \"name\", \"type\": \"name\", \"required\": false, \"description\": \"a proved theorem\"}]}, {\"cmd\": \"lemmas\", \"description\": \"the proof library's lemmas and theorems\", \"ucas\": \"lemmas\", \"structured\": true, \"params\": []}, {\"cmd\": \"elliptic\", \"description\": \"an elliptic curve over Q: by default the summary (invariants, minimal model, Tate's algorithm: Kodaira symbols, c_p, conductor; torsion; rank bounds by 2-isogeny descent; generators and heights; periods, root number, L-values, analytic rank, BSD quotient), or one operation\", \"ucas\": \"ec\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"[a1, a2, a3, a4, a6], [a4, a6], or \\\"y^2 + x*y = x^3 - x + 1\\\"\"}, {\"name\": \"op\", \"type\": \"enum\", \"required\": false, \"description\": \"what (default: the summary)\", \"values\": \"info|points|torsion|rank|local|minimal|analytic|periods|on|height|add|mul|order|wp|ap|model|integral\"}, {\"name\": \"args\", \"type\": \"string\", \"required\": false, \"description\": \"the op's arguments: a point \\\"(x, y)\\\" (on, height, order), two points (add), \\\"k (x, y)\\\" (mul), a height bound (points, rank), a bound on |x| (integral), a prime (ap), z as \\\"a+bi\\\" (wp), a model: short, montgomery, edwards, twisted_edwards, legendre\"}]}, {\"cmd\": \"diophantine\", \"description\": \"solve a Diophantine equation through an elliptic curve: a plane cubic (homogeneous in 3 variables, or affine in 2), a curve quadratic in one variable with a quartic discriminant, or z^2 = quartic(x, y); rational point, birational map to Weierstrass form (kept with its inverse), the group, combinations of generators mapped back, each solution substituted into the equation; with no solution, a proof where one is found (rank 0, or no rational point on the real component the conditions need)\", \"ucas\": \"diophantine\", \"structured\": true, \"params\": [{\"name\": \"equation\", \"type\": \"string\", \"required\": true, \"description\": \"\\\"a/(b+c) + b/(a+c) + c/(a+b) = 4\\\"\"}, {\"name\": \"positive\", \"type\": \"boolean\", \"required\": false, \"description\": \"every variable > 0\"}, {\"name\": \"integer\", \"type\": \"boolean\", \"required\": false, \"description\": \"integer values (affine equations)\"}, {\"name\": \"nonzero\", \"type\": \"boolean\", \"required\": false, \"description\": \"every variable != 0\"}, {\"name\": \"count\", \"type\": \"integer\", \"required\": false, \"description\": \"solutions wanted (default 1)\"}, {\"name\": \"maxmult\", \"type\": \"integer\", \"required\": false, \"description\": \"largest |coefficient| of a generator (default 30 for rank 1)\"}, {\"name\": \"search\", \"type\": \"integer\", \"required\": false, \"description\": \"point search bound\"}]}, {\"cmd\": \"weierstrass\", \"description\": \"the maps from a cubic or quartic curve to Weierstrass form, the minimal model and the group\", \"ucas\": \"weierstrass\", \"structured\": true, \"params\": [{\"name\": \"equation\", \"type\": \"string\", \"required\": true, \"description\": \"\\\"x^3 + y^3 = 7*z^3\\\"\"}]}, {\"cmd\": \"congruent\", \"description\": \"is n the area of a right triangle with rational sides: the curve y^2 = x^3 - n^2 x, its rank by descent, a triangle (checked) or a proof that none exists, Tunnell's counts\", \"ucas\": \"congruent\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"string\", \"required\": true, \"description\": \"a positive integer\"}]}, {\"cmd\": \"mordell\", \"description\": \"the Mordell curve y^2 = x^3 + k: the summary and its integral points up to a bound\", \"ucas\": \"mordell\", \"structured\": true, \"params\": [{\"name\": \"k\", \"type\": \"string\", \"required\": true, \"description\": \"a nonzero integer\"}, {\"name\": \"bound\", \"type\": \"integer\", \"required\": false, \"description\": \"|x| <= bound (default 100000)\"}]}, {\"cmd\": \"cubesum\", \"description\": \"k as a sum of two rational cubes: x^3 + y^3 = k z^3 solved through its curve\", \"ucas\": \"cubesum\", \"structured\": true, \"params\": [{\"name\": \"k\", \"type\": \"string\", \"required\": true, \"description\": \"a positive integer\"}, {\"name\": \"positive\", \"type\": \"boolean\", \"required\": false, \"description\": \"x, y > 0\"}]}, {\"cmd\": \"ec_info\", \"description\": \"a curve over F_p: discriminant, j, #E (certified by point orders), trace, group structure (certified by a Weil pairing), twist, embedding degree, weaknesses\", \"ucas\": \"ec\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}]}, {\"cmd\": \"ec_order\", \"description\": \"#E(F_p) by a chosen method, with the certificate (points whose orders leave one candidate in the Hasse interval)\", \"ucas\": \"ecorder\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"method\", \"type\": \"enum\", \"required\": false, \"description\": \"naive, baby-step giant-step (Mestre), CM (j = 0, 1728), Schoof, SEA (Schoof with splitting here)\", \"values\": \"auto|naive|bsgs|cm|schoof|sea\"}, {\"name\": \"timed\", \"type\": \"boolean\", \"required\": false, \"description\": \"print timings\"}]}, {\"cmd\": \"ec_points\", \"description\": \"the points of E(F_p), p <= 100000\", \"ucas\": \"ecpoints\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}]}, {\"cmd\": \"ec_add\", \"description\": \"P + Q\", \"ucas\": \"ecadd\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"P\", \"type\": \"string\", \"required\": true, \"description\": \"(x, y), G or O\"}, {\"name\": \"Q\", \"type\": \"string\", \"required\": true, \"description\": \"(x, y), G or O\"}]}, {\"cmd\": \"ec_mul\", \"description\": \"k P by wNAF/Jacobian, checked against affine double-and-add, the Montgomery ladder and plain NAF\", \"ucas\": \"ecmul\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"k\", \"type\": \"string\", \"required\": true, \"description\": \"the scalar (an integer expression)\"}, {\"name\": \"P\", \"type\": \"string\", \"required\": true, \"description\": \"(x, y), G, random\"}, {\"name\": \"method\", \"type\": \"enum\", \"required\": false, \"description\": \"only this cross-check\", \"values\": \"affine|wnaf|ladder\"}]}, {\"cmd\": \"ecm\", \"description\": \"factor an integer (up to 576 bits): trial division, Pollard rho, Lenstra ECM stage 1 + 2; with B1 one ECM run\", \"ucas\": \"ecm\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"string\", \"required\": true, \"description\": \"the number (\\\"2^128 + 1\\\")\"}, {\"name\": \"B1\", \"type\": \"string\", \"required\": false, \"description\": \"stage 1 bound\"}, {\"name\": \"B2\", \"type\": \"string\", \"required\": false, \"description\": \"stage 2 bound\"}]}, {\"cmd\": \"ecdsa_sign\", \"description\": \"ECDSA signature with RFC 6979 deterministic nonce (variable-time code: mathematics, not a hardened implementation)\", \"ucas\": \"ecdsa sign\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"key\", \"type\": \"string\", \"required\": true, \"description\": \"the private key d\"}, {\"name\": \"hash\", \"type\": \"enum\", \"required\": false, \"description\": \"default by the order's size\", \"values\": \"sha256|sha384|sha512\"}, {\"name\": \"nonce\", \"type\": \"string\", \"required\": false, \"description\": \"a given nonce instead of RFC 6979\"}, {\"name\": \"msg\", \"type\": \"string\", \"required\": true, \"description\": \"the message (text)\"}]}, {\"cmd\": \"ecdsa_verify\", \"description\": \"verify an ECDSA signature\", \"ucas\": \"ecdsa verify\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"pub\", \"type\": \"string\", \"required\": true, \"description\": \"(x, y) or SEC 1 hex\"}, {\"name\": \"r\", \"type\": \"string\", \"required\": true, \"description\": \"r\"}, {\"name\": \"s\", \"type\": \"string\", \"required\": true, \"description\": \"s\"}, {\"name\": \"hash\", \"type\": \"enum\", \"required\": false, \"description\": \"the hash\", \"values\": \"sha256|sha384|sha512\"}, {\"name\": \"msg\", \"type\": \"string\", \"required\": true, \"description\": \"the message (text)\"}]}, {\"cmd\": \"ecdh\", \"description\": \"Diffie-Hellman on a named curve: both sides from two private keys, or one key and a peer's point (validated)\", \"ucas\": \"ecdh\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"a\", \"type\": \"string\", \"required\": true, \"description\": \"a private key\"}, {\"name\": \"b\", \"type\": \"string\", \"required\": false, \"description\": \"the other private key\"}, {\"name\": \"pub\", \"type\": \"string\", \"required\": false, \"description\": \"the peer's point (x, y)\"}]}, {\"cmd\": \"x25519\", \"description\": \"RFC 7748 X25519 (hex, little-endian)\", \"ucas\": \"x25519\", \"structured\": true, \"params\": [{\"name\": \"k\", \"type\": \"string\", \"required\": true, \"description\": \"the scalar, 32 bytes hex\"}, {\"name\": \"u\", \"type\": \"string\", \"required\": false, \"description\": \"u, 32 bytes hex (default the base point 9)\"}]}, {\"cmd\": \"x448\", \"description\": \"RFC 7748 X448 (hex, little-endian)\", \"ucas\": \"x448\", \"structured\": true, \"params\": [{\"name\": \"k\", \"type\": \"string\", \"required\": true, \"description\": \"the scalar, 56 bytes hex\"}, {\"name\": \"u\", \"type\": \"string\", \"required\": false, \"description\": \"u, 56 bytes hex (default the base point 5)\"}]}, {\"cmd\": \"ed25519_sign\", \"description\": \"RFC 8032 Ed25519 signature (and the public key)\", \"ucas\": \"ed25519 sign\", \"structured\": true, \"params\": [{\"name\": \"secret\", \"type\": \"string\", \"required\": true, \"description\": \"32 bytes hex\"}, {\"name\": \"msghex\", \"type\": \"string\", \"required\": true, \"description\": \"the message as hex bytes\"}]}, {\"cmd\": \"ed25519_verify\", \"description\": \"verify an Ed25519 signature\", \"ucas\": \"ed25519 verify\", \"structured\": true, \"params\": [{\"name\": \"pub\", \"type\": \"string\", \"required\": true, \"description\": \"32 bytes hex\"}, {\"name\": \"sig\", \"type\": \"string\", \"required\": true, \"description\": \"64 bytes hex\"}, {\"name\": \"msghex\", \"type\": \"string\", \"required\": true, \"description\": \"the message as hex\"}]}, {\"cmd\": \"ec_compress\", \"description\": \"SEC 1 encodings of a point\", \"ucas\": \"eccompress\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"P\", \"type\": \"string\", \"required\": true, \"description\": \"(x, y) or G\"}]}, {\"cmd\": \"ec_decompress\", \"description\": \"decode a SEC 1 point\", \"ucas\": \"ecdecompress\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"hex\", \"type\": \"string\", \"required\": true, \"description\": \"02/03/04 ...\"}]}, {\"cmd\": \"ec_validate\", \"description\": \"public-key validation (SEC 1 3.2.2.1)\", \"ucas\": \"ecvalidate\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"P\", \"type\": \"string\", \"required\": true, \"description\": \"(x, y)\"}]}, {\"cmd\": \"ec_vectors\", \"description\": \"run the built-in RFC/FIPS test vectors and the named curves' parameter checks\", \"ucas\": \"ecvectors\", \"structured\": true, \"params\": []}, {\"cmd\": \"ec_dlog\", \"description\": \"a discrete logarithm k with k P = Q: Pohlig-Hellman, BSGS, rho, MOV (pairing transfer), Smart (anomalous); checked by k P = Q\", \"ucas\": \"ecdlog\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"P\", \"type\": \"string\", \"required\": true, \"description\": \"(x, y) or random\"}, {\"name\": \"Q\", \"type\": \"string\", \"required\": false, \"description\": \"(x, y)\"}, {\"name\": \"secret\", \"type\": \"string\", \"required\": false, \"description\": \"instead of Q: Q = secret P\"}, {\"name\": \"method\", \"type\": \"enum\", \"required\": false, \"description\": \"default: by the curve\", \"values\": \"bsgs|rho|ph|mov|smart\"}]}, {\"cmd\": \"ec_weak\", \"description\": \"generate a weak curve (anomalous: #E = p; supersingular: embedding degree 2); \\\"anomalous 64\\\" also works as the curve of ec_dlog\", \"ucas\": \"ecweak\", \"structured\": true, \"params\": [{\"name\": \"kind\", \"type\": \"enum\", \"required\": true, \"description\": \"which weakness\", \"values\": \"anomalous|supersingular\"}, {\"name\": \"bits\", \"type\": \"integer\", \"required\": true, \"description\": \"the size of p\"}]}, {\"cmd\": \"ec_pairing\", \"description\": \"Weil or reduced Tate pairing by Miller's algorithm with bilinearity checks; on bn254/bls12_381 alone: e(G1, G2) in F_p^12\", \"ucas\": \"ecpairing\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"P\", \"type\": \"string\", \"required\": false, \"description\": \"(x, y)\"}, {\"name\": \"Q\", \"type\": \"string\", \"required\": false, \"description\": \"(x, y)\"}, {\"name\": \"n\", \"type\": \"string\", \"required\": false, \"description\": \"the order n\"}, {\"name\": \"kind\", \"type\": \"enum\", \"required\": false, \"description\": \"default weil\", \"values\": \"weil|tate\"}]}, {\"cmd\": \"hilbert\", \"description\": \"the Hilbert class polynomial H_D (CM j-invariants), rounding error bounded\", \"ucas\": \"hilbert\", \"structured\": true, \"params\": [{\"name\": \"D\", \"type\": \"string\", \"required\": true, \"description\": \"a negative discriminant\"}]}, {\"cmd\": \"ec_cm\", \"description\": \"a CM curve with discriminant D over F_p, or a random prime-order CM curve of a given size\", \"ucas\": \"eccm\", \"structured\": true, \"params\": [{\"name\": \"D\", \"type\": \"string\", \"required\": true, \"description\": \"the discriminant\"}, {\"name\": \"p\", \"type\": \"string\", \"required\": false, \"description\": \"the prime\"}, {\"name\": \"bits\", \"type\": \"integer\", \"required\": false, \"description\": \"instead of p: random p and prime #E\"}]}, {\"cmd\": \"ecpp\", \"description\": \"an Atkin-Morain ECPP primality certificate, verified by an independent checker\", \"ucas\": \"ecpp\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"string\", \"required\": true, \"description\": \"the number (\\\"2^127 - 1\\\")\"}]}, {\"cmd\": \"modpoly\", \"description\": \"the classical modular polynomial Phi_l (over Z, or mod p)\", \"ucas\": \"modpoly\", \"structured\": true, \"params\": [{\"name\": \"l\", \"type\": \"integer\", \"required\": true, \"description\": \"a prime <= 31\"}, {\"name\": \"p\", \"type\": \"string\", \"required\": false, \"description\": \"a prime modulus\"}]}, {\"cmd\": \"ec_isogeny\", \"description\": \"an isogeny from a kernel point (Velu, Kohel, checked as a homomorphism), or the rational l-isogenies (roots of Phi_l)\", \"ucas\": \"ecisogeny\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"kernel\", \"type\": \"string\", \"required\": false, \"description\": \"a point (x, y) of small order\"}, {\"name\": \"l\", \"type\": \"string\", \"required\": false, \"description\": \"a prime l\"}]}, {\"cmd\": \"ec_volcano\", \"description\": \"the l-isogeny graph around j(E)\", \"ucas\": \"ecvolcano\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"l\", \"type\": \"integer\", \"required\": true, \"description\": \"a prime <= 13\"}]}, {\"cmd\": \"ec_divpoly\", \"description\": \"the division polynomial psi_n, its roots and factor degrees (the torsion field)\", \"ucas\": \"ecdivpoly\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"secp256k1, P-256, Curve25519, BN254, ..., \\\"y^2 = x^3 + 2x + 3 mod 97\\\" or \\\"[a, b] mod p\\\"\"}, {\"name\": \"n\", \"type\": \"integer\", \"required\": true, \"description\": \"2 .. 60\"}]}, {\"cmd\": \"ec_binary\", \"description\": \"a binary curve y^2 + xy = x^3 + a x^2 + b over GF(2^m): count (Koblitz, naive), FIPS parameters checked\", \"ucas\": \"ecb2\", \"structured\": true, \"params\": [{\"name\": \"curve\", \"type\": \"string\", \"required\": true, \"description\": \"K-163, B-163, K-233, or \\\"[a, b] over GF(2^13) poly 4 3 1 0\\\"\"}, {\"name\": \"mul\", \"type\": \"string\", \"required\": false, \"description\": \"k: k G\"}]}, {\"cmd\": \"lperm\", \"description\": \"a subgroup's lane map (a shuffle's index as a function of lane) as the cheapest proved realisation under the model: exchanges by xor and selects on the lane's bits, a quad's broadcast, or one shuffle\", \"ucas\": \"lperm\", \"structured\": true, \"params\": [{\"name\": \"index\", \"type\": \"expression\", \"required\": true, \"description\": \"the lane read, an expression of lane (\\\"lane xor (lane & 1) << 1\\\")\"}, {\"name\": \"lanes\", \"type\": \"integer\", \"required\": false, \"description\": \"the subgroup's size (the lane's range, else the model's warp)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}, {\"cmd\": \"tcdot\", \"description\": \"a tensor core's block FMA (f16 products, f32 accumulate, Ampere's model): its semantics, its derived error bound relative to the largest term, and a sampled check\", \"ucas\": \"tcdot\", \"structured\": true, \"params\": [{\"name\": \"n\", \"type\": \"integer\", \"required\": false, \"description\": \"products in the block (8)\"}, {\"name\": \"samples\", \"type\": \"integer\", \"required\": false, \"description\": \"random blocks checked (256)\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the check's seed (1)\"}, {\"name\": \"cancel\", \"type\": \"boolean\", \"required\": false, \"description\": \"blocks whose first product the last cancels\"}]}, {\"cmd\": \"winograd\", \"description\": \"Winograd's inner product: a sum of products as half the multiplies plus a row's and a column's corrections, priced for a block of outputs that share them, proved by expansion (integers) or with a derived bound (floats)\", \"ucas\": \"winograd\", \"structured\": true, \"params\": [{\"name\": \"function\", \"type\": \"function\", \"required\": true, \"description\": \"a sum of an even number of products\"}, {\"name\": \"rows\", \"type\": \"integer\", \"required\": false, \"description\": \"rows sharing a column's correction (1)\"}, {\"name\": \"cols\", \"type\": \"integer\", \"required\": false, \"description\": \"columns sharing a row's correction (1)\"}, {\"name\": \"tol\", \"type\": \"number\", \"required\": false, \"description\": \"floats: the absolute error allowed\"}]}, {\"cmd\": \"ozaki\", \"description\": \"Ozaki's scheme: a float sum of products whose factors have ranges as integer dot products, each factor scaled to an integer by a power of two and sliced into the model's lanes, with a derived error bound and a sampled check\", \"ucas\": \"ozaki\", \"structured\": true, \"params\": [{\"name\": \"function\", \"type\": \"function\", \"required\": true, \"description\": \"a float sum of products, its factors ranged (x: f32 in -1..1)\"}, {\"name\": \"slices\", \"type\": \"integer\", \"required\": false, \"description\": \"slices a factor (2): more bits, a smaller error\"}, {\"name\": \"tol\", \"type\": \"number\", \"required\": false, \"description\": \"the absolute error allowed: taken within it\"}, {\"name\": \"seed\", \"type\": \"integer\", \"required\": false, \"description\": \"the check's seed (1)\"}, {\"name\": \"model\", \"type\": \"name\", \"required\": false, \"description\": \"the model (the active one)\"}]}], \"request\": {\"$ref\": \"#/$defs/request\"}, \"response\": {\"$ref\": \"#/$defs/response\"}}"}], "structuredContent": {"id": 222, "ok": true, "cmd": "schema", "structured": true, "result": {"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ucas JSON frontend", "protocol": 1, "transport": "JSON Lines: `ucas --json` reads one request object per line on stdin and writes one response object per line on stdout; `ucas --json -e REQUEST` answers one", "$defs": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "number": {"description": "a JSON number, or a constant expression in ucas syntax (\"pi/2\", \"inf\")", "type": ["number", "string"]}, "interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/number"}}, "expression": {"description": "ucas syntax as a string (one line), or the AST form, fully parenthesised when rendered", "oneOf": [{"type": "string"}, {"type": "number"}, {"type": "object", "required": ["op", "args"], "properties": {"op": {"description": "+ - * / ^ % mod & | xor << >> == != < <= > >= && || = (binary; + * & | xor && || n-ary), neg not ~ (unary), ?: (three), or a function name (sin, atan2, isqrt, a defined function)", "type": "string"}, "args": {"type": "array", "items": {"$ref": "#/$defs/expression"}}}, "additionalProperties": false}, {"type": "object", "required": ["var"], "properties": {"var": {"$ref": "#/$defs/name"}}, "additionalProperties": false}, {"type": "object", "required": ["num"], "properties": {"num": {"description": "a number or an exact fraction \"1/3\"", "type": ["string", "number"]}}, "additionalProperties": false}, {"type": "object", "required": ["expr"], "properties": {"expr": {"type": "string"}}, "additionalProperties": false}]}, "expressions": {"oneOf": [{"$ref": "#/$defs/expressio