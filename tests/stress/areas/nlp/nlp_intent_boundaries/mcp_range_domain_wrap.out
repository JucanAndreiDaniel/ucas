{"jsonrpc": "2.0", "id": 18, "result": {"content": [{"type": "text", "text": "  ucas: it(x) = x^3 - 3*x\n  ucas: zeros it\nzeros of it:\n  3 zeros:\n    x = -sqrt(3)\n    x = 0\n    x = sqrt(3)\n  proved: a polynomial of degree 3 has 3 roots counted with multiplicity\n"}], "structuredContent": {"id": 18, "ok": true, "cmd": "english", "ucas": "what are the zeros of x^3 - 3x?", "structured": true, "result": {"kind": "english", "statements": ["it(x) = x^3 - 3*x", "zeros it"], "understood": true, "results": [{"kind": "zeros", "var": "x", "identically_zero": false, "count": 3, "zeros": [{"value": {"value": -1.7320508075688772, "exact": "-sqrt(3)"}, "multiplicity": 1}, {"value": {"value": 0, "exact": "0"}, "multiplicity": 1}, {"value": {"value": 1.7320508075688772, "exact": "sqrt(3)"}, "multiplicity": 1}], "complex": 0}]}, "notes": [], "conditions": [], "checks": [], "proof": {"kind": "symbolic", "text": "proved: a polynomial of degree 3 has 3 roots counted with multiplicity"}, "files": [], "text": "  ucas: it(x) = x^3 - 3*x\n  ucas: zeros it\nzeros of it:\n  3 zeros:\n    x = -sqrt(3)\n    x = 0\n    x = sqrt(3)\n  proved: a polynomial of degree 3 has 3 roots counted with multiplicity\n"}, "isError": false}}
