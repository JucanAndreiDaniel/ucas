{"jsonrpc": "2.0", "id": 14, "result": {"content": [{"type": "text", "text": "  ucas: it(x: u4) = isqrt(x)\n  ucas: range it\nrange of it -> u4:\n  0..3   (4 distinct values)\n  values: 0..3\n  fits in u2\n  over all 16 points of the domain\n"}], "structuredContent": {"id": 14, "ok": true, "cmd": "english", "ucas": "range of the square root of a 4-bit unsigned x", "structured": true, "result": {"kind": "english", "statements": ["it(x: u4) = isqrt(x)", "range it"], "understood": true, "results": [{"kind": "range", "type": "u4", "empty": false, "exhaustive": true, "points": 16, "undefined_points": 0, "min": {"value": 0, "exact": "0"}, "max": {"value": 3, "exact": "3"}, "distinct": 4, "values": [0, 1, 2, 3], "fits": "u2"}]}, "notes": [{"kind": "assumed", "text": "\"square root\" of an integer: the floor square root, isqrt (args.assume.sqrt)"}], "conditions": [], "checks": [], "proof": {"kind": "exhaustive", "text": "every point of the domain evaluated"}, "files": [], "text": "  ucas: it(x: u4) = isqrt(x)\n  ucas: range it\nrange of it -> u4:\n  0..3   (4 distinct values)\n  values: 0..3\n  fits in u2\n  over all 16 points of the domain\n"}, "isError": false}}
