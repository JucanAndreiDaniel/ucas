{"jsonrpc": "2.0", "id": 7, "result": {"content": [{"type": "text", "text": "fibonacci: a[n+2] = a[n+1] + a[n], a[0] = 0, a[1] = 1\n  a[n] = sqrt(5)*((1 + sqrt(5))/2)^n/5 - sqrt(5)*((1 - sqrt(5))/2)^n/5\n  G(x) = sum_{n>=0} a_n x^n = x/(1 - x - x^2)    for |x| < (-1 + sqrt(5))/2\n  check: sum_n a_n x^n at x = (-1 + sqrt(5))/4 is 0.518927630227216, G = 0.518927630227215 (difference 1.1e-16)\n"}], "structuredContent": {"id": 7, "ok": true, "cmd": "genfunc", "ucas": "genfunc fibonacci", "structured": true, "result": {"kind": "genfunc", "a[n]": "sqrt(5)*((1 + sqrt(5))/2)^n/5 - sqrt(5)*((1 - sqrt(5))/2)^n/5", "G(x)": {"value": "sum_{n>=0} a_n x^n = x/(1 - x - x^2)", "valid_for": "|x| < (-1 + sqrt(5))/2"}, "headline": "fibonacci: a[n+2] = a[n+1] + a[n], a[0] = 0, a[1] = 1"}, "notes": [], "conditions": [], "checks": [{"kind": "check", "passed": true, "text": "sum_n a_n x^n at x = (-1 + sqrt(5))/4 is 0.518927630227216, G = 0.518927630227215 (difference 1.1e-16)"}], "files": [], "text": "fibonacci: a[n+2] = a[n+1] + a[n], a[0] = 0, a[1] = 1\n  a[n] = sqrt(5)*((1 + sqrt(5))/2)^n/5 - sqrt(5)*((1 - sqrt(5))/2)^n/5\n  G(x) = sum_{n>=0} a_n x^n = x/(1 - x - x^2)    for |x| < (-1 + sqrt(5))/2\n  check: sum_n a_n x^n at x = (-1 + sqrt(5))/4 is 0.518927630227216, G = 0.518927630227215 (difference 1.1e-16)\n"}, "isError": false}}
