{"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "error (ambiguous): \"not\" of a number\nambiguous: set args.assume.not to one of:\n  1) bitwise not, ~ (default)\n  2) logical not, !\nrepeat the request with args.assume.not set to a reading (or its index), or args.defaults = true to take the default; or: say \"bitwise not\" or \"logical not\""}], "structuredContent": {"id": 2, "ok": false, "cmd": "english", "ucas": "is not not x even?", "structured": true, "result": {"kind": "english", "statements": [], "understood": false}, "notes": [{"kind": "ambiguous", "text": "not: also ambiguous: \"not\" of a number; read as bitwise not, ~; say \"bitwise not\" or \"logical not\""}, {"kind": "ambiguous", "text": "question: also ambiguous: \"even\"; read as an even function, f(-x) = f(x); say \"an even function\" or \"always even\""}], "conditions": [], "checks": [], "files": [], "text": "", "error": {"code": "ambiguous", "message": "\"not\" of a number", "key": "not", "readings": [{"index": 1, "reading": "bitwise not, ~", "default": true}, {"index": 2, "reading": "logical not, !", "default": false}], "how": "repeat the request with args.assume.not set to a reading (or its index), or args.defaults = true to take the default; or: say \"bitwise not\" or \"logical not\""}}, "isError": true}}
