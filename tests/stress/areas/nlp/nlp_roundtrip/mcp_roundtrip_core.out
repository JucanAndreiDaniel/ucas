{"jsonrpc": "2.0", "id": 4, "result": {"content": [{"type": "text", "text": "  ucas: it(x: i8) = x^2\n  ucas: range it\nrange of it -> i8:\n  -127..121   (44 distinct values)\n  values: -127, -124, -119, -112..-111, -103, -95, -92, -87, -79, -71, -63, -60, -55, -47, -39, -31, -28, -23, -15, -7, 0..1, 4, 9, 16..17, ...\n  fits in i8\n  over all 256 points of the domain\n"}], "structuredContent": {"id": 4, "ok": true, "cmd": "english", "ucas": "what is the range of x squared for a signed byte x?", "structured": true, "result": {"kind": "english", "statements": ["it(x: i8) = x^2", "range it"], "understood": true, "results": [{"kind": "range", "type": "i8", "empty": false, "exhaustive": true, "points": 256, "undefined_points": 0, "min": {"value": -127, "exact": "-127"}, "max": {"value": 121, "exact": "121"}, "distinct": 44, "values": [-127, -124, -119, -112, -111, -103, -95, -92, -87, -79, -71, -63, -60, -55, -47, -39, -31, -28, -23, -15, -7, 0, 1, 4, 9, 16, 17, 25, 33, 36, 41, 49, 57, 64, 65, 68, 73, 81, 89, 97, 100, 105, 113, 121], "fits": "i8"}]}, "notes": [], "conditions": [], "checks": [], "proof": {"kind": "exhaustive", "text": "every point of the domain evaluated"}, "files": [], "text": "  ucas: it(x: i8) = x^2\n  ucas: range it\nrange of it -> i8:\n  -127..121   (44 distinct values)\n  values: -127, -124, -119, -112..-111, -103, -95, -92, -87, -79, -71, -63, -60, -55, -47, -39, -31, -28, -23, -15, -7, 0..1, 4, 9, 16..17, ...\n  fits in i8\n  over all 256 points of the domain\n"}, "isError": false}}
