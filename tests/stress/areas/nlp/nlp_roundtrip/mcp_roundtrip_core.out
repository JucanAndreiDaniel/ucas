{"jsonrpc": "2.0", "id": 22, "result": {"content": [{"type": "text", "text": "  ucas: it(n: int in 0..100) = sum(i, 1, n, i^2)\n  ucas: closed it\nsum(i, 1, n, i^2)\n  = n*(n + 1)*(2n + 1)/6\n  method: Faulhaber (polynomial in the index)\n  check: equals direct iteration at all 101 points of the domain\n"}], "structuredContent": {"id": 22, "ok": true, "cmd": "english", "ucas": "the closed form of the sum of i squared for i from 1 to n", "structured": true, "result": {"kind": "english", "statements": ["it(n: int in 0..100) = sum(i, 1, n, i^2)", "closed it"], "understood": true, "results": [{"kind": "closed", "loops": [{"loop": "sum(i, 1, n, i^2)", "closed_form": "n*(n + 1)*(2n + 1)/6", "accepted": true, "checked": true, "method": ["Faulhaber (polynomial in the index)"]}]}]}, "notes": [], "conditions": [], "checks": [{"kind": "iteration", "points": 101, "max_diff": 0, "passed": true, "text": "against direct iteration on every point of the domain"}], "proof": {"kind": "exhaustive", "text": "equals direct iteration on every point of the domain"}, "files": [], "text": "  ucas: it(n: int in 0..100) = sum(i, 1, n, i^2)\n  ucas: closed it\nsum(i, 1, n, i^2)\n  = n*(n + 1)*(2n + 1)/6\n  method: Faulhaber (polynomial in the index)\n  check: equals direct iteration at all 101 points of the domain\n"}, "isError": false}}
