{"jsonrpc": "2.0", "id": 3, "result": {"content": [{"type": "text", "text": "  note: read \"equivlent\" as \"equivalent\"\n  ucas: it(x) = x^2\n  ucas: that(x) = x*x\n  ucas: equiv it that\nit and that are equal on the domain of it (proved by algebra: f - g simplifies to 0 over Q)\n"}], "structuredContent": {"id": 3, "ok": true, "cmd": "english", "ucas": "is x^2 equivlent to x*x", "structured": true, "result": {"kind": "english", "statements": ["it(x) = x^2", "that(x) = x*x", "equiv it that"], "understood": true, "results": [{"kind": "equiv", "equal": true, "exhaustive": false, "mismatch_points": 0, "method": "algebra"}]}, "notes": [{"kind": "info", "text": "read \"equivlent\" as \"equivalent\""}], "conditions": [], "checks": [], "proof": {"kind": "derivation", "text": "proved by algebra: f - g simplifies to 0 over Q"}, "files": [], "text": "  note: read \"equivlent\" as \"equivalent\"\n  ucas: it(x) = x^2\n  ucas: that(x) = x*x\n  ucas: equiv it that\nit and that are equal on the domain of it (proved by algebra: f - g simplifies to 0 over Q)\n"}, "isError": false}}
