{"jsonrpc": "2.0", "id": 25, "result": {"content": [{"type": "text", "text": "  ucas: it(x) = 1/x\n  ucas: domain it\ndomain of it:\n  x: real (default [-10, 10])\n  requires x != 0  (in 1/x)\n  defined on (numerically, grid of 20001 over [-10, 10]):\n    x in [-10, 0)\n    x in (0, 10]\n    except x ≈ 0  (x = 0)\n"}], "structuredContent": {"id": 25, "ok": true, "cmd": "english", "ucas": "where is 1 divided by x defined", "structured": true, "result": {"kind": "english", "statements": ["it(x) = 1/x", "domain it"], "understood": true, "results": [{"kind": "domain", "conditions": [{"kind": "requires", "text": "x != 0  (in 1/x)"}], "method": "numeric: a grid, boundaries by bisection", "intervals": [{"lo": -10, "hi": 0, "lo_closed": true, "hi_closed": false}, {"lo": 0, "hi": 10, "lo_closed": false, "hi_closed": true}], "except": [0]}]}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "  ucas: it(x) = 1/x\n  ucas: domain it\ndomain of it:\n  x: real (default [-10, 10])\n  requires x != 0  (in 1/x)\n  defined on (numerically, grid of 20001 over [-10, 10]):\n    x in [-10, 0)\n    x in (0, 10]\n    except x ≈ 0  (x = 0)\n"}, "isError": false}}
