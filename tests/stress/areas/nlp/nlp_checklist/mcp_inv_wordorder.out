{"jsonrpc": "2.0", "id": 11, "result": {"content": [{"type": "text", "text": "  ucas: it(x: u8) = 1/x\n  ucas: domain it\ndomain of it:\n  x: u8, 0..255\n  requires x != 0  (in 1/x)\n  defined at 255 of 256 points\n  defined for: 1..255\n  undefined e.g. at x=0\n  C undefined behaviour at 1 points, e.g. x=0\n  over all 256 points of the domain\n"}], "structuredContent": {"id": 11, "ok": true, "cmd": "english", "ucas": "where is 1/x defined for x an unsigned byte", "structured": true, "result": {"kind": "english", "statements": ["it(x: u8) = 1/x", "domain it"], "understood": true, "results": [{"kind": "domain", "conditions": [{"kind": "requires", "text": "x != 0  (in 1/x)"}], "defined_points": 255, "points": 256, "exhaustive": true, "c_ub_points": 1, "undefined_example": "x=0", "c_ub_example": "x=0"}]}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "  ucas: it(x: u8) = 1/x\n  ucas: domain it\ndomain of it:\n  x: u8, 0..255\n  requires x != 0  (in 1/x)\n  defined at 255 of 256 points\n  defined for: 1..255\n  undefined e.g. at x=0\n  C undefined behaviour at 1 points, e.g. x=0\n  over all 256 points of the domain\n"}, "isError": false}}
