{"jsonrpc": "2.0", "id": 15, "result": {"content": [{"type": "text", "text": "the 2x2 matrix over GF(5)\n  [1 2]\n  [3 4]\n  det = 3\n  inverse:\n    [3 1]\n    [4 2]\n  check: M * M^-1 = I\n"}], "structuredContent": {"id": 15, "ok": true, "cmd": "matrix", "ucas": "inverse [[1, 2], [3, 4]] mod 5", "structured": true, "result": {"kind": "inverse", "det": "3", "headline": "the 2x2 matrix over GF(5)", "details": ["[1 2]", "[3 4]", "inverse:", "[3 1]", "[4 2]"]}, "notes": [], "conditions": [], "checks": [{"kind": "check", "passed": true, "text": "M * M^-1 = I"}], "files": [], "text": "the 2x2 matrix over GF(5)\n  [1 2]\n  [3 4]\n  det = 3\n  inverse:\n    [3 1]\n    [4 2]\n  check: M * M^-1 = I\n"}, "isError": false}}
