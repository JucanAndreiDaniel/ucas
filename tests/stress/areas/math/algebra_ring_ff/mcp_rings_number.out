{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "phi(1) = 1\n  how: 1 = 1; phi = product of p^(e-1) (p - 1): 1 (the empty product)\n  the order of the unit group (Z/1)*; lambda(1) = 1 is its exponent\n  check: counted the k in 1..1 with gcd(k, 1) = 1: 1\n"}], "structuredContent": {"id": 1, "ok": true, "cmd": "phi", "ucas": "phi 1", "structured": true, "result": {"kind": "phi", "method": "1 = 1; phi = product of p^(e-1) (p - 1): 1 (the empty product)", "lhs": "phi(1)", "value": "1", "value_int": 1, "headline": "phi(1) = 1", "details": ["the order of the unit group (Z/1)*; lambda(1) = 1 is its exponent"]}, "notes": [], "conditions": [], "checks": [{"kind": "check", "passed": true, "text": "counted the k in 1..1 with gcd(k, 1) = 1: 1"}], "files": [], "text": "phi(1) = 1\n  how: 1 = 1; phi = product of p^(e-1) (p - 1): 1 (the empty product)\n  the order of the unit group (Z/1)*; lambda(1) = 1 is its exponent\n  check: counted the k in 1..1 with gcd(k, 1) = 1: 1\n"}, "isError": false}}
