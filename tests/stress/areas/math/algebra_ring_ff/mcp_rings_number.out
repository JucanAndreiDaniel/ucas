{"jsonrpc": "2.0", "id": 24, "result": {"content": [{"type": "text", "text": "x^2 = 4 mod 7: x = 2, 5\n  how: p = 3 mod 4: x = a^((p+1)/4)\n  check: 2^2 = 4, 5^2 = 4 (mod 7); brute force over 0..6: 2 solutions\n"}], "structuredContent": {"id": 24, "ok": true, "cmd": "sqrtmod", "ucas": "sqrtmod 4 mod 7", "structured": true, "result": {"kind": "sqrtmod", "modulus": "7", "solutions": 2, "roots": [2, 5], "method": "p = 3 mod 4: x = a^((p+1)/4)", "headline": "x^2 = 4 mod 7: x = 2, 5"}, "notes": [], "conditions": [], "checks": [{"kind": "check", "passed": true, "text": "2^2 = 4, 5^2 = 4 (mod 7); brute force over 0..6: 2 solutions"}], "files": [], "text": "x^2 = 4 mod 7: x = 2, 5\n  how: p = 3 mod 4: x = a^((p+1)/4)\n  check: 2^2 = 4, 5^2 = 4 (mod 7); brute force over 0..6: 2 solutions\n"}, "isError": false}}
