{"jsonrpc": "2.0", "id": 20, "result": {"content": [{"type": "text", "text": "  note: 9 is not prime: the Legendre symbol is not defined; this is the Jacobi symbol\n(2/9) = 1\n  how: quadratic reciprocity; the product of the Legendre symbols over 9 = 3^2\n  9 is composite: (a/n) = 1 does not make a a square mod n; here 2 is not a square mod 9\n"}], "structuredContent": {"id": 20, "ok": true, "cmd": "legendre", "ucas": "legendre 2 9", "structured": true, "result": {"kind": "legendre", "method": "quadratic reciprocity; the product of the Legendre symbols over 9 = 3^2", "9_is_composite": "(a/n) = 1 does not make a a square mod n; here 2 is not a square mod 9", "lhs": "(2/9)", "value": "1", "value_int": 1, "headline": "(2/9) = 1"}, "notes": [{"kind": "info", "text": "9 is not prime: the Legendre symbol is not defined; this is the Jacobi symbol"}], "conditions": [], "checks": [], "files": [], "text": "  note: 9 is not prime: the Legendre symbol is not defined; this is the Jacobi symbol\n(2/9) = 1\n  how: quadratic reciprocity; the product of the Legendre symbols over 9 = 3^2\n  9 is composite: (a/n) = 1 does not make a a square mod n; here 2 is not a square mod 9\n"}, "isError": false}}
