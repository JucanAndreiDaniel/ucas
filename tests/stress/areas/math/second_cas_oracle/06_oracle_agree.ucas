# Representative broad agreement with SymPy (expand/factor/diff/integrate/
# det/factorint/limit/taylor). All results here match the oracle.
expand (x+1)^10
factor x^9 - 1
diff sin(x)*exp(x)
integrate x^2*log(x)
zmat det [[1,2,3],[4,5,6],[7,8,10]]
factorint 123456789
limit sin(x)/x x -> 0
taylor sin(x) order 7
gcd x^3-1, x^2-1
resultant x^2-2, x^2-3x+2
