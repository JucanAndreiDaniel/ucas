# Table lookup and match with mixed arm types (silent narrowing to first arm's type).
show [1,2,3][0]
show [u8(1), i8(2)][0]
show match 1 { 0 => u8(1), _ => i8(2) }
show match 1 { 0 => 3, _ => 4.5 }
show match 1 { 0=>u8(1), 1=>i8(-1), _=>f32(2.5) }
days(m: u8) = match m { 2 => 28, 4 | 6 | 9 | 11 => 30, _ => 31 }
show days
range days
m1(x: int in 0..2) = match x { 0 => u8(1), _ => i8(-1) }
show m1
range m1
m2(x: int in 0..2) = match x { 0 => u32(1), _ => i32(-1) }
range m2
