# Implicit/coerced type inference in mixed-type expressions.
show 1 + 2
show u8(1) + i8(2)
show i8(2) + u8(1)
show u32(1) + i32(2)
show u64(1) + i64(2)
show u8(200) + i8(-100)
show u8(1) + i8(-2)
show u64(1) - i64(2)
show i64(-1) < u64(1)
show u32(1) < i32(-1)
show i32(-1) < u32(1)
show u8(255) == i8(-1)
show f16(1) + f32(2)
show f16(1) + f64(2)
show f32(1) + f64(2)
show f16(1) * f32(2) + f64(3)
show int(3) + f64(0.5)
show real(3) + f64(0.5)
show bool(1) + int(2)
show (1 < 2) + 3
