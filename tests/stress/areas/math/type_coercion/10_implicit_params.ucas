# Untyped parameters default to real, or int when integer-only operators appear.
f(x) = x & 255
show f
ft(x: int) = x & 255
show ft
range f
range ft
p1(x) = x < 5 ? x : 0
show p1
p2(x) = x & 3
show p2
p3(x) = x + 1
show p3
p4(x) = asuint(x)
show p4
p5(x) = real(x) + 1
show p5
p6(x) = u8(x) + 1
show p6
