# asuint / asint / asfloat reinterpretation chains and operand typing.
show asuint(1)
show asint(1)
show asfloat(1)
show asuint(f32(1))
show asint(f32(-1))
show asfloat(asuint(f32(1)))
show asuint(asint(f32(-1)))
show asint(asuint(f32(1)))
show asfloat(u32(1065353216))
show asuint(i32(-1))
show asint(u32(4294967295))
show asuint(f16(1))
show asuint(f64(1))
show asfloat(asuint(f64(1)))
show asint(asfloat(u32(4294967295)))
show asfloat(asuint(asfloat(asuint(1.0))))
