diff x^3 - 3x
diff x^4 + x^2*y + y^3 x y
F'' x^4
limit sin(x)/x x -> 0
limit 1/x x -> 0+
limit 1/x x -> 0-
limit (x^2-1)/(x-1) x -> 1
limit x - sqrt(x^2+1) x -> inf
limit sin(1/x) x -> 0
limit x*sin(1/x) x -> 0
taylor sin(x) x at 0 order 7
taylor log(x) x at 1 order 4
implicit x^2+y^2=1 for y wrt x
x' = 1; x(0)=0
dsolve x
