# Limits at essential / oscillatory singularities and indeterminate forms.
limit sin(1/x) x -> 0
limit x*sin(1/x) x -> 0
limit exp(-1/x^2) x -> 0
limit exp(-1/x^2)/x x -> 0
limit (x - sin(x))/x^3 x -> 0
limit (tan(x) - x)/x^3 x -> 0
limit (log(1+x) - x)/x^2 x -> 0
limit x^x x -> 0+
limit x^(1/x) x -> 0+
limit (1 + 1/x)^x x -> inf
limit sqrt(x^2 + x) - x x -> inf
limit exp(-1/x) x -> 0+
limit exp(-1/x) x -> 0-
limit 1/(x - sin(x)) x -> 0
limit (1+1/x)^(x^2) x -> inf
