# L'Hopital applied to non-differentiable floor/ceil: WRONG limits at inf.
limit floor(x)/x x -> inf
limit ceil(x)/x x -> inf
limit floor(2*x)/x x -> inf
limit floor(x^2)/x^2 x -> inf
limit (x - floor(x))/x x -> inf
limit (x - floor(x)) x -> inf
limit floor(x)/x x -> -inf
# Correct behaviour at 0 (floor is piecewise constant there)
limit floor(x)/x x -> 0
# Smooth limits for contrast (all correct)
limit x*sin(1/x) x -> inf
limit sin(x)/x x -> inf
