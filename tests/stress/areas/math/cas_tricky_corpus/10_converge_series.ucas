# Convergence tests across series/product shapes.
converge (-1)^n/n
converge 1/n^4
converge 1/(n*log(n)^2)
converge (-1)^n*n/(n+1)
converge n!/n^n
converge n^n/n!
converge 1/n^(1+1/n)
converge 1/log(n)
converge 1/sqrt(n)
prod(n,1,inf,1+1/n^2)
prod(n,2,inf,1-1/n^2)
prod(n,1,inf,n/(n+1))
sum(n,1,inf,1/(n*(n+1)))
sum(n,1,inf,1/(4*n^2-1))
