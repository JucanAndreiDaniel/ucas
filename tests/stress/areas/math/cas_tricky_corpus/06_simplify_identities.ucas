# Simplification identities and zero-polynomials that simplify badly.
simplify sin(x)^2 + cos(x)^2 - 1
simplify 1 - cos(x)^2 - sin(x)^2
simplify tan(x)^2 + 1 - 1/cos(x)^2
simplify sqrt(x^2)
simplify (sqrt(x))^2
simplify abs(x)^2 - x^2
simplify exp(log(x))
simplify log(exp(x))
simplify log(-1)
simplify sqrt(-1)
simplify (x^2 - 1)/(x - 1) - (x + 1)
simplify (x+1)^3 - x^3 - 3*x^2 - 3*x - 1
simplify atan(tan(x))
simplify arcsin(sin(x))
