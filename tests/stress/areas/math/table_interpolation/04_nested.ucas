# Nested tables with constant indices (folded lookups).
show [[1,2],[3,4]][0][0]
show [[1,2],[3,4]][0][1]
show [[1,2],[3,4]][1][0]
show [[1,2],[3,4]][1][1]
show [[1,2],[3,4]][0][2]
show [[[1,2],[3,4]],[[5,6],[7,8]]][1][1][0]
show [[[1]],[[2]]][1][0][0]
show [1,2,3][ [[0,1],[2,3]][1][1] ]
T = [[10,20],[30,40]]
i = 1
show T[i][0]
f(x: u8 in 0..1) = [[10,20],[30,40]][x]
show f(1)
