# find: packed one-constant tables and baseline lookup, reused as lookups.
tabf(d: u4 in 0..9) = [1,0,1,1,0,1,1,1,1,1][d]
find tabf
pkf(d: u4 in 0..9) = int(0x3ed >> u32(d) & 1)
equiv tabf pkf
days(m: u8 in 1..12) = match m { 2 => 28, 4|6|9|11 => 30, _ => 31 }
find days
days_pk(m: u8 in 1..12) = u8(0x3bbeecc >> (u32(m) << 1) & 3) + 28
equiv days days_pk
