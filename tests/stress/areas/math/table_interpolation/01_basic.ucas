# Basic lookup semantics: in-range, out-of-range, negative, 1/2/8/16 entries.
show [10,20,30][0]
show [10,20,30][1]
show [10,20,30][2]
show [10,20,30][3]
show [10,20,30][4]
show [10,20,30][-1]
show [7][0]
show [7][1]
show [7][-1]
show [1,2][u8(256)]
show [1,2][u8(255)]
idx(i: u8) = i mod 2
show [10,20][idx(5)]
show [10,20][idx(4)]
t(x: u8 in 0..15) = [3,1,4,1,5,9,2,6,5,3,5,8,9,7,9,3][x]
table t
range t
domain t
