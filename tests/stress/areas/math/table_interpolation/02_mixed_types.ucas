# Mixed element types: common-type promotion and literal narrowing notes.
show [u8(10),u16(300),u32(70000)][0]
show [u8(10),u16(300),u32(70000)][1]
show [u8(10),u16(300),u32(70000)][2]
show [i8(-1),u8(200)][0]
show [i8(-1),u8(200)][1]
show [u8(255),i16(-1)][0]
show [u8(255),i16(-1)][1]
show [u8(1),f32(2.5)][0]
show [u8(1),f32(2.5)][1]
show [1,2.5,3][1]
show [f32(1.5),f64(2.25)][0]
show [f32(1.5),f64(2.25)][1]
show [1, u8(2), 300][2]
show [true,false,true][3]
show [f32(1.5),f32(2.5)][5]
