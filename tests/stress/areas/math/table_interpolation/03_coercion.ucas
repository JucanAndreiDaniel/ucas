# Index coercion across integer/bool widths: wrapping and sign.
show [10,20,30,40][u8(1)]
show [10,20,30,40][u8(256)]
show [10,20,30,40][u8(255)]
show [10,20,30,40][i8(-1)]
show [10,20,30,40][i8(127)]
show [10,20,30,40][i1(-1)]
show [10,20,30,40][i2(-1)]
show [10,20,30,40][i2(1)]
show [10,20,30,40][u1(1)]
show [10,20,30,40][u64(18446744073709551615)]
show [10,20,30,40][u64(9223372036854775808)]
show [10,20,30,40][true]
show [10,20,30,40][false]
show [10,20,30,40][1+1]
show [10,20,30,40][2*2]
show [10,20,30,40][u8(3)+1]
show [10,20,30,40][int(-3)]
