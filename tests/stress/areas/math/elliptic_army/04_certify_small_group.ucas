# BUG-2: exact counts on tiny groups whose point/twist exponents do not
# separate the Hasse candidates used to fail certification (e.g. #E(F_7)=12,
# both E and its twist have exponent 2/6, so 6 and 12 both survived).
ecorder [0,0,0,0,1] mod 7
ecorder [0,0,0,1,5] mod 5
ecorder [0,0,0,1,2] mod 11
ecorder [0,0,0,4,5] mod 11
ecorder [0,0,0,3,7] mod 7
ecorder [0,0,0,1,7] mod 17
# controls: certificate path still works on ordinary curves
ecorder [0,0,0,2,3] mod 97
ec y^2 = x^3 + 1 mod 7
ecpoints [0,0,0,0,1] mod 7
