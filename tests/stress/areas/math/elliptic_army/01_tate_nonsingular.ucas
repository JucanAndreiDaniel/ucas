# WRONG-1 regression: Tate's algorithm at p=2,3 on nonsingular curves.
# These all used to die with "internal: X is not divisible by 64/256/729".
ec y^2 = x^3 - 12*x local
ec y^2 = x^3 - 108*x local
ec y^2 = x^3 - 115*x - 14 local
ec y^2 = x^3 - 120*x - 11 local
ec [-266,386,-238,218,111] local
# controls: good reduction, the other additive types, multiplicative, twist
ec y^2 = x^3 + x local
ec y^2 = x^3 + 1 local
ec y^2 = x^3 - x local
ec y^2 + y = x^3 - x^2 - 10*x - 20 local
ec y^2 = x^3 + 2x + 3 local
