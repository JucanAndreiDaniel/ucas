# Control set: idempotence / canonicity DOES hold for these.
# simplify(simplify(e)) == simplify(e)
simplify (x+1)*(x-1)
simplify x**2 - 1
simplify sin(x)**2 + cos(x)**2
simplify 1/x + 1/y
simplify (x + y)/(x*y)
simplify exp(a)*exp(b)
simplify abs(x)*abs(x)
simplify max(x,y) + min(x,y)
simplify I*I
# expand(expand(e)) == expand(e)
expand (x+1)**2
expand x**2 + 2*x + 1
# factor(factor(e)) == factor(e)
factor x**4 - 1
factor (x - 1)*(x + 1)*(x**2 + 1)
# simplify(expand(e)) == simplify(factor(e)) for polynomials
expand (x+2)**3
factor x**3 + 6*x**2 + 12*x + 8
simplify x**3 + 6*x**2 + 12*x + 8
simplify (x + 2)**3
