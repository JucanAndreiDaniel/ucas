e1(x: real in 0..1) = x
crit e1
e2(x: real in 0..1) = -x
crit e2
e3(x: real in 2..8) = (x-5)^2
crit e3
e4(x: real in -100..100) = (x-50)^2
crit e4
e5(x: real in -20..20) = sin(x)
crit e5
e6(x: real in 0..3) = x^3 - 3x
crit e6
f1(x: real, y: real) = x^2 + y^2
crit f1
f2(x: real, y: real) = x^2 - y^2
crit f2
f3(x: real, y: real) = x*y
crit f3
