{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "prod(n, 1, inf, n^2/(n^2 - 1))\n  converges: the factors are 1 + O(1/n^2) (sum |a_n - 1| converges)\n  = inf\n  method: the factors as (n - a_i)/(n - b_i): prod Gamma(1 - b_i)/Gamma(1 - a_i)\n  numeric: 0 (partial products to 4096, Richardson in 1/N twice; estimated error 0)\n  check: DISAGREE (difference inf)\n"}], "structuredContent": {"id": 1, "ok": true, "cmd": "infinite_product", "ucas": "prod(n, 1, inf, n^2/(n^2-1))", "structured": true, "result": {"kind": "infinite_product", "converges": "the factors are 1 + O(1/n^2) (sum |a_n - 1| converges)", "value": "inf", "method": "the factors as (n - a_i)/(n - b_i): prod Gamma(1 - b_i)/Gamma(1 - a_i)", "numeric": "0 (partial products to 4096, Richardson in 1/N twice; estimated error 0)", "headline": "prod(n, 1, inf, n^2/(n^2 - 1))"}, "notes": [], "conditions": [], "checks": [{"kind": "check", "passed": true, "text": "DISAGREE (difference inf)"}], "files": [], "text": "prod(n, 1, inf, n^2/(n^2 - 1))\n  converges: the factors are 1 + O(1/n^2) (sum |a_n - 1| converges)\n  = inf\n  method: the factors as (n - a_i)/(n - b_i): prod Gamma(1 - b_i)/Gamma(1 - a_i)\n  numeric: 0 (partial products to 4096, Richardson in 1/N twice; estimated error 0)\n  check: DISAGREE (difference inf)\n"}, "isError": false}}
