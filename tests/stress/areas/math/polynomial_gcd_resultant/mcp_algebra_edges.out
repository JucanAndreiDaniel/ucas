{"jsonrpc": "2.0", "id": 5, "result": {"content": [{"type": "text", "text": "resultant x^2 - 2, x^2 - 3\n  in x: 1\n  nonzero: no common root\n  check: lc(P)^deg(Q) * product of Q over the roots of P = 1 (agrees)\n"}], "structuredContent": {"id": 5, "ok": true, "cmd": "resultant", "ucas": "resultant x^2-2, x^2-3 in x", "structured": true, "result": {"kind": "resultant", "p": "x^2 - 2", "q": "x^2 - 3", "var": "x", "result": "1"}, "notes": [], "conditions": [], "checks": [], "files": [], "text": "resultant x^2 - 2, x^2 - 3\n  in x: 1\n  nonzero: no common root\n  check: lc(P)^deg(Q) * product of Q over the roots of P = 1 (agrees)\n"}, "isError": false}}
