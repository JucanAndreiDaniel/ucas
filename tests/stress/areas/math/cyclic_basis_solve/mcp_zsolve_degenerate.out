{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "y[n+1] = 2y[n] + 1, y[0] = 0\n  note: y[0] not given: taken as 0\n  transformed: (z - 2)Y(z) = z/(z - 1)\n  Y(z) = z/((z - 1)*(z - 2))\n  y[n] = 2^n - 1    for n >= 0\n  poles of Y: 1, 2\n  check: iterating the recurrence gives the same y[0..39] (max relative difference 0)\n"}], "structuredContent": {"id": 1, "ok": true, "cmd": "ucas", "ucas": "zsolve y[n+1] = 2y[n] + 1", "structured": true, "result": {"kind": "zsolve", "transformed": "(z - 2)Y(z) = z/(z - 1)", "Y(z)": "z/((z - 1)*(z - 2))", "y[n]": {"value": "2^n - 1", "valid_for": "n >= 0"}, "poles_of_y": "1, 2", "headline": "y[n+1] = 2y[n] + 1, y[0] = 0"}, "notes": [{"kind": "rule", "text": "y[0] not given: taken as 0"}], "conditions": [], "checks": [{"kind": "check", "passed": true, "text": "iterating the recurrence gives the same y[0..39] (max relative difference 0)"}], "files": [], "text": "y[n+1] = 2y[n] + 1, y[0] = 0\n  note: y[0] not given: taken as 0\n  transformed: (z - 2)Y(z) = z/(z - 1)\n  Y(z) = z/((z - 1)*(z - 2))\n  y[n] = 2^n - 1    for n >= 0\n  poles of Y: 1, 2\n  check: iterating the recurrence gives the same y[0..39] (max relative difference 0)\n"}, "isError": false}}
