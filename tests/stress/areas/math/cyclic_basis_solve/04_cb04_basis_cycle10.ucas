basis p0 : p9 { g0(x) = ~x }
basis p1 : p0 { g1(x) = ~x }
basis p2 : p1 { g2(x) = ~x }
basis p3 : p2 { g3(x) = ~x }
basis p4 : p3 { g4(x) = ~x }
basis p5 : p4 { g5(x) = ~x }
basis p6 : p5 { g6(x) = ~x }
basis p7 : p6 { g7(x) = ~x }
basis p8 : p7 { g8(x) = ~x }
basis p9 : p8 { g9(x) = ~x }
f(x: bool) = ~x
gates f basis p0
