# Controls: non-fma calculus paths are unchanged, and the fma print path
# (the original crash was a malformed node recursing on node 0 in the printer)
# must work.  A plain fma prints with all three operands.
diff x^3 - 3x
diff x^4 + x^2*y + y^3 x y
F(x) = sin(x)
F'(1)
F''(1)
taylor sin(x) x at 0 order 5
parse fma(x,x,x)
parse sin(fma(x,x,x))
simplify sin(fma(x,x,x))
