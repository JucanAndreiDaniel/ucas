# floating z on / just above / just below the negative-real cut; signed zeros.
arg(-1)
arg(-1+0.0i)
arg(-1-0.0i)
arg(1+0.0i)
arg(1-0.0i)
arg(0+0.0i)
complex sqrt(-1+0.0i)
complex sqrt(-1-0.0i)
complex sqrt(-1.0)
complex (-1.0)^(0.5)
complex log(-1+0.0i)
complex log(-1-0.0i)
complex log(-1+i*0.000001)
complex log(-1-i*0.000001)
complex sqrt(-1+i*0.000001)
complex sqrt(-1-i*0.000001)
complex arg(-1+i*1e-12)
complex arg(-1-i*1e-12)
