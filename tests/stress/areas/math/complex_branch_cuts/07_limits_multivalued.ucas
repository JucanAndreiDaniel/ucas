# limits across the cut and multi-valued log/pow identities.
limit log(z) z -> -1
limit sqrt(z) z -> -1
limit log(z) z -> 1
complex log(z^2)
complex sqrt(z^2)
complex re(log(z))
complex im(log(z))
complex re(sqrt(z))
complex im(sqrt(z))
complex log((-1)^2)
complex sqrt((-1)^2)
complex log(-1)^(1/2)
complex exp(2*log(z))
complex log(exp(z))
