g1(x: f32 in 0..1) = x
g2(x: f32 in 0..1) = x+0
equiv g1 g2
g3(x: f16) = x
g4(x: f16) = x+0
equiv g3 g4
g5(x: f32 in 0..1) = x+x
g6(x: f32 in 0..1) = 2*x
equiv g5 g6 ftz
g7(x: f32 in 0..1) = x+x
g8(x: f32 in 0..1) = 2*x
equiv g7 g8 noftz
g9(x: f32 in 0..1) = x*x
g10(x: f32 in 0..1) = x^2
equiv g9 g10 nanbits
