# Reproducer: psi_37 over F_5 has a single irreducible factor of degree 684.
# The old px_ddf() capped distinct-degree factorisation at 599, so it returned
# -1 and cmd_ecdivpoly printed "torsion field: not determined".  The true
# torsion field is F_5^684 (the lcm of the factor degrees).
ecdivpoly [2,1] mod 5 37
# another curve with the same large (684) factor degree
ecdivpoly [3,3] mod 5 37
# control: over F_5 most curves have factor degrees <= 599 (lcm 36)
ecdivpoly [1,1] mod 5 37
