{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "solve x*y = 0, x + y = 1 for x, y\n  eliminating y: the resultant in x is x*(x - 1)\n  x = 1, y = 0\n  check: 1 solution substituted into both equations: residual 0\n"}], "structuredContent": {"id": 1, "ok": true, "cmd": "solve", "ucas": "solve x*y = 0, x + y = 1 for x, y", "structured": true, "result": {"kind": "solve", "equations": ["x*y = 0", "x + y = 1"], "unknowns": ["x", "y"], "solutions": [{"x": "1", "y": "0"}]}, "notes": [], "conditions": [], "checks": [{"kind": "substitution", "points": 1, "max_diff": 0, "passed": true}], "files": [], "text": "solve x*y = 0, x + y = 1 for x, y\n  eliminating y: the resultant in x is x*(x - 1)\n  x = 1, y = 0\n  check: 1 solution substituted into both equations: residual 0\n"}, "isError": false}}
