> domain asin(x: real)
domain of asin(x):
  x: real (default [-10, 10])
  requires -1 <= x <= 1
  defined on (numerically, grid of 20001 over [-10, 10]):
    x in [-1, 1]
> domain acos(x: real)
domain of acos(x):
  x: real (default [-10, 10])
  requires -1 <= x <= 1
  defined on (numerically, grid of 20001 over [-10, 10]):
    x in [-1, 1]
> domain acosh(x: real)
domain of acosh(x):
  x: real (default [-10, 10])
  requires x >= 1
  defined on (numerically, grid of 20001 over [-10, 10]):
    x in [1, 10]
> domain atanh(x: real)
domain of atanh(x):
  x: real (default [-10, 10])
  requires -1 < x < 1
  defined on (numerically, grid of 20001 over [-10, 10]):
    x in (-1, 1)
> domain W(x: real)
domain of W(x):
  x: real (default [-10, 10])
  requires x >= -1/e  (Lambert W, principal branch)
  defined on (numerically, grid of 20001 over [-10, 10]):
    x in [-0.3678794412, 10]
> domain W0(x: real)
domain of W(x):
  x: real (default [-10, 10])
  requires x >= -1/e  (Lambert W, principal branch)
  defined on (numerically, grid of 20001 over [-10, 10]):
    x in [-0.3678794412, 10]
> domain Wm1(x: real)
domain of Wm1(x):
  x: real (default [-10, 10])
  requires -1/e <= x < 0  (Lambert W, branch -1)
  defined on (numerically, grid of 20001 over [-10, 10]):
    x in [-0.3678794412, 0)
