f1(x: real) = asin(x)
f2(x: real) = arcsin(x)
equiv f1 f2
g1(x: real) = acos(x)
g2(x: real) = arccos(x)
equiv g1 g2
h1(x: real) = atan(x)
h2(x: real) = arctan(x)
equiv h1 h2
i1(x: real) = asinh(x)
i2(x: real) = arsinh(x)
equiv i1 i2
j1(x: real) = acosh(x)
j2(x: real) = arcosh(x)
equiv j1 j2
k1(x: real) = atanh(x)
k2(x: real) = artanh(x)
equiv k1 k2
l1(x: real) = log(x)
l2(x: real) = ln(x)
equiv l1 l2
