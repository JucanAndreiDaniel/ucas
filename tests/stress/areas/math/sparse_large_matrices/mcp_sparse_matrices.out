{"jsonrpc": "2.0", "id": 3, "result": {"content": [{"type": "text", "text": "Smith normal form of the 3x3 matrix: diag(2, 6, 12), rank 3\n  D: [[2, 0, 0], [0, 6, 0], [0, 0, 12]]\n  U: [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n  V: [[1, -2, 0], [0, 1, 0], [0, 0, 1]]\n  U^-1: [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n  V^-1: [[1, 2, 0], [0, 1, 0], [0, 0, 1]]\n  cokernel: Z^3 / (columns) = Z/2 + Z/6 + Z/12\n  check: U A V = D, U U^-1 = I and V V^-1 = I (unimodular), d_i | d_(i+1): verified\n"}], "structuredContent": {"id": 3, "ok": true, "cmd": "snf", "ucas": "snf [[2, 4, 0], [0, 6, 0], [0, 0, 12]]", "structured": true, "result": {"kind": "snf", "diagonal": ["2", "6", "12"], "d": "[[2, 0, 0], [0, 6, 0], [0, 0, 12]]", "u": "[[1, 0, 0], [0, 1, 0], [0, 0, 1]]", "v": "[[1, -2, 0], [0, 1, 0], [0, 0, 1]]", "u_1": "[[1, 0, 0], [0, 1, 0], [0, 0, 1]]", "v_1": "[[1, 2, 0], [0, 1, 0], [0, 0, 1]]", "cokernel": "Z^3 / (columns) = Z/2 + Z/6 + Z/12", "headline": "Smith normal form of the 3x3 matrix: diag(2, 6, 12), rank 3"}, "notes": [], "conditions": [], "checks": [{"kind": "check", "passed": true, "text": "U A V = D, U U^-1 = I and V V^-1 = I (unimodular), d_i | d_(i+1): verified"}], "files": [], "text": "Smith normal form of the 3x3 matrix: diag(2, 6, 12), rank 3\n  D: [[2, 0, 0], [0, 6, 0], [0, 0, 12]]\n  U: [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n  V: [[1, -2, 0], [0, 1, 0], [0, 0, 1]]\n  U^-1: [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n  V^-1: [[1, 2, 0], [0, 1, 0], [0, 0, 1]]\n  cokernel: Z^3 / (columns) = Z/2 + Z/6 + Z/12\n  check: U A V = D, U U^-1 = I and V V^-1 = I (unimodular), d_i | d_(i+1): verified\n"}, "isError": false}}
