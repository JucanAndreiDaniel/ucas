simplify sinh(2*x) - 2*sinh(x)*cosh(x)
simplify cosh(2*x) - (cosh(x)^2 + sinh(x)^2)
simplify cosh(2*x) - (2*cosh(x)^2 - 1)
simplify tanh(2*x) - 2*tanh(x)/(1+tanh(x)^2)
simplify sinh(x+y) - (sinh(x)*cosh(y)+cosh(x)*sinh(y))
simplify cosh(x+y) - (cosh(x)*cosh(y)+sinh(x)*sinh(y))
simplify sinh(x)^2 - (cosh(2*x)-1)/2
simplify cosh(x)^2 - (cosh(2*x)+1)/2
