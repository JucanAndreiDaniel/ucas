{"jsonrpc": "2.0", "id": 2, "result": {"content": [{"type": "text", "text": "simplify cos(2x) - (cos(x)^2 - sin(x)^2)\n  = cos(2x) - 2cos(x)^2 + 1\n  check: equal at 64 sample points (max relative difference 1.8e-16)\n"}], "structuredContent": {"id": 2, "ok": true, "cmd": "simplify", "ucas": "simplify cos(2*x)-(cos(x)^2-sin(x)^2)", "structured": true, "result": {"kind": "simplify", "input": "cos(2x) - (cos(x)^2 - sin(x)^2)", "result": "cos(2x) - 2cos(x)^2 + 1"}, "notes": [], "conditions": [], "checks": [{"kind": "numeric", "points": 64, "max_diff": 1.8041124150158794e-16, "passed": true}], "files": [], "text": "simplify cos(2x) - (cos(x)^2 - sin(x)^2)\n  = cos(2x) - 2cos(x)^2 + 1\n  check: equal at 64 sample points (max relative difference 1.8e-16)\n"}, "isError": false}}
