f16a(x: f64) = f16(exp(x))
f16b(x: f64) = f16(f32(exp(x)))
equiv f16a f16b
show asuint(f16(exp(asfloat(u64(0x3fb7bd4d2319c6f9)))))
show asuint(f16(f32(exp(asfloat(u64(0x3fb7bd4d2319c6f9))))))
show asuint(f16(exp(asfloat(u64(0x3fbf2688349641d4)))))
show asuint(f16(f32(exp(asfloat(u64(0x3fbf2688349641d4))))))
