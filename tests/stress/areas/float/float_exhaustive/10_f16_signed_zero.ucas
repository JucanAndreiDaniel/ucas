p(x: u16) = asfloat(x)
AB(x:u16)=asuint(abs(p(x)))
SQ(x:u16)=asuint(sqrt(p(x)))
SN(x:u16)=asuint(sin(p(x)))
FL(x:u16)=asuint(floor(p(x)))
CE(x:u16)=asuint(ceil(p(x)))
RE(x:u16)=asuint(roundeven(p(x)))
AB(0x0000); SQ(0x0000); SN(0x0000); FL(0x0000); CE(0x0000); RE(0x0000)
AB(0x8000); SQ(0x8000); SN(0x8000); FL(0x8000); CE(0x8000); RE(0x8000)
