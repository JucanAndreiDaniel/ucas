p(x:u32)=asfloat(x)
SQ(x:u32)=asuint(sqrt(p(x)))
LG(x:u32)=asuint(log(p(x)))
EX(x:u32)=asuint(exp(p(x)))
SN(x:u32)=asuint(sin(p(x)))
SQ(0x3f800000); LG(0x3f800000); EX(0x3f800000); SN(0x3f800000)
SQ(0x7f800000); LG(0x7f800000); EX(0x7f800000); SN(0x7f800000)
SQ(0xff800000); LG(0xff800000); EX(0xff800000); SN(0xff800000)
SQ(0x7fc00000); LG(0x7fc00000); EX(0x7fc00000); SN(0x7fc00000)
SQ(0x00000001); LG(0x00000001); EX(0x00000001); SN(0x00000001)
SQ(0x80000000); LG(0x80000000); EX(0x80000000); SN(0x80000000)
