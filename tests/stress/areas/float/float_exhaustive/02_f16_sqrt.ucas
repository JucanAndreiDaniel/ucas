p(x: u16) = asfloat(x)
SQ(x: u16) = asuint(sqrt(p(x)))
SQ(0x0000); SQ(0x0001)
SQ(0x0002); SQ(0x03ff)
SQ(0x0400); SQ(0x0401)
SQ(0x07ff); SQ(0x0800)
SQ(0x3800); SQ(0x3bff)
SQ(0x3c00); SQ(0x3c01)
SQ(0x3d00); SQ(0x3e00)
SQ(0x4000); SQ(0x7bfe)
SQ(0x7bff); SQ(0x7c00)
SQ(0x7c01); SQ(0x7dff)
SQ(0x7e00); SQ(0x7fff)
SQ(0x8000); SQ(0x8001)
SQ(0x83ff); SQ(0xbc00)
SQ(0xc000); SQ(0xfc00)
SQ(0xfc01); SQ(0xfe00)
SQ(0xffff)
