re(x: f32 in -1000..1000) = roundeven(x)
fl(x: f32 in -1000..1000) = floor(x + f32(0.5))
equiv re fl
show roundeven(f32(2.5))
show roundeven(f32(3.5))
show roundeven(f32(-2.5))
show floor(f32(-0.0))
show ceil(f32(-0.0))
show roundeven(f32(0.5))
show roundeven(f32(1.5))
rr(x: f32 in -1000..1000) = roundeven(x)
find rr 1
