fsqrt(x: f32 in -1..1) = sqrt(x)
range fsqrt
finv(x: f32 in -1..1) = 1/x
range finv
fdiv(x: f32 in -1..1) = x/x
range fdiv
fexp(x: f32 in -1000..1000) = exp(x)
range fexp
d16(x: f16 in -1..1) = x/x
range d16
d16b(x: f16 in -1..1) = 1/x
range d16b
sq(x: f32 in -3..3) = x*x
range sq
rs(x: f32 in 0.01..100) = 1/sqrt(x)
range rs
