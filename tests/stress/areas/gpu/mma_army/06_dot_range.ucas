# Dot ranges from lane intervals, on small domains so the answer is
# exhaustive and can be checked against every point.
range sdot4x8(a: u8, b: u8)
range udot4x8(a: u8, b: u8)
f(a: u32 in 6..11, b: u32 in 70..71) = sdot4x8(a, b)
range f
g(a: u32 in 0..255, b: u32 in 0..255) = udot4x8(a, b)
range g
