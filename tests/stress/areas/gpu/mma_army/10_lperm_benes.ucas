# Lane maps that are not affine go through a Benes network, routed in every
# bit order and proved lane by lane; a map that copies a lane to two stays
# one shuffle.
lperm [5,2,7,0,3,6,1,4][lane] lanes 8 model rdna2
lperm (lane + 4) & 31 model rdna2
model dearshuf : rdna2 { sg_shuffle: 20 }
lperm [0,0,2,3,4,5,6,7][lane] lanes 8 model dearshuf
lperm (lane * 5) & 31 model dearshuf
