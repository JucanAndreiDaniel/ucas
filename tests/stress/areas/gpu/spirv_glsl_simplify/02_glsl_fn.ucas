# Function-level facts over the domain abstract interpretation infers from main.
# A branch the callers never take.
simplify functions nofile
```glsl
#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B { uint v[]; };
uint f(uint x){ if(x>100u) return 999u; return x*2u; }
void main(){ uint i=gl_GlobalInvocationID.x; v[i]=f(i&7u); }
```
# A mask the arguments never need.
simplify functions nofile
```glsl
#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B { uint v[]; };
uint f(uint x){ return (x & 255u) + 1u; }
void main(){ uint i=gl_GlobalInvocationID.x; v[i]=f(i&15u); }
```
# A switch whose default can never be selected.
simplify functions nofile
```glsl
#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B { uint v[]; };
uint f(uint x){ switch(x){ case 0u: return 1u; case 1u: return 2u; default: return 3u; } }
void main(){ uint i=gl_GlobalInvocationID.x; v[i]=f(i&1u); }
```
# Instruction-level pass on a whole compute shader (integer only).
simplify nofile
```glsl
#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B { uint v[]; };
void main(){ uint i=gl_GlobalInvocationID.x; v[i]=(v[i]*8u)/4u + (v[i]&255u)%256u; }
```
