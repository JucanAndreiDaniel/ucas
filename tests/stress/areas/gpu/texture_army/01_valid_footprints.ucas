# Control: all 14 documented 2-D ASTC footprints, plus the two spaced
# spellings the parser also accepts.  A 16-entry ramp keeps each report short.
R = [0, 17, 34, 51, 68, 85, 102, 119, 136, 153, 170, 187, 204, 221, 238, 255]
texenc R astc 4x4
texenc R astc 5x4
texenc R astc 5x5
texenc R astc 6x5
texenc R astc 6x6
texenc R astc 8x5
texenc R astc 8x6
texenc R astc 8x8
texenc R astc 10x5
texenc R astc 10x6
texenc R astc 10x8
texenc R astc 10x10
texenc R astc 12x10
texenc R astc 12x12
texenc R astc 4x 4
texenc R astc 4 x 4
