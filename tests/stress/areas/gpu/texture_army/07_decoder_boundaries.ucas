# Controls for the decoder steps at their boundaries, unchanged by the fix:
# extreme level counts, the last value of a sequence, w = 0 and w = 64,
# the HDR error colour, the small-block hash rule and a grid past its edge.
show astc_unquant(6, 0)
show astc_unquant(6, 5)
show astc_unquant(256, 255)
show astc_unquantw(2, 0)
show astc_unquantw(32, 31)
show astc_lerp(0, 255, 0)
show astc_lerp(0, 255, 64)
show astc_lerp(255, 0, 64)
show astc_lerp(128, 128, 32)
# HDR endpoint modes decode to the LDR profile's error colour, magenta
show astc_endpoint(2, 0x1234, 0)
show astc_endpoint(7, 0x1234, 1)
show astc_endpoint(15, 0x1234, 7)
# a 4x4 block is under 31 texels: the hash is sampled at (2x, 2y)
wd(x: u8 in 0..3, y: u8 in 0..3) = astc_partition(61, x, y, 2)
od(x: u8 in 0..3, y: u8 in 0..3) = astc_partition(61, 2*u32(x), 2*u32(y), 2)
equiv wd od
# boundary weights in a 2x2 grid: s/t at the last texel and one grid past it
show astc_bilerp([0, 64, 64, 0], 2, 31, 31)
show astc_bilerp([0, 64, 64, 0], 2, 48, 48)
show astc_bilerp([0, 64, 64, 0], 2, 16, 16)
