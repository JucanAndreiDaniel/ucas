> a1(x: u32, y: u32) = (x * 7 + y) * 3
> a2(x: u32, y: u32) = (x << 3) + (y >> 2)
> f1(x: f32, y: f32, z: f32) = x*y + z
> f2(x: f32, y: f32) = x*x + y*y
