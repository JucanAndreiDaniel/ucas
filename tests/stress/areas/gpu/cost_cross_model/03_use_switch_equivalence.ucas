# `use m; cost f` must equal `cost f model m` for every model, and `use` must persist.
f(x: u32) = x*7 + 11
g(x: f32, y: f32, z: f32) = x*y + z
cost f model gt1030
use gt1030
cost f
cost f model zen4
use zen4
cost f
cost g
use skl
cost f
cost g
use glc
cost f
use x86v4
cost f
use gt1030
cost f
cost f model gt1030
