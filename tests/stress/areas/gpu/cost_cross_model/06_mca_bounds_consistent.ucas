# mca reports critical-path / port / front-end bounds and a simulated cycle count.
# For straight-line, non-division code the simulated count equals the largest bound.
a1(x: u32, y: u32) = (x * 7 + y) * 3
a2(x: u32, y: u32) = (x << 3) + (y >> 2)
f1(x: f32, y: f32, z: f32) = x*y + z
f2(x: f32, y: f32) = x*x + y*y
mca a1 on skl
cost a1 model skl
mca a1 on zen4
cost a1 model zen4
mca a2 on skl
cost a2 model skl
mca a2 on glc
cost a2 model glc
mca f1 on skl
cost f1 model skl
mca f1 on zen4
cost f1 model zen4
mca f2 on glc
cost f2 model glc
