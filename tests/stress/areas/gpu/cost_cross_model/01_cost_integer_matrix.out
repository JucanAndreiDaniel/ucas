> addc(x: u32) = x + 11
> mulc(x: u32) = x * 7
> divc(x: u32) = x / 7
> divv(x: u32, y: u32) = x / y
> remv(x: u32, y: u32) = x % y
> shl(x: u32) = x << 3
> logic(x: u32, y: u32) = (x & y) | (x xor y)
> select(x: u32, y: u32) = x < y ? x : y
