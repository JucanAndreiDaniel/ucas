{"jsonrpc": "2.0", "method": "tools/call", "params": {"name": "ucas", "arguments": {"source": "nb(x: u8 in 0..6) = (x==0 ? 99 : K[x-1]) + K[x] + (x==6 ? 99 : K[x+1])"}}, "id": 7}
{"jsonrpc": "2.0", "method": "tools/call", "params": {"name": "ucas", "arguments": {"source": "n5(i: u8 in 0..4) = J5[(i+4)%5] + J5[i] + J5[(i+1)%5]"}}, "id": 8}
