# An exchange fused into its arithmetic user: a model declares a
# shuffle by lane xor k (or a quad's broadcast) a source modifier of the
# add, multiply or fma that reads it (`in fadd fmul iadd`), with the
# index formed inside (the pattern's lane xor k goes with it) and k
# bounded (`k: const u4`, a constant in 0..15).  rdna2 lists such
# estimates (DPP16's row_xmask and quad_perm); gt1030 none.
models
xa(x: f32 uniform, y: f32, lane: u32 in 0..31) = sg_shuffle_xor(x * f32(lane), 1) + y
cost xa
cost xa model rdna2
xm(x: f32 uniform, y: f32, z: f32, lane: u32 in 0..31) = fma(sg_shuffle_xor(x * f32(lane), 2), y, z)
cost xm model rdna2
xc(x: f32 uniform, y: f32, z: f32, lane: u32 in 0..31) = sg_shuffle_xor(x * f32(lane), 5) * y + z
cost xc model rdna2
xi(x: u32 uniform, y: u32, lane: u32 in 0..31) = sg_quad_swap_d(x + lane) + y
cost xi model rdna2
xb(x: f32 uniform, y: f32, lane: u32 in 0..31) = sg_quad_broadcast(x * f32(lane), 3) + y
cost xb model rdna2
# not a modifier: xor 16 is past a row (v_permlanex16, an instruction of
# its own), and a use that is no add or multiply keeps the exchange
x16(x: f32 uniform, y: f32, lane: u32 in 0..31) = sg_shuffle_xor(x * f32(lane), 16) + y
cost x16 model rdna2
xs(x: f32 uniform, y: f32, lane: u32 in 0..31) = { t = sg_shuffle_xor(x * f32(lane), 1); t + y + sqrt(t) }
cost xs model rdna2
# a model of one's own
model dppish : gt1030 { sg_shuffle_xor: 2
  fuse bfadd(v: any, lane: lane, k: const u2) = sg_shuffle(v, lane xor k) : 0 in fadd }
cost xa model dppish
cost x16 model dppish
